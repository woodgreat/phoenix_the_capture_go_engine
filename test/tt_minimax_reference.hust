// tt_minimax_reference.hust - PAUSED transposition table implementation
//
// 存档原因：Hust 转译器问题 B6~B9 阻塞（见 hust_issues_for_longerxia.md）：
//   B7: i32[] 字段生成裸类型 → 不能用 Vec 字段
//   B8: [i32; 256] 字段不 derive Default
//   B9: 模块级变量生成非法 Rust（let mut x: [i32; 256]; / public let mut）
//   B6: &mut self 不透传（本方案已规避，纯静态数组 BFS）
//
// 恢复步骤（等任一 bug 修复后）：
//   1. 把"模块级声明 + init_search_tables"贴回 board.hust 顶部
//      （按修复后的正确语法调整声明形式）
//   2. 把下面 tt_ready_minimax 整体替换 board.hust 里的 minimax
//   3. main.hust 在 new Board() 前调用 init_search_tables()
//   4. 编译 + 跑 L7 vs L5 强度阶梯回归（10/10 应保持）
//
// 设计要点：
//   - Zobrist hashing：LCG 生成 338 个 i32（169 黑子 + 169 白子），XOR 合成
//   - TT：256 entry，线性探查 4 槽；每槽 hash/score/depth/alpha/beta
//   - 探查命中且 tt_depth >= depth 时按 exact/upper/lower 三分支裁剪
//   - 出口与 beta<=alpha 剪枝点都回写 TT（prefer deeper entry 替换策略）

// ==== 模块级声明（B9 修复后按新语法调整）====
// i32[256] tt_hash;
// i32[256] tt_score;
// i32[256] tt_depth;
// i32[256] tt_alpha;
// i32[256] tt_beta;
// i32[338] zobrist_table;

