// coordinate.hust - Coordinate system conversion module
// Phoenix Wood Capture Go Engine
//
// Purpose: Decouple engine internal coordinates from external coordinate systems
// Engine internal: Wood coordinates (x, y) where x=column 0-12, y=row 0-12
// External: SGF, GTP, board display, etc.
//
// Design principle: Engine internal uses Wood coordinates only.
// All external I/O goes through this conversion module.
//
// Created: 2026-11-03
// Author: 龙小虾 🦞

// ========== Coordinate System Definitions ==========

// Wood internal coordinates (engine native)
// x: column 0-12 (A-M, no skip)
// y: row 0-12 (1-13, bottom to top)
// Board array: board[x][y] or flat board[x*13+y]

// SGF coordinates
// Letters a-m (13x13, no skip for Phoenix)
// SGF x: a=0, b=1, ..., m=12
// SGF y: bottom-left origin (a=bottom, m=top)
// Conversion: sgf_x = wood_x, sgf_y = 12 - wood_y

// GTP coordinates (human-readable)
// Letters A-M (columns), numbers 1-13 (rows)
// GTP x: A=0, B=1, ..., M=12
// GTP y: 1=bottom, 13=top
// Conversion: gtp_x = wood_x, gtp_y = wood_y + 1

// ========== Wood Internal Array Operations ==========

// Get stone at Wood coordinates from flat array
public i32 wood_get(i32[] board, i32 x, i32 y) {
    if (x < 0 || x >= 13 || y < 0 || y >= 13) {
        return -1;  // out of bounds
    }
    return board[x * 13 + y];
}

// Set stone at Wood coordinates in flat array
public void wood_set(i32[] board, i32 x, i32 y, i32 value) {
    if (x < 0 || x >= 13 || y < 0 || y >= 13) {
        return;  // out of bounds, silently ignore
    }
    board[x * 13 + y] = value;
}

// Create empty Wood board array
public i32[] wood_create() {
    i32[] board;
    for (i32 i = 0; i < 169; i++) {
        board.push(0);
    }
    return board;
}

// Copy Wood board array
public i32[] wood_copy(i32[] source) {
    i32[] dest;
    for (i32 i = 0; i < 169; i++) {
        dest.push(source[i]);
    }
    return dest;
}

// ========== Wood -> SGF Conversion ==========

// Convert Wood x (0-12) to SGF letter (a-m)
// Phoenix uses continuous mapping (no 'i' skip)
public char wood_x_to_sgf(i32 x) {
    if (x < 0 || x > 12) {
        return 'a';  // default for invalid
    }
    u8 u = (u8)x + (u8)97;  // 97 = 'a'
    return u as char;
}

// Convert Wood y (0-12) to SGF y (12-0, flipped)
// Wood y=0 (row 1, bottom) -> SGF y=12 (bottom in SGF)
// Wood y=12 (row 13, top) -> SGF y=0 (top in SGF)
public i32 wood_y_to_sgf(i32 y) {
    if (y < 0 || y > 12) {
        return 0;  // default for invalid
    }
    return 12 - y;
}

// Convert Wood coordinates to SGF string
// Example: (5, 6) -> "fg" (x=5->f, y=6->sgf_y=6->g)
public String wood_to_sgf(i32 x, i32 y) {
    char x_char = wood_x_to_sgf(x);
    i32 sgf_y = wood_y_to_sgf(y);
    char y_char = wood_x_to_sgf(sgf_y);  // same letter mapping for y
    return format!("{}{}", x_char, y_char);
}

// Convert Wood board array to SGF coordinate list
// Returns all non-empty points as SGF coordinates (comma-separated)
// 2026-11-03: Changed from String[] to String to avoid Hust dynamic array limitation
public String wood_board_to_sgf_list(i32[] board) {
    String coords = "";
    bool first = true;
    for (i32 x = 0; x < 13; x++) {
        for (i32 y = 0; y < 13; y++) {
            if (board[x * 13 + y] != 0) {
                if (!first) {
                    coords = coords + ",";
                }
                coords = coords + &wood_to_sgf(x, y);
                first = false;
            }
        }
    }
    return coords;
}

// ========== SGF -> Wood Conversion ==========

// Convert SGF letter (a-m) to Wood x (0-12)
// Phoenix uses continuous mapping (no 'i' skip)
public i32 sgf_to_wood_x(char c) {
    i32 v = (i32)c - (i32)97;  // 97 = 'a'
    if (v < 0 || v > 12) {
        return -1;  // invalid
    }
    return v;
}

// Convert SGF y (0-12) to Wood y (12-0, flipped)
public i32 sgf_to_wood_y(i32 sgf_y) {
    if (sgf_y < 0 || sgf_y > 12) {
        return -1;  // invalid
    }
    return 12 - sgf_y;
}

// Convert SGF string to Wood coordinates
// Example: "fg" -> (5, 6)
public i32[] sgf_to_wood(String sgf) {
    i32[] result;  // [x, y] or empty if invalid
    if (sgf.len() < 2) {
        return result;
    }
    char x_char = sgf.chars().nth(0).unwrap();
    char y_char = sgf.chars().nth(1).unwrap();
    
    i32 x = sgf_to_wood_x(x_char);
    i32 sgf_y = sgf_to_wood_x(y_char);  // same letter mapping
    i32 y = sgf_to_wood_y(sgf_y);
    
    if (x >= 0 && y >= 0) {
        result.push(x);
        result.push(y);
    }
    return result;
}

// ========== Wood -> GTP Conversion ==========

// Convert Wood x (0-12) to GTP letter (A-M)
public char wood_x_to_gtp(i32 x) {
    if (x < 0 || x > 12) {
        return 'A';  // default for invalid
    }
    u8 u = (u8)x + (u8)65;  // 65 = 'A'
    return u as char;
}

// Convert Wood y (0-12) to GTP number (1-13)
// Wood y=0 (row 1, bottom) -> GTP y=1
// Wood y=12 (row 13, top) -> GTP y=13
public i32 wood_y_to_gtp(i32 y) {
    if (y < 0 || y > 12) {
        return 1;  // default for invalid
    }
    return y + 1;
}

// Convert Wood coordinates to GTP string
// Example: (5, 6) -> "F7"
public String wood_to_gtp(i32 x, i32 y) {
    char x_char = wood_x_to_gtp(x);
    i32 gtp_y = wood_y_to_gtp(y);
    return format!("{}{}", x_char, gtp_y);
}

// ========== GTP -> Wood Conversion ==========

// Convert GTP letter (A-M) to Wood x (0-12)
public i32 gtp_to_wood_x(char c) {
    // Handle both uppercase and lowercase
    i32 v = (i32)c - (i32)65;  // 65 = 'A'
    if (v < 0 || v > 12) {
        v = (i32)c - (i32)97;  // 97 = 'a'
    }
    if (v < 0 || v > 12) {
        return -1;  // invalid
    }
    return v;
}

// Convert GTP number (1-13) to Wood y (0-12)
public i32 gtp_to_wood_y(i32 gtp_y) {
    if (gtp_y < 1 || gtp_y > 13) {
        return -1;  // invalid
    }
    return gtp_y - 1;
}

// Convert GTP string to Wood coordinates
// Example: "F7" -> (5, 6)
public i32[] gtp_to_wood(String gtp) {
    i32[] result;  // [x, y] or empty if invalid
    if (gtp.len() < 2) {
        return result;
    }
    char x_char = gtp.chars().nth(0).unwrap();
    
    // Parse number part (could be 1-2 digits)
    String num_str = "";
    for (i32 i = 1; i < gtp.len(); i++) {
        char c = gtp.chars().nth((usize)i).unwrap();
        num_str = num_str + &c.to_string();
    }
    i32 gtp_y = str_to_i32(num_str);
    
    i32 x = gtp_to_wood_x(x_char);
    i32 y = gtp_to_wood_y(gtp_y);
    
    if (x >= 0 && y >= 0) {
        result.push(x);
        result.push(y);
    }
    return result;
}

// ========== Batch Conversion: Board Arrays ==========

// Convert Wood board to SGF-style board (for export)
// SGF board[y][x] where y=0 is top, y=12 is bottom
public i32[] wood_to_sgf_board(i32[] wood_board) {
    i32[] sgf_board;
    for (i32 i = 0; i < 169; i++) {
        sgf_board.push(0);
    }
    for (i32 x = 0; x < 13; x++) {
        for (i32 y = 0; y < 13; y++) {
            i32 sgf_y = 12 - y;
            sgf_board[sgf_y * 13 + x] = wood_board[x * 13 + y];
        }
    }
    return sgf_board;
}

// Convert SGF-style board to Wood board
public i32[] sgf_to_wood_board(i32[] sgf_board) {
    i32[] wood_board;
    for (i32 i = 0; i < 169; i++) {
        wood_board.push(0);
    }
    for (i32 x = 0; x < 13; x++) {
        for (i32 sgf_y = 0; sgf_y < 13; sgf_y++) {
            i32 wood_y = 12 - sgf_y;
            wood_board[x * 13 + wood_y] = sgf_board[sgf_y * 13 + x];
        }
    }
    return wood_board;
}

// ========== Utility Functions ==========

// Check if Wood coordinates are valid
public bool wood_valid(i32 x, i32 y) {
    return x >= 0 && x < 13 && y >= 0 && y < 13;
}

// Check if SGF coordinates are valid
public bool sgf_valid(String sgf) {
    if (sgf.len() < 2) {
        return false;
    }
    char x_char = sgf.chars().nth(0).unwrap();
    char y_char = sgf.chars().nth(1).unwrap();
    i32 x = sgf_to_wood_x(x_char);
    i32 sgf_y = sgf_to_wood_x(y_char);
    i32 y = sgf_to_wood_y(sgf_y);
    return x >= 0 && y >= 0;
}

// Check if GTP coordinates are valid
public bool gtp_valid(String gtp) {
    i32[] coords = gtp_to_wood(gtp);
    return coords.len() >= 2;
}

// Get all 4 neighbor coordinates in Wood system
// Returns array of [x1,y1, x2,y2, x3,y3, x4,y4] (may have -1 for invalid)
public i32[] wood_neighbors(i32 x, i32 y) {
    i32[] result;
    // Up (y+1)
    if (y + 1 < 13) { result.push(x); result.push(y + 1); }
    else { result.push(-1); result.push(-1); }
    // Down (y-1)
    if (y - 1 >= 0) { result.push(x); result.push(y - 1); }
    else { result.push(-1); result.push(-1); }
    // Left (x-1)
    if (x - 1 >= 0) { result.push(x - 1); result.push(y); }
    else { result.push(-1); result.push(-1); }
    // Right (x+1)
    if (x + 1 < 13) { result.push(x + 1); result.push(y); }
    else { result.push(-1); result.push(-1); }
    return result;
}

// ========== Test Helpers ==========

// Print Wood board for debugging
public void wood_print(i32[] board) {
    println!("   A B C D E F G H I J K L M");
    for (i32 y = 12; y >= 0; y--) {
        String row = format!("{:>2} ", y + 1);
        for (i32 x = 0; x < 13; x++) {
            i32 v = board[x * 13 + y];
            if (v == 0) { row = row + ". "; }
            else if (v == 1) { row = row + "B "; }
            else { row = row + "W "; }
        }
        println!("{}", row);
    }
}

// Print SGF board for debugging (SGF orientation: y=0 is top)
public void sgf_print(i32[] sgf_board) {
    println!("   A B C D E F G H I J K L M");
    for (i32 sgf_y = 0; sgf_y < 13; sgf_y++) {
        String row = format!("{:>2} ", 13 - sgf_y);
        for (i32 x = 0; x < 13; x++) {
            i32 v = sgf_board[sgf_y * 13 + x];
            if (v == 0) { row = row + ". "; }
            else if (v == 1) { row = row + "B "; }
            else { row = row + "W "; }
        }
        println!("{}", row);
    }
}
