// coordinate.hust - Coordinate system conversion module
// Phoenix Wood Capture Go Engine
//
// Purpose: Decouple engine internal coordinates from external coordinate systems
// Engine internal: Wood coordinates (x, y) where x=column 0-12, y=row 0-12
// External: SGF, GTP, board display, etc.
//
// Design principle: Engine internal uses Wood coordinates only.
// All external I/O goes through this conversion module.
//
// Created: 2026-11-03
// Author: 龙小虾 🦞

// ========== Coordinate System Definitions ==========

// Wood internal coordinates (engine native) -- 2026-11-06 final convention
// Wood Capture Go uses:
//   X axis (columns) = letters A-M, 0..12, LEFT -> RIGHT
//   Y axis (rows)    = numbers 1-13, 0..12, TOP -> BOTTOM  (no flip)
//   notation = <column letter><row number>, e.g. G7 = column G, row 7
// Row 1 is the TOP row, column A is the LEFT column: the stored grid is
// exactly what the player sees -- nothing is flipped.
//
// Board array: board[x][y] with x = column index, y = row index (top-down)
//              flat index = x*13 + y
// Opening: G7=(6,6) black, G8=(6,7) white, H7=(7,6) white, H8=(7,7) black.

// SGF coordinates (standard)
// Letters a-m (13x13, no skip for Phoenix)
// SGF x = column letter (left->right), SGF y = row letter (TOP->BOTTOM)
// Conversion: sgf_x = wood_x, sgf_y = wood_y  (both top-left origin)

// GTP coordinates (Wood notation)
// <column letter A-M><row number 1-13>, case-insensitive
// Conversion: column = wood_x, row = wood_y + 1

// ========== Wood Internal Array Operations ==========

// Get stone at Wood coordinates from flat array
public i32 wood_get(i32[] board, i32 x, i32 y) {
    if (x < 0 || x >= 13 || y < 0 || y >= 13) {
        return -1;  // out of bounds
    }
    return board[x * 13 + y];
}

// Set stone at Wood coordinates in flat array
public void wood_set(i32[] board, i32 x, i32 y, i32 value) {
    if (x < 0 || x >= 13 || y < 0 || y >= 13) {
        return;  // out of bounds, silently ignore
    }
    board[x * 13 + y] = value;
}

// Create empty Wood board array
public i32[] wood_create() {
    i32[] board;
    for (i32 i = 0; i < 169; i++) {
        board.push(0);
    }
    return board;
}

// Copy Wood board array
public i32[] wood_copy(i32[] source) {
    i32[] dest;
    for (i32 i = 0; i < 169; i++) {
        dest.push(source[i]);
    }
    return dest;
}

// ========== Wood -> SGF Conversion ==========

// Convert Wood x (0-12) to SGF letter (a-m)
// Phoenix uses continuous mapping (no 'i' skip)
public char wood_x_to_sgf(i32 x) {
    if (x < 0 || x > 12) {
        return 'a';  // default for invalid
    }
    u8 u = (u8)x + (u8)97;  // 97 = 'a'
    return u as char;
}

// Convert Wood row (0-12, top-down) to SGF y (0-12, top-down).
// Both systems have a top-left origin, so this is the identity.
public i32 wood_y_to_sgf(i32 y) {
    if (y < 0 || y > 12) {
        return 0;  // default for invalid
    }
    return y;
}

// Convert Wood coordinates to standard SGF string (column first, row second)
// Example: G7 = (6, 6) -> "gg"; G8 = (7, 6) -> "hg" (column H, row G)
public String wood_to_sgf(i32 x, i32 y) {
    char x_char = wood_x_to_sgf(x);
    i32 sgf_y = wood_y_to_sgf(y);
    char y_char = wood_x_to_sgf(sgf_y);  // same letter mapping for y
    return format!("{}{}", x_char, y_char);
}

// ========== Wood SGF Format (Wood Coordinate System) ==========
// 
// Wood SGF is the Wood-flavoured SGF export. Wood coordinates are
// <column letter><row number> with the top-left origin; standard SGF is
// <column letter><row letter> with the same origin, so after the
// 2026-11-06 orientation fix (rows counted from the top, no flip) both
// formats produce the same coordinate strings. The command is kept for
// backward compatibility and to mark a game as Wood-rules.
//
// Coordinate mapping:
// - G7 = (6, 6) -> both "gg"
// - G8 = (6, 7) -> both "gh"
// - H7 = (7, 6) -> both "hg"
//
// Created: 2026-11-04
// Author: 龙小虾 🦞

// Convert Wood coordinates to Wood SGF: <column letter><row letter>.
// Same as standard SGF because both grids use the top-left origin.
// Example: G7 = (6, 6) -> "gg"; G8 = (6, 7) -> "gh"; H7 = (7, 6) -> "hg".
public String wood_to_woodsgf(i32 x, i32 y) {
    char col_char = wood_x_to_sgf(x);
    char row_char = wood_x_to_sgf(y);
    return format!("{}{}", col_char, row_char);
}

// Convert Wood board array to SGF coordinate list
// Returns all non-empty points as SGF coordinates (comma-separated)
// 2026-11-03: Changed from String[] to String to avoid Hust dynamic array limitation
public String wood_board_to_sgf_list(i32[] board) {
    String coords = "";
    bool first = true;
    for (i32 x = 0; x < 13; x++) {
        for (i32 y = 0; y < 13; y++) {
            if (board[x * 13 + y] != 0) {
                if (!first) {
                    coords = coords + ",";
                }
                coords = coords + &wood_to_sgf(x, y);
                first = false;
            }
        }
    }
    return coords;
}

// ========== SGF -> Wood Conversion ==========

// Convert SGF letter (a-m) to Wood x (0-12)
// Phoenix uses continuous mapping (no 'i' skip)
public i32 sgf_to_wood_x(char c) {
    i32 v = (i32)c - (i32)97;  // 97 = 'a'
    if (v < 0 || v > 12) {
        return -1;  // invalid
    }
    return v;
}

// Convert SGF y (0-12, top-down) to Wood row (0-12, top-down): identity.
public i32 sgf_to_wood_y(i32 sgf_y) {
    if (sgf_y < 0 || sgf_y > 12) {
        return -1;  // invalid
    }
    return sgf_y;
}

// Convert standard SGF string to Wood coordinates (column first)
// Example: "hg" -> (7, 6) = G8; "gh" -> (6, 7) = H7
public i32[] sgf_to_wood(String sgf) {
    i32[] result;  // [x, y] or empty if invalid
    if (sgf.len() < 2) {
        return result;
    }
    char x_char = sgf.chars().nth(0).unwrap();
    char y_char = sgf.chars().nth(1).unwrap();
    
    i32 x = sgf_to_wood_x(x_char);
    i32 sgf_y = sgf_to_wood_x(y_char);  // same letter mapping
    i32 y = sgf_to_wood_y(sgf_y);
    
    if (x >= 0 && y >= 0) {
        result.push(x);
        result.push(y);
    }
    return result;
}

// ========== Wood -> GTP Conversion ==========

// Convert Wood column (0-12, left-right) to GTP column letter (A-M).
public char wood_x_to_gtp_letter(i32 x) {
    if (x < 0 || x > 12) {
        return 'A';  // default for invalid
    }
    u8 u = (u8)x + (u8)65;  // 65 = 'A'
    return u as char;
}

// Convert Wood row (0-12, top-down) to GTP row number (1-13).
public i32 wood_y_to_gtp_number(i32 y) {
    if (y < 0 || y > 12) {
        return 1;  // default for invalid
    }
    return y + 1;
}

// Convert Wood coordinates to GTP: <column letter><row number>.
// Example: G7 = (6, 6) -> "G7"; G8 = (6, 7) -> "G8".
public String wood_to_gtp(i32 x, i32 y) {
    char col_char = wood_x_to_gtp_letter(x);
    i32 row_num = wood_y_to_gtp_number(y);
    return format!("{}{}", col_char, row_num);
}

// ========== GTP -> Wood Conversion ==========

// Convert GTP column letter (A-M, case-insensitive) to Wood column (0-12).
public i32 gtp_letter_to_wood_x(char c) {
    i32 v = (i32)c - (i32)65;  // 65 = 'A'
    if (v < 0 || v > 12) {
        v = (i32)c - (i32)97;  // 97 = 'a'
    }
    if (v < 0 || v > 12) {
        return -1;  // invalid
    }
    return v;
}

// Convert GTP row number (1-13) to Wood row (0-12).
public i32 gtp_number_to_wood_y(i32 n) {
    if (n < 1 || n > 13) {
        return -1;  // invalid
    }
    return n - 1;
}

// Convert a Wood-notation string to Wood coordinates.
// Syntax: <column letter><row number>, e.g. "G7" -> (x=6, y=6).
public i32[] gtp_to_wood(String gtp) {
    i32[] result;
    if (gtp.len() < 2) {
        return result;
    }
    char col_char = gtp.chars().nth(0).unwrap();

    // Parse the number part (1-2 digits) -> row
    String num_str = "";
    for (i32 i = 1; i < gtp.len(); i++) {
        char c = gtp.chars().nth((usize)i).unwrap();
        num_str = num_str + &c.to_string();
    }
    i32 row_num = str_to_i32(num_str);

    i32 x = gtp_letter_to_wood_x(col_char);
    i32 y = gtp_number_to_wood_y(row_num);

    if (x >= 0 && y >= 0) {
        result.push(x);
        result.push(y);
    }
    return result;
}

// ========== Batch Conversion: Board Arrays ==========

// Convert Wood board to SGF-style board (for export)
// SGF board is row-major: sgf[y*13+x], y=0 is the top row.
// Wood is column-major: wood[x*13+y], y=0 is also the top row.
// So the conversion only swaps the axis order -- there is no y-flip.
public i32[] wood_to_sgf_board(i32[] wood_board) {
    i32[] sgf_board;
    for (i32 i = 0; i < 169; i++) {
        sgf_board.push(0);
    }
    for (i32 x = 0; x < 13; x++) {
        for (i32 y = 0; y < 13; y++) {
            sgf_board[y * 13 + x] = wood_board[x * 13 + y];
        }
    }
    return sgf_board;
}

// Convert SGF-style board to Wood board
public i32[] sgf_to_wood_board(i32[] sgf_board) {
    i32[] wood_board;
    for (i32 i = 0; i < 169; i++) {
        wood_board.push(0);
    }
    for (i32 x = 0; x < 13; x++) {
        for (i32 y = 0; y < 13; y++) {
            wood_board[x * 13 + y] = sgf_board[y * 13 + x];
        }
    }
    return wood_board;
}

// ========== Utility Functions ==========

// Check if Wood coordinates are valid
public bool wood_valid(i32 x, i32 y) {
    return x >= 0 && x < 13 && y >= 0 && y < 13;
}

// Check if SGF coordinates are valid
public bool sgf_valid(String sgf) {
    if (sgf.len() < 2) {
        return false;
    }
    char x_char = sgf.chars().nth(0).unwrap();
    char y_char = sgf.chars().nth(1).unwrap();
    i32 x = sgf_to_wood_x(x_char);
    i32 sgf_y = sgf_to_wood_x(y_char);
    i32 y = sgf_to_wood_y(sgf_y);
    return x >= 0 && y >= 0;
}

// Check if GTP coordinates are valid
public bool gtp_valid(String gtp) {
    i32[] coords = gtp_to_wood(gtp);
    return coords.len() >= 2;
}

// Get all 4 neighbor coordinates in Wood system
// Returns array of [x1,y1, x2,y2, x3,y3, x4,y4] (may have -1 for invalid)
public i32[] wood_neighbors(i32 x, i32 y) {
    i32[] result;
    // Up (y-1, because y grows downward)
    if (y - 1 >= 0) { result.push(x); result.push(y - 1); }
    else { result.push(-1); result.push(-1); }
    // Down (y+1)
    if (y + 1 < 13) { result.push(x); result.push(y + 1); }
    else { result.push(-1); result.push(-1); }
    // Left (x-1)
    if (x - 1 >= 0) { result.push(x - 1); result.push(y); }
    else { result.push(-1); result.push(-1); }
    // Right (x+1)
    if (x + 1 < 13) { result.push(x + 1); result.push(y); }
    else { result.push(-1); result.push(-1); }
    return result;
}

// ========== Test Helpers ==========

// Print Wood board for debugging (row letters A-M top-down, columns 1-13)
public void wood_print(i32[] board) {
    println!("   A B C D E F G H I J K L M");
    for (i32 y = 0; y < 13; y++) {
        String row = format!("{:>2} ", y + 1);
        for (i32 x = 0; x < 13; x++) {
            i32 v = board[x * 13 + y];
            if (v == 0) { row = row + ". "; }
            else if (v == 1) { row = row + "B "; }
            else { row = row + "W "; }
        }
        println!("{}", row);
    }
}

// Print SGF board for debugging (row-major, y=0 is the top row)
public void sgf_print(i32[] sgf_board) {
    println!("   A B C D E F G H I J K L M");
    for (i32 y = 0; y < 13; y++) {
        String row = format!("{:>2} ", y + 1);
        for (i32 x = 0; x < 13; x++) {
            i32 v = sgf_board[y * 13 + x];
            if (v == 0) { row = row + ". "; }
            else if (v == 1) { row = row + "B "; }
            else { row = row + "W "; }
        }
        println!("{}", row);
    }
}
