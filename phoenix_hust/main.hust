// Phoenix - Wood Capture Go Engine
// Entry point (Step 3: + coordinate conversion verification)

use board;
use gtp;

void main() {
    Board b = new Board();
    b.setup_twist_cross();

    println!("Phoenix Wood Capture Go Engine v0.1.0");
    println!("");

    // ============ Step 2 verification: twist-cross ============
    println!("Step 2: twist-cross stone check");
    i32 g7 = b.get(6, 6);
    i32 g8 = b.get(6, 7);
    i32 h7 = b.get(7, 6);
    i32 h8 = b.get(7, 7);
    bool stones_ok = g7 == 1 && g8 == 2 && h7 == 2 && h8 == 1;
    println!("  G7={} G8={} H7={} H8={} OK: {} (expect 1 2 2 1 true)",
        g7, g8, h7, h8, stones_ok);

    bool p1 = b.place_stone(3, 3, 1);
    bool p2 = b.place_stone(3, 3, 2);
    bool p3 = b.place_stone(13, 0, 1);
    println!("  place D4={} dup={} oob={} (expect true false false)", p1, p2, p3);
    println!("");

    // ============ Step 3 verification: coordinates ============
    println!("Step 3: coordinate conversion");

    // Specific points
    String s_d4 = xy_to_gtp(3, 3);
    String s_g7 = xy_to_gtp(6, 6);
    String s_i10 = xy_to_gtp(8, 9);
    String s_corner = xy_to_gtp(12, 12);
    println!("  (3,3)->{} (expect D4)", s_d4);
    println!("  (6,6)->{} (expect G7)", s_g7);
    println!("  (8,9)->{} (expect I10, letters A-M continuous)", s_i10);
    println!("  (12,12)->{} (expect M13)", s_corner);

    i32 dx = gtp_coord_to_x("D4".to_string());
    i32 dy = gtp_coord_to_y("D4".to_string());
    i32 gx = gtp_coord_to_x("G7".to_string());
    i32 gy = gtp_coord_to_y("G7".to_string());
    i32 ix = gtp_coord_to_x("I10".to_string());
    i32 iy = gtp_coord_to_y("I10".to_string());
    i32 ax = gtp_coord_to_x("A1".to_string());
    i32 ay = gtp_coord_to_y("A1".to_string());
    i32 mx = gtp_coord_to_x("M13".to_string());
    i32 my = gtp_coord_to_y("M13".to_string());
    println!("  D4->({},{}) (expect 3 3)", dx, dy);
    println!("  G7->({},{}) (expect 6 6)", gx, gy);
    println!("  I10->({},{}) (expect 8 9)", ix, iy);
    println!("  A1->({},{}) (expect 0 0)", ax, ay);
    println!("  M13->({},{}) (expect 12 12)", mx, my);

    // Round trip over all 169 points
    bool all_ok = true;
    for (i32 x = 0; x < 13; x++) {
        for (i32 y = 0; y < 13; y++) {
            String s = xy_to_gtp(x, y);
            i32 rx = gtp_coord_to_x(s.clone());
            i32 ry = gtp_coord_to_y(s.clone());
            if (rx != x || ry != y) {
                all_ok = false;
                println!("  MISMATCH: ({},{}) -> {} -> ({},{})", x, y, s.clone(), rx, ry);
            }
        }
    }
    println!("  round trip 169 points OK: {}", all_ok);

    // Invalid inputs
    i32 px = gtp_coord_to_x("pass".to_string());
    i32 py = gtp_coord_to_y("pass".to_string());
    i32 ex = gtp_coord_to_x("".to_string());
    i32 zx = gtp_coord_to_x("Z9".to_string());
    i32 nx2 = gtp_coord_to_x("N9".to_string());
    println!("  pass->({},{}) (expect -1 -1)", px, py);
    println!("  empty string -> x = {} (expect -1)", ex);
    println!("  bad column Z9 -> x = {} (expect -1)", zx);
    println!("  bad column N9 -> x = {} (expect -1, max column is M)", nx2);
}
