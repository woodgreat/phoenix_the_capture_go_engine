// Phoenix - Wood Capture Go Engine
// Step 7: GTP main loop
// Step 8: complete command set (undo, known_command, list_commands,
//         fixed_handicap, wood_* extensions, ID echo)
//
// GTP v2 protocol over stdin/stdout:
//   request : [id] command args...
//   response: = result\n\n  (success)  |  ? error\n\n  (failure)
//   the optional numeric id is echoed as =<id> / ?<id>
//
// IO (verified in io_probe experiment, Hust 0.1.35):
//   read line (EOF-safe): std::io::stdin().lines().next()
//     .unwrap_or(Ok(String::new())).unwrap()
//   flush (MANDATORY): std::io::Write::flush(&mut std::io::stdout())
//
// Undo history: dynamic arrays in main act as a stack of full board
// snapshots (169 cells + 5 meta values per move). The board object
// moves nowhere; snapshots go in and out through get/set.

use board;
use gtp;
use ai;
use debug;
use ai_env_datatypes;
use coordinate;
use RUST.time.SystemTime;

// Internal game state (engine internal use only)
// 0 = gaming, 1 = black wins, 2 = white wins
// Updated after every successful move (play or genmove), read by result
// 2026-11-03: Moved to Board class (game_over_state field)
// Board.clear() resets it to 0; moves call refresh_game_over_state()

// 2026-10-31: Convert Unix time value to formatted timestamp string
// Format: YYYYMMDD_HHMM (UTC)
String format_time_value(i64 secs) {
    // Calculate minutes, hours, days
    i64 mins = secs / 60;
    i64 hours = mins / 60;
    i64 days = hours / 24;
    
    // Calculate remaining hours and minutes
    i64 rem_hours = hours % 24;
    i64 rem_mins = mins % 60;
    
    // Calculate year, month, day (with leap year support)
    i64 year = 1970;
    i64 remaining_days = days;
    
    // Days in each month (non-leap year)
    i32[12] month_days = {31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31};
    
    // Calculate year with leap year support
    while (remaining_days >= 365) {
        // Check if current year is a leap year
        bool is_leap = false;
        if (year % 4 == 0) {
            if (year % 100 != 0 || year % 400 == 0) {
                is_leap = true;
            }
        }
        
        i64 days_in_year = 365;
        if (is_leap) {
            days_in_year = 366;
        }
        
        if (remaining_days >= days_in_year) {
            remaining_days = remaining_days - days_in_year;
            year = year + 1;
        } else {
            break;
        }
    }
    
    // Calculate month and day
    i32 month = 1;
    i64 day = remaining_days;  // 2026-10-31: day starts from 0
    
    // Subtract days for each month until we find the right month
    i32 idx = 0;
    while (idx < 12) {
        i64 dim = month_days[idx] as i64;
        if (day >= dim) {
            day = day - dim;
            month = month + 1;
            idx = idx + 1;
        } else {
            break;
        }
    }
    // day is now 0-based day of month, convert to 1-based
    day = day + 1;
    
    // Format: YYYYMMDD_HHMM
    String result = format!("{:04}{:02}{:02}_{:02}{:02}", year as i32, month, day as i32, rem_hours as i32, rem_mins as i32);
    return result;
}

void main() {
    // CLI parsing: GNU Go style switches
    String arg1 = std::env::args().nth(1).unwrap_or(String::new());
    String arg2 = std::env::args().nth(2).unwrap_or(String::new());
    String arg3 = std::env::args().nth(3).unwrap_or(String::new());
    String arg4 = std::env::args().nth(4).unwrap_or(String::new());
    String arg5 = std::env::args().nth(5).unwrap_or(String::new());
    bool gtp_mode = false;
    bool show_board_flag = false;
    i32 startup_level = 1;
    if (arg1 == "--version") {
        println!("phoenix 0.3.3.20261112133407");
        return;
    }
    if (arg1 == "--help") {
        println!("Phoenix - Wood Capture Go Engine (GTP v2)");
        println!("usage: phoenix [--mode gtp] [--show-board] [--level N] [--version] [--help]");
        println!("  (no args)    interactive mode with banner and shortcuts");
        println!("  --mode gtp   strict GTP protocol for GUIs");
        println!("  --show-board auto print board after each move (interactive only)");
        println!("  --level N    set AI level 1-10 at startup");
        println!("");
        println!("In-game help: type 'list_commands' to see all commands,");
        println!("or 'known_command <cmd>' to check if a command exists.");
        return;
    }
    if (arg1 == "--mode" && arg2 == "gtp") {
        gtp_mode = true;
    }
    if (arg1 == "--show-board" || arg2 == "--show-board" || arg3 == "--show-board") {
        show_board_flag = true;
    }
    // 2026-11-04 fix: scan every position for --level so the flag works
    // in any order after the executable name (e.g. "--mode gtp --level 6").
    if (arg1 == "--level") {
        startup_level = str_to_i32(arg2.clone());
    } else if (arg2 == "--level") {
        startup_level = str_to_i32(arg3.clone());
    } else if (arg3 == "--level") {
        startup_level = str_to_i32(arg4.clone());
    } else if (arg4 == "--level") {
        startup_level = str_to_i32(arg5.clone());
    }
    if (startup_level < 1 || startup_level > 10) {
        startup_level = 1;
    }

    Board b = new Board();
    // Default: twist-cross opening (use 'ucb' for clean board)
    b.setup_opening();
    if (!gtp_mode) {
        println!("wood_capture_go_engine_phoenix");
        std::io::Write::flush(&mut std::io::stdout());
    }
    
    // --show-board: display initial board state
    if (show_board_flag && !gtp_mode) {
        b.print_board();
    }

    // Undo history stack: one snapshot per successful placement
    i32[] hist_cells;   // 169 values per snapshot (x*13+y order)
    i32[] hist_meta;    // 5 values per snapshot: bc, wc, ko_x, ko_y, moves
    
    // Move history for game record/export (prepared for future SGF export)
    // Format per move: color(1=black,2=white), x, y, captured_count
    i32[] move_history;  // 4 values per move
    i32 move_count = 0;
    
    // 2026-11-03: Separate AI objects for black and white
    // 2026-11-04 fix: --level N now sets both black and white AI levels
    i32 ai_level_black = startup_level;
    i32 ai_level_white = startup_level;
    AIWrapper ai_black = create_ai(ai_level_black);
    AIWrapper ai_white = create_ai(ai_level_white);
    // Legacy single AI object (for backward compatibility with set ai level)
    i32 ai_level = startup_level;
    AIWrapper ai = create_ai(ai_level);
    
    // 2026-11-03: Capture targets (black needs 6, white needs 5)
    i32 black_target = 6;
    i32 white_target = 5;

    i32 empty_streak = 0;
    
    while (true) {
        bool board_changed = false;
        String line = std::io::stdin().lines().next().unwrap_or(Ok(String::new())).unwrap();

        if (line.len() == 0) {
            empty_streak = empty_streak + 1;
            if (empty_streak >= 3) {
                break;
            }
            continue;
        }
        empty_streak = 0;

        // Tokenize: cmd a1 a2
        String cmd = "";
        String a1 = "";
        String a2 = "";
        String a3 = "";
        i32 stage = 0;
        for (i32 i = 0; i < line.len(); i++) {
            char ch = line.chars().nth((usize)i).unwrap();
            if (ch == ' ' || ch == '\t') {
                if (stage == 0 && cmd.len() > 0) {
                    stage = 1;
                } else if (stage == 1 && a1.len() > 0) {
                    stage = 2;
                } else if (stage == 2 && a2.len() > 0) {
                    stage = 3;
                }
            } else {
                if (stage == 0) {
                    cmd.push(ch);
                } else if (stage == 1) {
                    a1.push(ch);
                } else if (stage == 2) {
                    a2.push(ch);
                } else {
                    a3.push(ch);
                }
            }
        }

        // alias normalization: shortcuts and legacy names
        if (cmd == "exit") {
            cmd = "quit";
        } else if (cmd == "cb") {
            cmd = "clear_board";
        } else if (cmd == "ucb") {
            cmd = "use_clean_board";
        } else if (cmd == "usb") {
            cmd = "use_set_board";
        } else if (cmd == "cb") {
            cmd = "clear_board";
        } else if (cmd == "sb") {
            cmd = "show_board";
        } else if (cmd == "sc") {
            cmd = "show";
            a1 = "captures";
        } else if (cmd == "r") {
            cmd = "result";
        } else if (cmd == "es") {
            cmd = "export_sgf";
        } else if (cmd == "pal") {
            cmd = "print_ai_level";
        } else if (cmd == "c") {
            cmd = "captures";
        } else if (cmd == "wr") {
            cmd = "print_wood_rules";
        } else if (cmd == "pt") {
            cmd = "print_target";
        } else if (cmd == "st") {
            cmd = "set_target";
        } else if (cmd == "h" || cmd == "help") {
            cmd = "help";
        } else if (cmd == "ls") {
            cmd = "list_commands";
        } else if (cmd == "pm") {
            cmd = "print_moves";
        } else if (cmd == "move_history") {
            cmd = "print_moves";
        } else if (cmd == "gb") {
            cmd = "genmove";
            a1 = "black";
        } else if (cmd == "gw") {
            cmd = "genmove";
            a1 = "white";
        } else if (cmd == "pb") {
            cmd = "play";
            a2 = a1.clone();
            a1 = "black";
        } else if (cmd == "pw") {
            cmd = "play";
            a2 = a1.clone();
            a1 = "white";
        }


        // GTP numeric command id echo: "5 name" -> "=5 Wood Capture Go"
        String p = " ";
        bool all_digits = cmd.len() > 0;
        for (i32 i = 0; i < cmd.len(); i++) {
            char ch = cmd.chars().nth((usize)i).unwrap();
            if (ch < '0' || ch > '9') {
                all_digits = false;
            }
        }
        if (all_digits) {
            p = format!("{} ", cmd.clone());
            cmd = a1.clone();
            a1 = a2.clone();
            a2 = "".to_string();
        }

        if (cmd == "quit") {
            println!("={}", p);
            println!("");
            std::io::Write::flush(&mut std::io::stdout());
            break;
        } else if (cmd == "protocol_version") {
            println!("={}2", p);
        } else if (cmd == "name") {
            println!("={}Wood Capture Go", p);
        } else if (cmd == "version") {
            println!("={}0.3.3.20261112133407", p);
        } else if (cmd == "known_command") {
            String k = "false";
            // 2026-11-12: keep this list identical to list_commands.
            if (a1 == "protocol_version" || a1 == "name" || a1 == "version"
                || a1 == "known_command" || a1 == "list_commands"
                || a1 == "quit" || a1 == "exit"
                || a1 == "boardsize" || a1 == "clear_board" || a1 == "cb"
                || a1 == "komi"
                || a1 == "play" || a1 == "pb" || a1 == "pw"
                || a1 == "genmove" || a1 == "gb" || a1 == "gw"
                || a1 == "undo" || a1 == "fixed_handicap"
                || a1 == "show_board" || a1 == "sb" || a1 == "show"
                || a1 == "sc" || a1 == "captures" || a1 == "c"
                || a1 == "wood_captures"
                || a1 == "result" || a1 == "r" || a1 == "final_score"
                || a1 == "print_moves" || a1 == "pm" || a1 == "move_history"
                || a1 == "export_sgf" || a1 == "es"
                || a1 == "export_wsgf" || a1 == "ew"
                || a1 == "ucb" || a1 == "use_clean_board"
                || a1 == "usb" || a1 == "use_set_board"
                || a1 == "print_target" || a1 == "pt" || a1 == "wood_target"
                || a1 == "set_target" || a1 == "st"
                || a1 == "print_wood_rules" || a1 == "wr" || a1 == "wood_rules"
                || a1 == "print_ai_level" || a1 == "pal" || a1 == "wood_ai_level"
                || a1 == "set"
                || a1 == "set_ai_level_all" || a1 == "sala"
                || a1 == "set_ai_level_black" || a1 == "salb"
                || a1 == "set_ai_level_white" || a1 == "salw"
                || a1 == "debug"
                || a1 == "help" || a1 == "h" || a1 == "ls") {
                k = "true";
            }
            println!("={}{}", p, k);
        } else if (cmd == "help") {
            // 2026-11-12: annotated command list for humans.
            // list_commands stays name-only (GTP clients parse it).
            println!("={}Phoenix commands (GTP v2)", p);
            println!("");
            println!("Protocol:");
            println!("  protocol_version              - GTP protocol version");
            println!("  name                          - engine name");
            println!("  version                       - engine version");
            println!("  known_command <cmd>           - true/false if command exists");
            println!("  list_commands, ls             - command names only");
            println!("  help, h                       - this annotated list");
            println!("  quit, exit                    - exit the program");
            println!("");
            println!("Board setup:");
            println!("  boardsize <n>                 - only 13 accepted");
            println!("  clear_board, cb               - clear and set twist-cross opening");
            println!("  use_clean_board, ucb          - switch to an empty board");
            println!("  use_set_board, usb            - restore twist-cross opening");
            println!("  komi <n>                      - only 0 accepted (no komi)");
            println!("  fixed_handicap <n>            - 0 = empty, 2 = twist-cross");
            println!("");
            println!("Moves:");
            println!("  play <color> <coord>          - e.g. play black G7; no pass");
            println!("  pb <coord>, pw <coord>        - play black/white shortcut");
            println!("  genmove <color>               - AI move, e.g. genmove white");
            println!("  gb, gw                        - AI black/white shortcut");
            println!("  undo                          - take back one move (not after game over)");
            println!("");
            println!("Display:");
            println!("  show_board, sb                - print the board");
            println!("  show captures                 - print capture counts");
            println!("  show board                    - same as show_board");
            println!("  captures, c, sc, wood_captures- print capture counts");
            println!("  print_moves, pm, move_history - print move history");
            println!("");
            println!("Game info:");
            println!("  result, r                     - gaming / black (N) / white (N) / draw (N)");
            println!("  final_score                   - GTP score: B+N / W+N / 0");
            println!("  print_target, pt, wood_target - show capture targets");
            println!("  set_target <color> <n>, st    - set targets (default black 6 / white 5)");
            println!("  print_wood_rules, wr, wood_rules - show rules version");
            println!("");
            println!("AI level:");
            println!("  set_ai_level_all <n>, sala    - set both sides");
            println!("  set_ai_level_black <n>, salb  - set black");
            println!("  set_ai_level_white <n>, salw  - set white");
            println!("  set ai <n>, set ai level <n>  - legacy alias for sala");
            println!("  print_ai_level, pal, wood_ai_level - show levels");
            println!("");
            println!("Export:");
            println!("  export_sgf, es                - write standard SGF");
            println!("  export_wsgf, ew               - write Wood SGF (same coordinates)");
            println!("");
            println!("Debug:");
            println!("  debug on|off|level <n>        - debug output (off in release)");
        } else if (cmd == "list_commands") {
            // 2026-11-12: keep this list identical to known_command.
            println!("={}protocol_version", p);
            println!("name");
            println!("version");
            println!("known_command");
            println!("list_commands");
            println!("quit");
            println!("exit");
            println!("boardsize");
            println!("clear_board");
            println!("cb");
            println!("komi");
            println!("play");
            println!("pb");
            println!("pw");
            println!("genmove");
            println!("gb");
            println!("gw");
            println!("undo");
            println!("fixed_handicap");
            println!("show_board");
            println!("sb");
            println!("show");
            println!("sc");
            println!("captures");
            println!("c");
            println!("wood_captures");
            println!("result");
            println!("r");
            println!("final_score");
            println!("print_moves");
            println!("pm");
            println!("move_history");
            println!("export_sgf");
            println!("es");
            println!("export_wsgf");
            println!("ew");
            println!("ucb");
            println!("use_clean_board");
            println!("usb");
            println!("use_set_board");
            println!("print_target");
            println!("pt");
            println!("wood_target");
            println!("set_target");
            println!("st");
            println!("print_wood_rules");
            println!("wr");
            println!("wood_rules");
            println!("print_ai_level");
            println!("pal");
            println!("wood_ai_level");
            println!("set");
            println!("sala");
            println!("set_ai_level_all");
            println!("salb");
            println!("set_ai_level_black");
            println!("salw");
            println!("set_ai_level_white");
            println!("debug");
            println!("help");
            println!("h");
            println!("ls");
        } else if (cmd == "boardsize") {
            i32 n = str_to_i32(a1.clone());
            if (n == 13) {
                println!("={}", p);
            } else {
                println!("?{}unacceptable size", p);
            }
        } else if (cmd == "clear_board") {
            b.clear();
            hist_cells.clear();
            hist_meta.clear();
            move_history.clear();
            move_count = 0;
            println!("={}", p);
            board_changed = true;
        } else if (cmd == "ucb" || cmd == "use_clean_board") {
            // Use clean board (no twist-cross opening)
            b.clear();
            hist_cells.clear();
            hist_meta.clear();
            move_history.clear();
            move_count = 0;
            println!("={}clean board ready", p);
            board_changed = true;
        } else if (cmd == "usb" || cmd == "use_set_board") {
            // Use set board (twist-cross opening)
            b.clear();
            b.setup_opening();
            hist_cells.clear();
            hist_meta.clear();
            move_history.clear();
            move_count = 0;
            // game_over_state reset handled by b.clear() -> Board.clear() -> game_over_state = 0
            println!("={}set board ready (twist-cross)", p);
            board_changed = true;
        } else if (cmd == "komi") {
            // Wood Capture Go has no komi; only 0 is acceptable
            if (a1 == "0" || a1 == "0.0" || a1 == "0.00" || a1 == "0.000") {
                println!("={}", p);
            } else {
                println!("?{}unacceptable komi", p);
            }
        } else if (cmd == "fixed_handicap") {
            // 0 = empty board without stones, 2 = twist-cross setup
            i32 n = str_to_i32(a1.clone());
            if (n == 0) {
                b.clear();
                b.set(6, 6, 0);
                b.set(6, 7, 0);
                b.set(7, 6, 0);
                b.set(7, 7, 0);
                hist_cells.clear();
                hist_meta.clear();
                println!("={}", p);
            } else if (n == 2) {
                b.clear();
                hist_cells.clear();
                hist_meta.clear();
                println!("={}", p);
                board_changed = true;
            } else {
                println!("?{}unacceptable handicap", p);
            }
        } else if (cmd == "show_board") {
            println!("={}", p);
            b.print_board();
        } else if (cmd == "play") {
            // play <color> <coord|pass|resign>
            debug_log_i32(1, "PLAY", "entry", 1);
            i32 color = 0;
            if (a1 == "black" || a1 == "b") {
                color = 1;
            } else if (a1 == "white" || a1 == "w") {
                color = 2;
            }
            if (color == 0) {
                println!("?{}invalid color", p);
            } else if (a2 == "resign") {
                println!("={}", p);
            } else if (a2 == "pass") {
                // RULE: Wood Capture Go has no pass move
                println!("?{}pass is not allowed", p);
            } else {
                i32 x = gtp_coord_to_x(a2.clone());
                i32 y = gtp_coord_to_y(a2.clone());
                debug_log_i32_3(1, "PLAY", "coord_x", x, "coord_y", y, "move_count", b.move_count);
                if (x < 0 || y < 0) {
                    println!("?{}invalid coordinate", p);
                } else {
                    // snapshot BEFORE the move: undo restores the state
                    // as it was prior to the last placement
                    for (i32 sx = 0; sx < 13; sx++) {
                        for (i32 sy = 0; sy < 13; sy++) {
                            hist_cells.push(b.get(sx, sy));
                        }
                    }
                    hist_meta.push(b.black_captures);
                    hist_meta.push(b.white_captures);
                    hist_meta.push(b.ko_x);
                    hist_meta.push(b.ko_y);
                    hist_meta.push(b.move_count);
                    i32 r = b.place_stone(x, y, color);
                    if (r >= 0) {
                        // Record move history: color, x, y, captured_count
                        move_history.push(color);
                        move_history.push(x);
                        move_history.push(y);
                        move_history.push(r);
                        move_count = move_count + 1;
                        // 2026-11-06: human moves must update the terminal
                        // state too, not just genmove.
                        b.refresh_game_over_state(move_count);
                        debug_log_i32_3(1, "PLAY", "ok", 1, "captured", r, "new_move_count", b.move_count);
                        println!("={}", p);
                        board_changed = true;
                    } else {
                        // rejected: place_stone rolled back internally,
                        // just drop the snapshot
                        i32 cbase = (i32)hist_cells.len() - 169;
                        hist_cells.truncate((usize)cbase);
                        i32 mbase2 = (i32)hist_meta.len() - 5;
                        hist_meta.truncate((usize)mbase2);
                        debug_log_i32_2(1, "PLAY", "rejected", r, "move_count", b.move_count);
                        if (r == -2) {
                            println!("?{}illegal move (suicide)", p);
                        } else if (r == -3) {
                            println!("?{}illegal move (ko)", p);
                        } else {
                            println!("?{}illegal move", p);
                        }
                    }
                }
            }
        } else if (cmd == "undo") {
            // 2026-11-06: once the game is over, undo is rejected.
            if (b.get_game_over_state() != 0) {
                println!("?{}cannot undo (game over)", p);
            } else if (hist_meta.len() >= 5) {
                i32 mbase = (i32)hist_meta.len() - 5;
                i32 m_bc = hist_meta[mbase];
                i32 m_wc = hist_meta[mbase + 1];
                i32 m_kx = hist_meta[mbase + 2];
                i32 m_ky = hist_meta[mbase + 3];
                i32 m_mc = hist_meta[mbase + 4];
                hist_meta.truncate((usize)mbase);
                i32 cbase = (i32)hist_cells.len() - 169;
                for (i32 x = 0; x < 13; x++) {
                    for (i32 y = 0; y < 13; y++) {
                        i32 ci = cbase + x * 13 + y;
                        i32 v = hist_cells[ci];
                        b.set(x, y, v);
                    }
                }
                hist_cells.truncate((usize)cbase);
                b.set_captures(1, m_bc);
                b.set_captures(2, m_wc);
                b.set_ko(m_kx, m_ky);
                b.set_move_count(m_mc);
                println!("={}", p);
                board_changed = true;
            } else {
                println!("?{}cannot undo", p);
            }
        } else if (cmd == "captures" || cmd == "wood_captures") {
            println!("={}black={} white={}", p, b.black_captures, b.white_captures);
        } else if (cmd == "print_target" || cmd == "wood_target") {
            println!("={}black_target={} white_target={}", p, black_target, white_target);
        } else if (cmd == "set_target") {
            // set_target black <N> / set_target white <N>
            if (a1 == "black") {
                i32 n = str_to_i32(a2.clone());
                if (n >= 1 && n <= 20) {
                    black_target = n;
                    println!("={}", p);
                } else {
                    println!("?{}unacceptable target", p);
                }
            } else if (a1 == "white") {
                i32 n = str_to_i32(a2.clone());
                if (n >= 1 && n <= 20) {
                    white_target = n;
                    println!("={}", p);
                } else {
                    println!("?{}unacceptable target", p);
                }
            } else {
                println!("?{}usage: set_target black|white <N>", p);
            }
        } else if (cmd == "show") {
            if (a1 == "captures") {
                println!("={}black={} white={}", p, b.black_captures, b.white_captures);
            } else if (a1 == "board") {
                println!("={}", p);
                b.print_board();
            } else {
                println!("?{}usage: show captures|board", p);
            }
        } else if (cmd == "result") {
            // Human-readable game status (internal state)
            // 2026-11-04: Show winning move number in parentheses
            i32 state = b.get_game_over_state();
            if (state == 1) {
                println!("={}black ({})", p, b.get_game_over_move());
            } else if (state == 2) {
                println!("={}white ({})", p, b.get_game_over_move());
            } else if (state == 3) {
                // 2026-11-04: Draw -> White wins (Wood Capture Go rule)
                println!("={}draw ({})", p, b.get_game_over_move());
            } else {
                println!("={}gaming", p);
            }
        } else if (cmd == "final_score") {
            // GTP standard, machine-readable: capture difference (B+N / W+N).
            // 2026-11-06: restored; the helper had been left unused since
            // the command was dropped in c9721f8.
            println!("={}{}", p, format_final_score(b.black_captures, b.white_captures));
        } else if (cmd == "print_wood_rules" || cmd == "wood_rules") {
            println!("={}Wood Capture Go Rules v1.0 (2026-09-13)", p);
        } else if (cmd == "move_history") {
            // Alias for standard print_moves command
            cmd = "print_moves";
        } else if (cmd == "print_moves" || cmd == "pm") {
            // Display move history in simple text format
            // Format: move_number: color x,y captured_count
            if (move_count == 0) {
                println!("={}No moves yet.", p);
            } else {
                println!("={}Move history ({} moves):", p, move_count);
                for (i32 i = 0; i < move_count; i++) {
                    i32 base = i * 4;
                    i32 mc = move_history[base];
                    i32 mx = move_history[base + 1];
                    i32 my = move_history[base + 2];
                    i32 cap = move_history[base + 3];
                    String color_str = "B";
                    if (mc != 1) {
                        color_str = "W";
                    }
                    String coord = xy_to_gtp(mx, my);
                    if (cap > 0) {
                        println!("{}: {} {} cap={}", i + 1, color_str, coord, cap);
                    } else {
                        println!("{}: {} {}", i + 1, color_str, coord);
                    }
                }
            }
        } else if (cmd == "export_wsgf" || cmd == "ew") {
            // Export game in Wood SGF format to file
            // 
            // Wood SGF is the Wood-flavoured export. Wood coordinates are
            // <column letter><row number> with a top-left origin; standard
            // SGF is <column letter><row letter> with the same origin.
            // After the 2026-11-06 orientation fix (rows counted from the
            // top, no flip) both formats emit identical coordinate strings.
            //
            // Coordinate mapping examples:
            // - G7 = (6, 6) -> both "gg"
            // - G8 = (6, 7) -> both "gh"
            // - H7 = (7, 6) -> both "hg"
            //
            // The command is kept for backward compatibility and to mark a
            // game as Wood-rules.
            //
            // Usage: export_wsgf [filename]
            //   - export_wsgf mygame -> writes mygame_wood.wsgf
            //   - export_wsgf (no arg) -> writes phoenix_game_<moves>_<timestamp>_wood.wsgf
            //
            // Created: 2026-11-04
            // Author: 龙小虾 🦞
            
            String sgf_content = format!("(;FF[4]GM[1]SZ[13]RU[WoodCaptureGo]PB[Black]PW[White]");
            for (i32 i = 0; i < move_count; i++) {
                i32 base = i * 4;
                i32 mc = move_history[base];
                i32 mx = move_history[base + 1];
                i32 my = move_history[base + 2];
                String color_str = "B";
                if (mc != 1) {
                    color_str = "W";
                }
                // Use Wood SGF conversion (no y-flip)
                String sgf_coord = wood_to_woodsgf(mx, my);
                sgf_content = format!("{};{}[{}]", sgf_content, color_str, sgf_coord);
            }
            sgf_content = sgf_content + ")";
            
            // Generate filename with timestamp
            // 2026-11-05: use the fully-qualified Rust path (Hust B1
            // workaround) because hust 0.3.9 does not emit the `use` line.
            i64 time_value = std::time::SystemTime::now().duration_since(std::time::SystemTime::UNIX_EPOCH).unwrap().as_secs() as i64;
            String timestamp = format_time_value(time_value);
            
            // Check if user specified custom filename
            String filename;
            if (a1 != "") {
                // User specified filename: export_wsgf mygame
                filename = format!("{}_wood.wsgf", a1);
            } else {
                filename = format!("phoenix_game_{}_{}_wood.wsgf", move_count, timestamp);
            }
            
            // Write to file
            std::fs::write(filename.clone(), sgf_content.clone());
            
            println!("={}Wood SGF exported to file: {}", p, filename);
            println!("{} moves exported", move_count);
            std::io::Write::flush(&mut std::io::stdout());
        } else if (cmd == "export_sgf") {
            // Export game in SGF format to file
            // Default: write to current executable directory
            // Build SGF content using format! to avoid Hust string literal issues
            String sgf_content = format!("(;FF[4]GM[1]SZ[13]RU[WoodCaptureGo]PB[Black]PW[White]");
            for (i32 i = 0; i < move_count; i++) {
                i32 base = i * 4;
                i32 mc = move_history[base];
                i32 mx = move_history[base + 1];
                i32 my = move_history[base + 2];
                String color_str = "B";
                if (mc != 1) {
                    color_str = "W";
                }
                String sgf_coord = xy_to_sgf(mx, my);
                sgf_content = format!("{};{}[{}]", sgf_content, color_str, sgf_coord);
            }
            sgf_content = sgf_content + ")";
            
            // Generate filename with timestamp
            // 2026-10-31: Convert time value to formatted timestamp
            // 2026-11-05: fully-qualified Rust path (Hust B1 workaround).
            i64 time_value = std::time::SystemTime::now().duration_since(std::time::SystemTime::UNIX_EPOCH).unwrap().as_secs() as i64;
            String timestamp = format_time_value(time_value);
            
            // Check if user specified custom filename
            String filename;
            if (a1 != "") {
                // User specified filename: export_sgf mygame
                filename = format!("{}.sgf", a1);
            } else {
                // Default filename with timestamp
                filename = format!("phoenix_game_{}_{}.sgf", move_count, timestamp);
            }
            
            // Write to file
            std::fs::write(filename.clone(), sgf_content.clone());
            
            println!("={}SGF exported to file: {}", p, filename);
            println!("{} moves exported", move_count);
            std::io::Write::flush(&mut std::io::stdout());
        } else if (cmd == "print_ai_level" || cmd == "wood_ai_level") {
            // Query with no argument, set when a level follows.
            // 2026-11-03: Now shows both black and white AI levels
            if (a1 == "") {
                println!("={}black={} white={}", p, ai_level_black, ai_level_white);
            } else {
                i32 lv = str_to_i32(a1.clone());
                if (lv >= 1 && lv <= 10) {
                    ai_level = lv;
                    ai = create_ai(ai_level);
                    ai_level_black = lv;
                    ai_black = create_ai(ai_level_black);
                    ai_level_white = lv;
                    ai_white = create_ai(ai_level_white);
                    println!("={}", p);
                } else {
                    println!("?{}unacceptable level", p);
                }
            }
        } else if (cmd == "salb" || cmd == "set_ai_level_black") {
            // 2026-11-03: Set black AI level independently
            // Usage: salb <N> (set) or salb (query)
            if (a1 == "") {
                println!("={}{}", p, ai_level_black);
            } else {
                i32 lv = str_to_i32(a1.clone());
                if (lv >= 1 && lv <= 10) {
                    ai_level_black = lv;
                    ai_black = create_ai(ai_level_black);
                    println!("={}", p);
                } else {
                    println!("?{}unacceptable level", p);
                }
            }
        } else if (cmd == "salw" || cmd == "set_ai_level_white") {
            // 2026-11-03: Set white AI level independently
            // Usage: salw <N> (set) or salw (query)
            if (a1 == "") {
                println!("={}{}", p, ai_level_white);
            } else {
                i32 lv = str_to_i32(a1.clone());
                if (lv >= 1 && lv <= 10) {
                    ai_level_white = lv;
                    ai_white = create_ai(ai_level_white);
                    println!("={}", p);
                } else {
                    println!("?{}unacceptable level", p);
                }
            }
        } else if (cmd == "set") {
            // set ai <N> / set ai level <N>
            // 2026-11-03: set ai level N = sala N (set both black and white)
            i32 lv = -1;
            bool ok = false;
            if (a1 == "ai") {
                if (a2 == "level") {
                    // set ai level <N> (legacy, same as sala)
                    lv = str_to_i32(a3.clone());
                    ok = true;
                } else {
                    // set ai <N>
                    lv = str_to_i32(a2.clone());
                    ok = true;
                }
            }
            if (ok && lv >= 1 && lv <= 10) {
                ai_level = lv;
                ai = create_ai(ai_level);  // Legacy single AI
                ai_level_black = lv;
                ai_black = create_ai(ai_level_black);
                ai_level_white = lv;
                ai_white = create_ai(ai_level_white);
                println!("={}", p);
            } else {
                println!("?{}unacceptable level", p);
            }
        } else if (cmd == "sala" || cmd == "set_ai_level_all") {
            // 2026-11-03: Set both black and white AI levels
            // Usage: sala <N> (set) or sala (query both)
            if (a1 == "") {
                println!("={}black={} white={}", p, ai_level_black, ai_level_white);
            } else {
                i32 lv = str_to_i32(a1.clone());
                if (lv >= 1 && lv <= 10) {
                    ai_level = lv;
                    ai = create_ai(ai_level);
                    ai_level_black = lv;
                    ai_black = create_ai(ai_level_black);
                    ai_level_white = lv;
                    ai_white = create_ai(ai_level_white);
                    println!("={}", p);
                } else {
                    println!("?{}unacceptable level", p);
                }
            }
        } else if (cmd == "genmove") {
            // genmove <color>: level-1 AI (greedy capture / random)
            i32 color = 0;
            if (a1 == "black" || a1 == "b") {
                color = 1;
            } else if (a1 == "white" || a1 == "w") {
                color = 2;
            }
            if (color == 0) {
                println!("?{}invalid color", p);
            } else {
                // snapshot BEFORE the AI move (same convention as play)
                for (i32 sx = 0; sx < 13; sx++) {
                    for (i32 sy = 0; sy < 13; sy++) {
                        hist_cells.push(b.get(sx, sy));
                    }
                }
                hist_meta.push(b.black_captures);
                hist_meta.push(b.white_captures);
                hist_meta.push(b.ko_x);
                hist_meta.push(b.ko_y);
                hist_meta.push(b.move_count);
                // dispatch through the unified AI interface
                // 2026-11-03: Use separate AI objects for black and white
                i32 lx = 0;
                i32 ly = 0;
                if (color == 1) {
                    b = ai_black.genmove(b, color);
                    lx = ai_black.last_x();
                    ly = ai_black.last_y();
                } else {
                    b = ai_white.genmove(b, color);
                    lx = ai_white.last_x();
                    ly = ai_white.last_y();
                }
                if (lx >= 0) {
                    // Record move history: color, x, y, captured_count
                    // Calculate captured count from board state change
                    if (color == 1) {
                        move_history.push(color);
                        move_history.push(lx);
                        move_history.push(ly);
                        move_history.push(b.white_captures - hist_meta[hist_meta.len() - 4]);
                    } else {
                        move_history.push(color);
                        move_history.push(lx);
                        move_history.push(ly);
                        move_history.push(b.black_captures - hist_meta[hist_meta.len() - 5]);
                    }
                    move_count = move_count + 1;
                    String coord = xy_to_gtp(lx, ly);
                    
                    // 2026-11-06: shared with the human play path
                    b.refresh_game_over_state(move_count);
                    
                    println!("={}{} black={} white={}", p, coord.clone(), b.black_captures, b.white_captures);
                    board_changed = true;
                } else {
                    // last_x == -1: no legal move
                    // 2026-11-04: Wood Capture Go - check if board is full or draw
                    i32 empties = 0;
                    for (i32 ex = 0; ex < 13; ex++) {
                        for (i32 ey = 0; ey < 13; ey++) {
                            if (b.get(ex, ey) == 0) {
                                empties = empties + 1;
                            }
                        }
                    }
                    
                    if (empties == 0) {
                        // Board full (theoretically impossible in Wood Capture Go)
                        // Compare captures to determine winner
                        if (b.black_captures > b.white_captures) {
                            b.set_game_over_state(1);
                        } else {
                            b.set_game_over_state(2);
                        }
                        b.set_game_over_move(move_count);
                    } else {
                        // Board not full, but no legal move -> Draw -> White wins
                        // 2026-11-04: Wood Capture Go rule - draw is a win for White
                        b.set_game_over_state(3);  // 3 = draw
                        b.set_game_over_move(move_count);
                    }
                    
                    // Drop snapshot
                    i32 cbase2 = (i32)hist_cells.len() - 169;
                    hist_cells.truncate((usize)cbase2);
                    i32 mbase3 = (i32)hist_meta.len() - 5;
                    hist_meta.truncate((usize)mbase3);
                    println!("={}pass", p);
                }
            }
                } else if (cmd == "debug") {
            // debug on | debug off | debug level <N>
            if (a1 == "on") {
                
                println!("={}", p);
            } else if (a1 == "off") {
                
                println!("={}", p);
            } else if (a1 == "level") {
                i32 lv = str_to_i32(a2.clone());
                if (lv >= 0 && lv <= 3) {
                    
                    println!("={}", p);
                } else {
                    println!("?{}unacceptable level", p);
                }
            } else {
                println!("?{}unknown debug command", p);
            }
} else {
            println!("?{}unknown command", p);
        }

        println!("");
        if (show_board_flag && !gtp_mode && board_changed) {
            b.print_board();
        }
        std::io::Write::flush(&mut std::io::stdout());
    }
}
