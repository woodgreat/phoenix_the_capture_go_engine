// Phoenix - Wood Capture Go Engine
// Step 7: GTP main loop
//
// GTP v2 protocol over stdin/stdout:
//   request : [id] command args...
//   response: = result\n\n  (success)  |  ? error\n\n  (failure)
//
// IO (verified in io_probe experiment, Hust 0.1.35):
//   - read line (EOF-safe): std::io::stdin().lines().next()
//       .unwrap_or(Ok(String::new())).unwrap()
//     newline is stripped by lines(); EOF yields an empty string
//   - flush (MANDATORY after every response, stdout is block-buffered
//     on pipes): std::io::Write::flush(&mut std::io::stdout())
//
// Command dispatch is INLINED in the main loop: the transpiler does
// not accept class-typed function definitions/returns (Board in/out
// would be silently passed through), so handle_command() as a free
// function is not possible. Ownership stays with main's `b`.

use board;
use gtp;

void main() {
    Board b = new Board();
    b.setup_twist_cross();

    i32 empty_streak = 0;
    while (true) {
        String line = std::io::stdin().lines().next().unwrap_or(Ok(String::new())).unwrap();

        // Blank lines are ignored per GTP, but EOF also yields empty
        // strings forever: 3 blanks in a row -> input closed -> quit
        if (line.len() == 0) {
            empty_streak = empty_streak + 1;
            if (empty_streak >= 3) {
                break;
            }
            continue;
        }
        empty_streak = 0;

        // Tokenize: cmd a1 a2 (extra whitespace tolerated; GTP command
        // IDs are parsed in Step 8)
        String cmd = "";
        String a1 = "";
        String a2 = "";
        i32 stage = 0;
        for (i32 i = 0; i < line.len(); i++) {
            char ch = line.chars().nth((usize)i).unwrap();
            if (ch == ' ' || ch == '\t') {
                if (stage == 0 && cmd.len() > 0) {
                    stage = 1;
                } else if (stage == 1 && a1.len() > 0) {
                    stage = 2;
                }
            } else {
                if (stage == 0) {
                    cmd.push(ch);
                } else if (stage == 1) {
                    a1.push(ch);
                } else {
                    a2.push(ch);
                }
            }
        }

        if (cmd == "quit") {
            println!("=");
            println!("");
            std::io::Write::flush(&mut std::io::stdout());
            break;
        } else if (cmd == "protocol_version") {
            println!("= 2");
        } else if (cmd == "name") {
            println!("= Wood Capture Go");
        } else if (cmd == "version") {
            println!("= 0.1.0.20261007170717");
        } else if (cmd == "boardsize") {
            i32 n = str_to_i32(a1.clone());
            if (n == 13) {
                println!("=");
            } else {
                println!("? unacceptable size");
            }
        } else if (cmd == "clear_board") {
            b.clear();
            println!("=");
        } else if (cmd == "komi") {
            // Wood Capture Go has no komi; only 0 is acceptable
            if (a1 == "0" || a1 == "0.0" || a1 == "0.00" || a1 == "0.000") {
                println!("=");
            } else {
                println!("? unacceptable komi");
            }
        } else if (cmd == "showboard") {
            println!("=");
            b.print_board();
        } else if (cmd == "play") {
            // play <color> <coord|pass|resign>
            i32 color = 0;
            if (a1 == "black" || a1 == "b") {
                color = 1;
            } else if (a1 == "white" || a1 == "w") {
                color = 2;
            }
            if (color == 0) {
                println!("? invalid color");
            } else if (a2 == "pass" || a2 == "resign") {
                println!("=");
            } else {
                i32 x = gtp_coord_to_x(a2.clone());
                i32 y = gtp_coord_to_y(a2.clone());
                if (x < 0 || y < 0) {
                    println!("? invalid coordinate");
                } else {
                    i32 r = b.place_stone(x, y, color);
                    if (r >= 0) {
                        println!("=");
                    } else if (r == -2) {
                        println!("? illegal move (suicide)");
                    } else if (r == -3) {
                        println!("? illegal move (ko)");
                    } else {
                        println!("? illegal move");
                    }
                }
            }
        } else if (cmd == "genmove") {
            // Placeholder until the Step 9 AI lands: always pass
            println!("= pass");
        } else {
            println!("? unknown command");
        }

        println!("");
        std::io::Write::flush(&mut std::io::stdout());
    }
}
