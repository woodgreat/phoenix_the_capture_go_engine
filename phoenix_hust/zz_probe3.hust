// 探针3：const 引用式传参能否避免 move
use board;

public i32 readOnly(const Board b, i32 color) {
    return b.get(6, 6) + color;
}

public i32 readonlyProbe(readonly Board b) {
    return b.get(6, 7);
}

void main() {
    Board b = new Board();
    println!("a={}", readOnly(b, 1));
    println!("b={}", b.get(6, 6));
}
