// ai_env_jie_loop.hust - 循环劫检测器（唯一僵局判定）
//
// 规则来源：z7 权威裁定 2026-10-20
//   终局只有三种：黑吃 >= 6 黑胜 / 白吃 >= 5 白胜 / 循环劫局白胜
//   循环劫成立：至少 3 个不同劫位，每个都被连续提回 >= 3 次
//   连续性：中间任一手不在循环劫位 -> 全部标记与计数归零
//
// 不使用 Zobrist 全局面哈希，只跟踪劫位本身，O(1) 更新。

public class JieLoopDetector {
    // 劫位标记：0 = 未标记，1 = 已标记（编码 x*13+y）
    i32[169] ko_points;
    // 每个劫位的连续提回次数（编码 x*13+y）
    i32[169] counters;
    // 当前已标记的劫位数
    i32 marked;
    // 是否已判出循环劫
    bool detected;

    public JieLoopDetector() {
        this.marked = 0;
        this.detected = false;
    }

    // 每走一手调用一次。
    //   enc: 这一手的落点编码 x*13+y
    //   is_ko: 这一手是否落在劫地（提劫/回提）
    public void on_move(i32 enc, bool is_ko) {
        if (!is_ko) {
            // 不是劫地：整个循环链被打断，全部清零重算
            this.clear_all();
            return;
        }
        if (enc < 0 || enc >= 169) {
            return;
        }
        if (this.ko_points[enc] == 0) {
            // 首次出现这个劫位
            this.ko_points[enc] = 1;
            this.counters[enc] = 1;
            this.marked = this.marked + 1;
        } else {
            // 该劫位再次被提回
            this.counters[enc] = this.counters[enc] + 1;
        }
        this.detected = this.is_loop();
    }

    // 是否成立循环劫：至少 3 个劫位，且每个计数都 >= 3
    public readonly bool is_loop() {
        if (this.marked < 3) {
            return false;
        }
        i32 ok = 0;
        for (i32 i = 0; i < 169; i++) {
            if (this.ko_points[i] == 1) {
                if (this.counters[i] >= 3) {
                    ok = ok + 1;
                } else {
                    // 有劫位还没到 3 次，整体不成立
                    return false;
                }
            }
        }
        return ok >= 3;
    }

    // 已经判出循环劫（用于主循环查询，避免重复扫描）
    public readonly bool is_detected() {
        return this.detected;
    }

    // 已标记的劫位数
    public readonly i32 marked_count() {
        return this.marked;
    }

    // 某个劫位的连续提回次数
    public readonly i32 counter_at(i32 enc) {
        if (enc < 0 || enc >= 169) {
            return 0;
        }
        return this.counters[enc];
    }

    // 清空全部标记与计数
    public void clear_all() {
        for (i32 i = 0; i < 169; i++) {
            this.ko_points[i] = 0;
            this.counters[i] = 0;
        }
        this.marked = 0;
        this.detected = false;
    }
}
