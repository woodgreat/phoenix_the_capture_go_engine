// cannot_move_probe.hust
//
// Constructs the only legal cannot_move position:
//   - Black has one stone at (0,1), surrounded by White, with a single
//     external liberty at (0,0).
//   - White owns every other point; (12,12) is White's single eye.
//   - Black to move:
//       (0,0) fills Black's own last liberty -> suicide.
//       (12,12) fills White's eye, no capture       -> suicide.
//     No other empty points exist -> cannot_move.
//
// Expected:
//   is_legal_placement(0,0,black)   = false
//   is_legal_placement(12,12,black) = false
//   Level1.genmove -> last_x = -1, last_y = -1

use board;
use ai;

void main() {
    Board b = new Board();
    b.clear();

    // Fill the whole board with White.
    for (i32 x = 0; x < 13; x++) {
        for (i32 y = 0; y < 13; y++) {
            b.set(x, y, 2);
        }
    }

    // Black stone with exactly one liberty at (0,0).
    b.set(0, 1, 1);
    b.set(0, 0, 0);

    // White's single eye.
    b.set(12, 12, 0);

    bool l1 = b.is_legal_placement(0, 0, 1);
    bool l2 = b.is_legal_placement(12, 12, 1);
    if (l1) {
        println!("legal (0,0)   black = 1");
    } else {
        println!("legal (0,0)   black = 0");
    }
    if (l2) {
        println!("legal (12,12) black = 1");
    } else {
        println!("legal (12,12) black = 0");
    }

    Level1 probe = new Level1();
    Board after = probe.genmove(b, 1);
    println!("last_x = {}", probe.last_x());
    println!("last_y = {}", probe.last_y());

    if (!l1 && !l2 && probe.last_x() < 0) {
        println!("[PASS] cannot_move detected correctly");
    } else {
        println!("[FAIL] cannot_move not detected");
    }
}
