// test_jie_loop.hust - 循环劫检测器单元测试
// 规则：至少 3 个劫位，每个连续提回 >= 3 次 -> 循环劫 -> 白胜
// 中间任一手不在劫位 -> 全部清零

use ai_env_jie_loop;

// 用简单编码表示劫位：A=10, B=20, C=30, D=40（非劫地用其它值）
void test_empty() {
    println!("Test 1: 初始状态");
    JieLoopDetector d = new JieLoopDetector();
    if (!d.is_loop()) {
        println!("  [PASS] 空检测器不成立循环劫");
    } else {
        println!("  [FAIL] 空检测器不应成立");
    }
    if (d.marked_count() == 0) {
        println!("  [PASS] 初始标记数为 0");
    } else {
        println!("  [FAIL] 初始标记数应为 0");
    }
}

void test_single_ko() {
    println!("Test 2: 单个劫往返 5 次");
    JieLoopDetector d = new JieLoopDetector();
    for (i32 i = 0; i < 5; i++) {
        d.on_move(10, true);
    }
    if (d.marked_count() == 1) {
        println!("  [PASS] 标记数为 1");
    } else {
        println!("  [FAIL] 标记数应为 1，实际 {}", d.marked_count());
    }
    if (d.counter_at(10) == 5) {
        println!("  [PASS] 计数为 5");
    } else {
        println!("  [FAIL] 计数应为 5，实际 {}", d.counter_at(10));
    }
    if (!d.is_loop()) {
        println!("  [PASS] 单劫不成立循环劫");
    } else {
        println!("  [FAIL] 单劫不应成立");
    }
}

void test_two_kos() {
    println!("Test 3: 两个劫各往返 3 次");
    JieLoopDetector d = new JieLoopDetector();
    d.on_move(10, true);
    d.on_move(20, true);
    d.on_move(10, true);
    d.on_move(20, true);
    d.on_move(10, true);
    d.on_move(20, true);
    if (d.marked_count() == 2) {
        println!("  [PASS] 标记数为 2");
    } else {
        println!("  [FAIL] 标记数应为 2");
    }
    if (!d.is_loop()) {
        println!("  [PASS] 两劫不成立循环劫（最少要 3 个）");
    } else {
        println!("  [FAIL] 两劫不应成立");
    }
}

void test_three_kos_exact() {
    println!("Test 4: 三劫各往返 3 次 —— 应判循环劫");
    JieLoopDetector d = new JieLoopDetector();
    d.on_move(10, true);
    d.on_move(20, true);
    d.on_move(30, true);
    d.on_move(10, true);
    d.on_move(20, true);
    d.on_move(30, true);
    if (d.is_loop()) {
        println!("  [FAIL] 才 2 轮，不应成立");
    } else {
        println!("  [PASS] 2 轮未成立");
    }
    d.on_move(10, true);
    d.on_move(20, true);
    d.on_move(30, true);
    if (d.is_loop()) {
        println!("  [PASS] 3 轮成立循环劫");
    } else {
        println!("  [FAIL] 3 轮应成立");
    }
    if (d.is_detected()) {
        println!("  [PASS] detected 标志为真");
    } else {
        println!("  [FAIL] detected 标志应为真");
    }
}

void test_interrupted() {
    println!("Test 5: 中途被打断 —— 应全部清零");
    JieLoopDetector d = new JieLoopDetector();
    d.on_move(10, true);
    d.on_move(20, true);
    d.on_move(30, true);
    d.on_move(10, true);
    d.on_move(20, true);
    d.on_move(30, true);
    d.on_move(10, true);
    d.on_move(20, true);
    // 这一手不在劫地
    d.on_move(40, false);
    if (d.marked_count() == 0) {
        println!("  [PASS] 打断后标记数归零");
    } else {
        println!("  [FAIL] 打断后应为 0，实际 {}", d.marked_count());
    }
    if (d.counter_at(10) == 0) {
        println!("  [PASS] 打断后计数归零");
    } else {
        println!("  [FAIL] 打断后计数应为 0");
    }
    if (!d.is_loop()) {
        println!("  [PASS] 打断后不成立");
    } else {
        println!("  [FAIL] 打断后不应成立");
    }
}

void test_multi_ko() {
    println!("Test 6: 四劫循环（多劫）—— 应判循环劫");
    JieLoopDetector d = new JieLoopDetector();
    for (i32 r = 0; r < 3; r++) {
        d.on_move(10, true);
        d.on_move(20, true);
        d.on_move(30, true);
        d.on_move(40, true);
    }
    if (d.is_loop()) {
        println!("  [PASS] 四劫循环成立");
    } else {
        println!("  [FAIL] 四劫循环应成立");
    }
    if (d.marked_count() == 4) {
        println!("  [PASS] 标记数为 4");
    } else {
        println!("  [FAIL] 标记数应为 4");
    }
}

void test_uneven() {
    println!("Test 7: 三劫但其中一个只往返 2 次 —— 不成立");
    JieLoopDetector d = new JieLoopDetector();
    for (i32 r = 0; r < 3; r++) {
        d.on_move(10, true);
        d.on_move(20, true);
    }
    d.on_move(30, true);
    d.on_move(30, true);
    if (!d.is_loop()) {
        println!("  [PASS] 不均匀计数不成立");
    } else {
        println!("  [FAIL] 不均匀计数不应成立");
    }
}

void test_clear_manual() {
    println!("Test 8: 手动清空");
    JieLoopDetector d = new JieLoopDetector();
    for (i32 r = 0; r < 3; r++) {
        d.on_move(10, true);
        d.on_move(20, true);
        d.on_move(30, true);
    }
    d.clear_all();
    if (!d.is_loop() && d.marked_count() == 0 && !d.is_detected()) {
        println!("  [PASS] 清空后状态干净");
    } else {
        println!("  [FAIL] 清空后仍有残留");
    }
}

void main() {
    println!("=== JieLoopDetector 测试 ===");
    test_empty();
    test_single_ko();
    test_two_kos();
    test_three_kos_exact();
    test_interrupted();
    test_multi_ko();
    test_uneven();
    test_clear_manual();
    println!("=== 测试完成 ===");
}
