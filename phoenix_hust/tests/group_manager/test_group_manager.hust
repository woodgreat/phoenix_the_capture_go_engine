// test_group_manager.hust - GroupManager 单元测试
// Phase 1.3: Group 对象数组 + .replaceit()
// 2026-10-17

use ai_env_datatypes;

// ==================== 测试用例 ====================

// 测试 1：空棋盘
void test_empty_board() {
    println!("Test 1: Empty board");
    
    GroupManager gm = new GroupManager();
    i32[169] grid = {0};
    gm.build_from_grid(grid);
    
    i32 count = gm.count();
    if (count == 0) {
        println!("  [PASS] Empty board: group_count = 0");
    } else {
        println!("  [FAIL] Empty board: expected 0, got {}", count);
    }
}

// 测试 2：单个黑子
void test_single_black_stone() {
    println!("Test 2: Single black stone at (0,0)");
    
    GroupManager gm = new GroupManager();
    i32[169] grid = {0};
    grid[0] = 1;  // (0,0) 黑子
    
    gm.build_from_grid(grid);
    
    i32 count = gm.count();
    if (count == 1) {
        println!("  [PASS] Single stone: group_count = 1");
    } else {
        println!("  [FAIL] Single stone: expected 1, got {}", count);
        return;
    }
    
    i32 color = gm.get_group_color(0);
    if (color == 1) {
        println!("  [PASS] Single stone: color = 1 (black)");
    } else {
        println!("  [FAIL] Single stone: color expected 1, got {}", color);
    }
    
    i32 libs = gm.get_group_lib_count(0);
    if (libs == 2) {
        println!("  [PASS] Single stone: libs = 2 (corner)");
    } else {
        println!("  [FAIL] Single stone: libs expected 2, got {}", libs);
    }
}

// 测试 3：两个相连黑子
void test_two_connected_black_stones() {
    println!("Test 3: Two connected black stones at (0,0) and (0,1)");
    
    GroupManager gm = new GroupManager();
    i32[169] grid = {0};
    grid[0] = 1;  // (0,0)
    grid[1] = 1;  // (0,1) 相连
    
    gm.build_from_grid(grid);
    
    i32 count = gm.count();
    if (count == 1) {
        println!("  [PASS] Connected stones: group_count = 1");
    } else {
        println!("  [FAIL] Connected stones: expected 1, got {}", count);
        return;
    }
    
    i32 size = gm.get_group_size(0);
    if (size == 2) {
        println!("  [PASS] Connected stones: size = 2");
    } else {
        println!("  [FAIL] Connected stones: size expected 2, got {}", size);
    }
    
    i32 libs = gm.get_group_lib_count(0);
    if (libs == 3) {
        println!("  [PASS] Connected stones: libs = 3 (edge)");
    } else {
        println!("  [FAIL] Connected stones: libs expected 3, got {}", libs);
    }
}

// 测试 4：两个不相连黑子
void test_two_separate_black_stones() {
    println!("Test 4: Two separate black stones at (0,0) and (7,9)");
    
    GroupManager gm = new GroupManager();
    i32[169] grid = {0};
    grid[0] = 1;    // (0,0)
    grid[100] = 1;  // (7,9) 不相连
    
    gm.build_from_grid(grid);
    
    i32 count = gm.count();
    if (count == 2) {
        println!("  [PASS] Separate stones: group_count = 2");
    } else {
        println!("  [FAIL] Separate stones: expected 2, got {}", count);
    }
}

// 测试 5：黑白各一子
void test_one_black_one_white() {
    println!("Test 5: One black at (0,0), one white at (0,1)");
    
    GroupManager gm = new GroupManager();
    i32[169] grid = {0};
    grid[0] = 1;  // (0,0) 黑
    grid[1] = 2;  // (0,1) 白
    
    gm.build_from_grid(grid);
    
    i32 count = gm.count();
    if (count == 2) {
        println!("  [PASS] Black and white: group_count = 2");
    } else {
        println!("  [FAIL] Black and white: expected 2, got {}", count);
        return;
    }
    
    i32 color0 = gm.get_group_color(0);
    i32 color1 = gm.get_group_color(1);
    if (color0 == 1 && color1 == 2) {
        println!("  [PASS] Black and white: colors = 1,2");
    } else {
        println!("  [FAIL] Black and white: colors expected 1,2, got {},{}", color0, color1);
    }
}

// 测试 6：角落黑子（2口气）
void test_corner_stone() {
    println!("Test 6: Black stone at corner (0,0)");
    
    GroupManager gm = new GroupManager();
    i32[169] grid = {0};
    grid[0] = 1;  // (0,0) 角落
    
    gm.build_from_grid(grid);
    
    i32 libs = gm.get_group_lib_count(0);
    if (libs == 2) {
        println!("  [PASS] Corner stone: libs = 2");
    } else {
        println!("  [FAIL] Corner stone: libs expected 2, got {}", libs);
    }
}

// 测试 7：边缘黑子（3口气）
void test_edge_stone() {
    println!("Test 7: Black stone at edge (0,5)");
    
    GroupManager gm = new GroupManager();
    i32[169] grid = {0};
    grid[5] = 1;  // (0,5) 边缘
    
    gm.build_from_grid(grid);
    
    i32 libs = gm.get_group_lib_count(0);
    if (libs == 3) {
        println!("  [PASS] Edge stone: libs = 3");
    } else {
        println!("  [FAIL] Edge stone: libs expected 3, got {}", libs);
    }
}

// 测试 8：中心黑子（4口气）
void test_center_stone() {
    println!("Test 8: Black stone at center (6,6)");
    
    GroupManager gm = new GroupManager();
    i32[169] grid = {0};
    grid[84] = 1;  // (6,6) 中心
    
    gm.build_from_grid(grid);
    
    i32 libs = gm.get_group_lib_count(0);
    if (libs == 4) {
        println!("  [PASS] Center stone: libs = 4");
    } else {
        println!("  [FAIL] Center stone: libs expected 4, got {}", libs);
    }
}

// ==================== 主测试函数 ====================

public void main() {
    println!("=== GroupManager Unit Tests (Phase 1.3) ===");
    println!("");
    
    test_empty_board();
    println!("");
    
    test_single_black_stone();
    println!("");
    
    test_two_connected_black_stones();
    println!("");
    
    test_two_separate_black_stones();
    println!("");
    
    test_one_black_one_white();
    println!("");
    
    test_corner_stone();
    println!("");
    
    test_edge_stone();
    println!("");
    
    test_center_stone();
    println!("");
    
    println!("=== All tests completed ===");
}
