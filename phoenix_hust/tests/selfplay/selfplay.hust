// selfplay.hust - AI 自对弈测试
// 用法: hust run selfplay.hust [black_level] [white_level] [max_moves]

use board;
use ai;
use debug;

void main() {
    println!("=== Phoenix Self-Play Test ===");
    
    // 默认参数
    i32 black_level = 5;
    i32 white_level = 5;
    i32 max_moves = 100;
    
    // 解析命令行参数（简化处理）
    // Hust 的 args() 返回 Vec<String>
    // 注意：第一个参数是程序名
    
    println!("Black Level: {}, White Level: {}", black_level, white_level);
    println!("Max moves: {}", max_moves);
    
    // 创建棋盘（带扭十字开局）
    Board b = new Board();
    b.setup_opening();
    
    println!("\nInitial board (twist-cross):");
    b.print_board();
    
    // 创建 AI
    AIWrapper black_ai = new AIWrapper(black_level);
    AIWrapper white_ai = new AIWrapper(white_level);
    
    // 对弈循环
    i32 move_count = 0;
    i32 current_color = 1;  // 黑先
    i32 black_captures = 0;
    i32 white_captures = 0;
    
    while (move_count < max_moves) {
        println!("\n--- Move {}: {} ---", move_count + 1, 
            if current_color == 1 { "Black" } else { "White" });
        
        // 当前方走棋（每次创建新 AI 实例，避免 move 问题）
        AIWrapper current_ai = new AIWrapper(if current_color == 1 { black_level } else { white_level });
        Board new_b = current_ai.genmove(b, current_color);
        
        // 检查是否有合法走法
        i32 ax = current_ai.last_x();
        i32 ay = current_ai.last_y();
        if (ax < 0 || ay < 0) {
            println!("No legal move for {}! Game over.", 
                if current_color == 1 { "Black" } else { "White" });
            break;
        }
        
        // 更新棋盘
        b = new_b;
        
        // 打印走法
        i32 col = ax + 1;  // 1-13
        i32 row = ay + 1;  // 1-13
        println!("{} plays at ({}, {})", 
            if current_color == 1 { "Black" } else { "White" }, col, row);
        
        // 打印棋盘
        b.print_board();
        
        // 检查吃子数
        black_captures = b.get_captures(1);
        white_captures = b.get_captures(2);
        println!("Captures - Black: {}, White: {}", black_captures, white_captures);
        
        // 检查胜负
        if (black_captures >= 6) {
            println!("\n*** Black wins! (captured {} stones) ***", black_captures);
            break;
        }
        if (white_captures >= 5) {
            println!("\n*** White wins! (captured {} stones) ***", white_captures);
            break;
        }
        
        // 切换颜色
        current_color = if current_color == 1 { 2 } else { 1 };
        move_count = move_count + 1;
    }
    
    // 终局统计
    println!("\n=== Game Over ===");
    println!("Total moves: {}", move_count);
    println!("Final captures - Black: {}, White: {}", black_captures, white_captures);
    
    if (black_captures >= 6) {
        println!("Winner: Black");
    } else if (white_captures >= 5) {
        println!("Winner: White");
    } else {
        println!("No winner yet (move limit reached)");
    }
}
