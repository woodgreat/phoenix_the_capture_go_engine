// test_array_modify.hust - 测试动态数组元素修改

public class TestArr {
    i32[] data;
    
    public TestArr() {
        this.data.push(10);
        this.data.push(20);
        this.data.push(30);
    }
    
    public void modify_element(i32 idx, i32 val) {
        // 测试：修改指定位置的元素
        this.data[idx] = val;
    }
    
    public i32 get_element(i32 idx) {
        return this.data[idx];
    }
}

public void main() {
    TestArr t = new TestArr();
    t.modify_element(1, 99);
    println!("element[1] = {}", t.get_element(1));
}
