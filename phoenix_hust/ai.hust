        i32 enc = b2.search_root_timed(color, 28, 4, 14, 350, 20, 0);
        if (enc < 0) {
            // Wood rules forbid passing: fall back to any legal point.
            enc = b2.any_legal_move(color);
        }
        if (enc < 0) {
            this.last_x = -1;
            this.last_y = -1;
            return b2;
        }
        i32 mx = enc / 13;
        i32 my = enc - mx * 13;
        i32 r = b2.place_stone(mx, my, color);
        if (r >= 0) {
            this.last_x = mx;
            this.last_y = my;
        } else {
            this.last_x = -1;
            this.last_y = -1;
        }
        return b2;
    }
}

