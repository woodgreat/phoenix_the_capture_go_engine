// Level 9: iterative deepening depth 2..6 + large budget (800k).
public class Level9 implements MoveGenerator {
    i32 last_x;
    i32 last_y;

    public Level9() {
        this.last_x = -1;
        this.last_y = -1;
    }

    public i32 last_x() {
        return this.last_x;
    }

    public i32 last_y() {
        return this.last_y;
    }

    public Board genmove(Board board, i32 color) {
        Board b2 = new Board();
        b2.copy_from(board);
        debug_log_i32(1, "L9", "genmove color", color);
        i32 opp = b2.opponent(color);
        i32[4] dxs = {0, 0, 1, -1};
        i32[4] dys = {1, -1, 0, 0};
        i32 best_enc = -1;
        for (i32 dd = 6; dd <= 9; dd++) {
            best_enc = -1;
            i32 best_val = -999999;
            b2.start_search(700000);
            for (i32 x = 0; x < 13; x++) {
                for (i32 y = 0; y < 13; y++) {
                    if (b2.get(x, y) == 0) {
                        bool is_ko = b2.is_ko_point(x, y);
                        i32[13][13] snap = {0};
                        for (i32 i = 0; i < 13; i++) {
                            for (i32 j = 0; j < 13; j++) {
                                snap[i][j] = b2.get(i, j);
                            }
                        }
                        b2.set(x, y, color);
                        i32 cap = 0;
                        for (i32 d = 0; d < 4; d++) {
                            i32 nx = x + dxs[d];
                            i32 ny = y + dys[d];
                            if (b2.is_valid(nx, ny)) {
                                if (b2.get(nx, ny) == opp) {
                                    if (b2.count_liberties(nx, ny) == 0) {
                                        cap = cap + b2.remove_group(nx, ny);
                                    }
                                }
                            }
                        }
                        bool alive = b2.count_liberties(x, y) > 0;
                        i32 val = -999999;
                        if (alive && !(is_ko && cap == 1)) {
                            val = b2.minimax(dd - 1, opp, color, -999999, 999999);
                        // 2026-11-05 de-homogenization: add random noise to break determinism
                        val = val + b2.rand_below(401) - 200;
                        }
                        for (i32 i = 0; i < 13; i++) {
                            for (i32 j = 0; j < 13; j++) {
                                b2.set(i, j, snap[i][j]);
                            }
                        }
                        if (val > best_val) {
                            best_val = val;
                            best_enc = x * 13 + y;
                        } else if (val == best_val && val > -999999) {
                            // Random tie-breaking: equal value, randomly switch
                            if (b2.rand_below(2) == 0) {
                                best_enc = x * 13 + y;
                            }
                        }
                    }
                }
            }
            if (b2.search_nodes > b2.search_budget) {
                break;
            }
        }
        if (best_enc < 0) {
            // Wood rules forbid passing: fill any empty point (random)
            i32[169] all_empty = {0};
            i32 n_all = 0;
            for (i32 x = 0; x < 13; x++) {
                for (i32 y = 0; y < 13; y++) {
                    if (b2.get(x, y) == 0) {
                        all_empty[n_all] = x * 13 + y;
                        n_all = n_all + 1;
                    }
                }
            }
            if (n_all > 0) {
                best_enc = all_empty[b2.rand_below(n_all)];
                debug_log_i32(1, "L5", "filling random", best_enc);
            } else {
                this.last_x = -1;
                this.last_y = -1;
                return b2;
            }
        }
        i32 mx = best_enc / 13;
        i32 my = best_enc - mx * 13;
        i32 r = b2.place_stone(mx, my, color);
        if (r >= 0) {
            this.last_x = mx;
            this.last_y = my;
        } else {
            this.last_x = -1;
            this.last_y = -1;
        }
        return b2;
    }
}

// Level 10: same engine as Level 7 with deeper iteration (2..7) and a
// larger node budget.
public class Level10 implements MoveGenerator {
    i32 last_x;
    i32 last_y;

    public Level10() {
        this.last_x = -1;
        this.last_y = -1;
    }

    public i32 last_x() {
        return this.last_x;
    }

    public i32 last_y() {
        return this.last_y;
    }

    public Board genmove(Board board, i32 color) {
        Board b2 = new Board();
        b2.copy_from(board);
        debug_log_i32(1, "L10", "genmove color", color);
        i32 opp = b2.opponent(color);
        i32[4] dxs = {0, 0, 1, -1};
        i32[4] dys = {1, -1, 0, 0};
        i32 best_enc = -1;
        for (i32 dd = 7; dd <= 10; dd++) {
            best_enc = -1;
            i32 best_val = -999999;
            b2.start_search(800000);
            for (i32 x = 0; x < 13; x++) {
                for (i32 y = 0; y < 13; y++) {
                    if (b2.get(x, y) == 0) {
                        bool is_ko = b2.is_ko_point(x, y);
                        i32[13][13] snap = {0};
                        for (i32 i = 0; i < 13; i++) {
                            for (i32 j = 0; j < 13; j++) {
                                snap[i][j] = b2.get(i, j);
                            }
                        }
                        b2.set(x, y, color);
                        i32 cap = 0;
                        for (i32 d = 0; d < 4; d++) {
                            i32 nx = x + dxs[d];
                            i32 ny = y + dys[d];
                            if (b2.is_valid(nx, ny)) {
                                if (b2.get(nx, ny) == opp) {
                                    if (b2.count_liberties(nx, ny) == 0) {
                                        cap = cap + b2.remove_group(nx, ny);
                                    }
                                }
                            }
                        }
                        bool alive = b2.count_liberties(x, y) > 0;
                        i32 val = -999999;
                        if (alive && !(is_ko && cap == 1)) {
                            val = b2.minimax(dd - 1, opp, color, -999999, 999999);
                        // 2026-11-05 de-homogenization: add random noise to break determinism
                        val = val + b2.rand_below(401) - 200;
                        }
                        for (i32 i = 0; i < 13; i++) {
                            for (i32 j = 0; j < 13; j++) {
                                b2.set(i, j, snap[i][j]);
                            }
                        }
                        if (val > best_val) {
                            best_val = val;
                            best_enc = x * 13 + y;
                        } else if (val == best_val && val > -999999) {
                            // Random tie-breaking: equal value, randomly switch
                            if (b2.rand_below(2) == 0) {
                                best_enc = x * 13 + y;
                            }
                        }
                    }
                }
            }
            if (b2.search_nodes > b2.search_budget) {
                break;
            }
        }
        if (best_enc < 0) {
            // Wood rules forbid passing: fill any empty point (random)
            i32[169] all_empty = {0};
            i32 n_all = 0;
            for (i32 x = 0; x < 13; x++) {
                for (i32 y = 0; y < 13; y++) {
                    if (b2.get(x, y) == 0) {
                        all_empty[n_all] = x * 13 + y;
                        n_all = n_all + 1;
                    }
                }
            }
            if (n_all > 0) {
                best_enc = all_empty[b2.rand_below(n_all)];
                debug_log_i32(1, "L5", "filling random", best_enc);
            } else {
                this.last_x = -1;
                this.last_y = -1;
                return b2;
            }
        }
        i32 mx = best_enc / 13;
        i32 my = best_enc - mx * 13;
        i32 r = b2.place_stone(mx, my, color);
        if (r >= 0) {
            this.last_x = mx;
            this.last_y = my;
        } else {
            this.last_x = -1;
            this.last_y = -1;
        }
        return b2;
    }
}
