// Level 7: selective alpha-beta, depth 2 plies after the root, 14-wide.
// Wood Capture Go forbids passing: the engine always returns a real move.
// All LV6-LV10 levels return -1 only when there is genuinely no legal
// point (theoretically unreachable on a 13x13 board).
public class Level7 implements MoveGenerator {
    i32 last_x;
    i32 last_y;

    public Level7() {
        this.last_x = -1;
        this.last_y = -1;
