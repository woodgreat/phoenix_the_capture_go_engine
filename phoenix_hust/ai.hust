// ai.hust - AI strategy layer (shape-interface pattern, r44)
//
// ALGORITHM FAMILY: SCM A.I - Simple Counting Method.
//   Chinese: 简洁数势法. It counts the EFFECTIVENESS OF STONES (势 = 子的
//   效能), not merely their number: a stone is worth more where it has
//   liberties, connections and eye potential, less where it is surrounded
//   and short of air. The method evaluates statically in layers and does
//   not rely on deep search.
//
//   This file is one instance of that family. The LevelN classes are
//   STRENGTH TIERS of the same algorithm (more tiers = deeper lookahead
//   and a richer layer mix), not different algorithms. Other agents on the
//   same board may implement entirely different families; SCM A.I names
//   only this one.
//
//   Layer stack (see ai_env_evaluate.hust):
//     L1 terminal -> L2 quota -> L4 non-linear liberties -> L3 fight zones
//     -> L5 forcing -> L6 ko
//
//   Perspective of every layer: the side being scored.
//
// Declaration: no types (shape). Implementation: types filled in.
// Ownership round-trip: the board moves INTO genmove, the AI places
// its stone, and the board moves BACK to the caller
// (`b = l1.genmove(b, color);` - verified in io_probe v7b).
// Level1 records the move it made; the caller reads last_x/last_y
// to build the GTP response.

use board;
use debug;

interface MoveGenerator {
    public newBoard genmove(board, color);
}

public class Level1 implements MoveGenerator {
    i32 last_x;
    i32 last_y;

    public Level1() {
        this.last_x = -1;
        this.last_y = -1;
    }

    // The move made by the last genmove call (-1 = no legal point; never a pass)
    public i32 last_x() {
        return this.last_x;
    }

    public i32 last_y() {
        return this.last_y;
    }

    public Board genmove(Board board, i32 color) {
        Board b2 = board;
        debug_log_i32(1, "L1", "genmove color", color);   // rebind: params immutable, locals are mut
        i32 opp = b2.opponent(color);
        i32[169] capture_moves = {0};
        i32 n_cap = 0;
        i32[169] defend_moves = {0};
        i32 n_def = 0;
        i32[169] empty_moves = {0};
        i32 n_empty = 0;
        i32[4] dxs = {0, 0, 1, -1};
        i32[4] dys = {1, -1, 0, 0};
        // Save full board state for restoration after virtual placement
        i32[13][13] saved_grid = {0};
        for (i32 i = 0; i < 13; i++) {
            for (i32 j = 0; j < 13; j++) {
                saved_grid[i][j] = b2.get(i, j);
            }
        }
        // Step 1: detect own groups in atari (1 liberty)
        bool has_atari = false;
        for (i32 x = 0; x < 13; x++) {
            for (i32 y = 0; y < 13; y++) {
                if (b2.get(x, y) == color) {
                    if (b2.count_liberties(x, y) == 1) {
                        has_atari = true;
                        debug_log_i32(1, "L1", "atari group at", x * 13 + y);
                    }
                }
            }
        }
        debug_log_i32(1, "L1", "has_atari", has_atari as i32);
        for (i32 x = 0; x < 13; x++) {
            for (i32 y = 0; y < 13; y++) {
                if (b2.get(x, y) == 0) {
                    bool is_ko = b2.is_ko_point(x, y);
                    // try the placement virtually
                    b2.set(x, y, color);
                    bool captures = false;
                    bool defends = false;
                    for (i32 d = 0; d < 4; d++) {
                        i32 nx = x + dxs[d];
                        i32 ny = y + dys[d];
                        if (b2.is_valid(nx, ny)) {
                            if (b2.get(nx, ny) == opp) {
                                if (b2.count_liberties(nx, ny) == 0) {
                                    captures = true;
                                }
                            }
                        }
                    }
                    bool alive = b2.count_liberties(x, y) > 0;
                    // Check if this move defends an atari group
                    if (has_atari && alive) {
                        // Check if any neighboring own group WAS in atari (1 liberty) before this move
                        // and now has more liberties (because we placed a stone adjacent to it)
                        for (i32 d = 0; d < 4; d++) {
                            i32 nx = x + dxs[d];
                            i32 ny = y + dys[d];
                            if (b2.is_valid(nx, ny)) {
                                if (b2.get(nx, ny) == color) {
                                    // This move connects to an own group
                                    // Check if it increases liberties from atari
                                    // First check: was this group in atari before our move?
                                    // We know has_atari is true, so some group is in atari
                                    // Check if this specific group now has > 1 liberty
                                    // and would have had 1 liberty without our move
                                    if (b2.count_liberties(nx, ny) > 1) {
                                        // Temporarily remove our stone to check original liberty count
                                        b2.set(x, y, 0);
                                        i32 orig_libs = b2.count_liberties(nx, ny);
                                        b2.set(x, y, color);
                                        if (orig_libs == 1) {
                                            defends = true;
                                        }
                                    }
                                }
                            }
                        }
                    }
                    // Restore full board state (including captured stones)
                    for (i32 i = 0; i < 13; i++) {
                        for (i32 j = 0; j < 13; j++) {
                            b2.set(i, j, saved_grid[i][j]);
                        }
                    }
                    if (captures || alive) {
                        i32 enc = x * 13 + y;
                        // Level 1: beginners prefer playing near existing stones
                        bool near_stone = false;
                        for (i32 d = 0; d < 4; d++) {
                            i32 nx2 = x + dxs[d];
                            i32 ny2 = y + dys[d];
                            if (b2.is_valid(nx2, ny2)) {
                                if (b2.get(nx2, ny2) != 0) {
                                    near_stone = true;
                                }
                            }
                        }
                        if (near_stone) {
                            empty_moves[n_empty] = enc;
                            n_empty = n_empty + 1;
                        }
                        if (captures) {
                            if (!is_ko) {
                                capture_moves[n_cap] = enc;
                                n_cap = n_cap + 1;
                            }
                        }
                        if (defends) {
                            defend_moves[n_def] = enc;
                            n_def = n_def + 1;
                        }
                    }
                }
            }
        }
        debug_log_i32(1, "L1", "n_cap", n_cap);
        debug_log_i32(1, "L1", "n_def", n_def);
        debug_log_i32(1, "L1", "n_empty", n_empty);
        i32 mv = -1;
        if (n_cap > 0) {
            mv = capture_moves[b2.rand_below(n_cap)];
        } else if (n_def > 0) {
            // Priority 2: defend atari groups
            mv = defend_moves[b2.rand_below(n_def)];
            debug_log_i32(1, "L1", "defending", mv);
        } else if (n_empty > 0) {
            mv = empty_moves[b2.rand_below(n_empty)];
        }
        if (mv < 0) {
            // no legal point at all (not a pass): Wood rules forbid passing,
            // this state is theoretically unreachable on a 13x13 board
            this.last_x = -1;
            this.last_y = -1;
            return b2;
        }
        i32 mx = mv / 13;
        i32 my = mv - mx * 13;
        i32 r = b2.place_stone(mx, my, color);
        if (r >= 0) {
            this.last_x = mx;
            this.last_y = my;
        } else {
            // defensive: candidates are pre-checked, should not happen
            this.last_x = -1;
            this.last_y = -1;
        }
        return b2;
    }
}

// AIWrapper: unified AI interface (Hust V0.2.1 fix)
// Replaces interface-typed returns (MoveGenerator) which are not supported.
// Creates new AI instance per call (simple, avoids mut this issues).
public class AIWrapper {
    i32 level;
    i32 last_x;
    i32 last_y;
    
    public AIWrapper(i32 lvl) {
        this.level = lvl;
        this.last_x = -1;
        this.last_y = -1;
    }
    
    public Board genmove(Board board, i32 color) {
        if (this.level == 1) {
            Level1 ai = new Level1();
            Board result = ai.genmove(board, color);
            this.last_x = ai.last_x();
            this.last_y = ai.last_y();
            debug_log_i32(1, "AI", "last_x", this.last_x);
            debug_log_i32(1, "AI", "last_y", this.last_y);
            return result;
        } else if (this.level == 2) {
            Level2 ai = new Level2();
            Board result = ai.genmove(board, color);
            this.last_x = ai.last_x();
            this.last_y = ai.last_y();
            debug_log_i32(1, "AI", "last_x", this.last_x);
            debug_log_i32(1, "AI", "last_y", this.last_y);
            return result;
        } else if (this.level == 3) {
            Level3 ai = new Level3();
            Board result = ai.genmove(board, color);
            this.last_x = ai.last_x();
            this.last_y = ai.last_y();
            debug_log_i32(1, "AI", "last_x", this.last_x);
            debug_log_i32(1, "AI", "last_y", this.last_y);
            return result;
        } else if (this.level == 4) {
            Level4 ai = new Level4();
            Board result = ai.genmove(board, color);
            this.last_x = ai.last_x();
            this.last_y = ai.last_y();
            debug_log_i32(1, "AI", "last_x", this.last_x);
            debug_log_i32(1, "AI", "last_y", this.last_y);
            return result;
        } else if (this.level == 5) {
            Level5 ai = new Level5();
            Board result = ai.genmove(board, color);
            this.last_x = ai.last_x();
            this.last_y = ai.last_y();
            debug_log_i32(1, "AI", "last_x", this.last_x);
            debug_log_i32(1, "AI", "last_y", this.last_y);
            return result;
        } else if (this.level == 6) {
            Level6 ai = new Level6();
            Board result = ai.genmove(board, color);
            this.last_x = ai.last_x();
            this.last_y = ai.last_y();
            debug_log_i32(1, "AI", "last_x", this.last_x);
            debug_log_i32(1, "AI", "last_y", this.last_y);
            return result;
        } else if (this.level == 7) {
            Level7 ai = new Level7();
            Board result = ai.genmove(board, color);
            this.last_x = ai.last_x();
            this.last_y = ai.last_y();
            debug_log_i32(1, "AI", "last_x", this.last_x);
            debug_log_i32(1, "AI", "last_y", this.last_y);
            return result;
        } else if (this.level == 8) {
            Level8 ai = new Level8();
            Board result = ai.genmove(board, color);
            this.last_x = ai.last_x();
            this.last_y = ai.last_y();
            debug_log_i32(1, "AI", "last_x", this.last_x);
            debug_log_i32(1, "AI", "last_y", this.last_y);
            return result;
        } else if (this.level == 9) {
            Level9 ai = new Level9();
            Board result = ai.genmove(board, color);
            this.last_x = ai.last_x();
            this.last_y = ai.last_y();
            debug_log_i32(1, "AI", "last_x", this.last_x);
            debug_log_i32(1, "AI", "last_y", this.last_y);
            return result;
        } else {
            Level10 ai = new Level10();
            Board result = ai.genmove(board, color);
            this.last_x = ai.last_x();
            this.last_y = ai.last_y();
            debug_log_i32(1, "AI", "last_x", this.last_x);
            debug_log_i32(1, "AI", "last_y", this.last_y);
            return result;
        }
    }
    
    public i32 last_x() {
        return this.last_x;
    }
    
    public i32 last_y() {
        return this.last_y;
    }
}

// Factory: create AI wrapper for requested level (clamped to 1-10)
public AIWrapper create_ai(i32 requested_level) {
    i32 lvl = requested_level;
    if (lvl < 1) { lvl = 1; }
    if (lvl > 10) { lvl = 10; }
    return new AIWrapper(lvl);
}

// Level 2: like Level1 but prefers the move capturing the MOST stones
// (deterministic; no randomness). Ties broken by first found.
public class Level2 implements MoveGenerator {
    i32 last_x;
    i32 last_y;

    public Level2() {
        this.last_x = -1;
        this.last_y = -1;
    }

    public i32 last_x() {
        return this.last_x;
    }

    public i32 last_y() {
        return this.last_y;
    }

    public Board genmove(Board board, i32 color) {
        Board b2 = board;
        debug_log_i32(1, "L2", "genmove color", color);
        i32 opp = b2.opponent(color);
        i32 best_enc = -1;
        i32 best_captures = -1;
        i32[4] dxs = {0, 0, 1, -1};
        i32[4] dys = {1, -1, 0, 0};
        i32[13][13] saved_grid = {0};
        for (i32 i = 0; i < 13; i++) {
            for (i32 j = 0; j < 13; j++) {
                saved_grid[i][j] = b2.get(i, j);
            }
        }
        for (i32 x = 0; x < 13; x++) {
            for (i32 y = 0; y < 13; y++) {
                if (b2.get(x, y) == 0) {
                    bool is_ko = b2.is_ko_point(x, y);
                    b2.set(x, y, color);
                    i32 cap = 0;
                    for (i32 d = 0; d < 4; d++) {
                        i32 nx = x + dxs[d];
                        i32 ny = y + dys[d];
                        if (b2.is_valid(nx, ny)) {
                            if (b2.get(nx, ny) == opp) {
                                if (b2.count_liberties(nx, ny) == 0) {
                                    cap = cap + b2.remove_group(nx, ny);
                                }
                            }
                        }
                    }
                    bool alive = b2.count_liberties(x, y) > 0;
                    for (i32 i = 0; i < 13; i++) {
                        for (i32 j = 0; j < 13; j++) {
                            b2.set(i, j, saved_grid[i][j]);
                        }
                    }
                    if (alive && !(is_ko && cap == 1)) {
                        if (cap > best_captures) {
                            best_captures = cap;
                            best_enc = x * 13 + y;
                        }
                    }
                }
            }
        }
        if (best_enc < 0) {
            this.last_x = -1;
            this.last_y = -1;
            return b2;
        }
        i32 mx = best_enc / 13;
        i32 my = best_enc - mx * 13;
        i32 r = b2.place_stone(mx, my, color);
        if (r >= 0) {
            this.last_x = mx;
            this.last_y = my;
        } else {
            this.last_x = -1;
            this.last_y = -1;
        }
        return b2;
    }
}

// Level 3: heuristic greedy - capture bonus, atari pressure, liberties,
// adjacency, center preference. Single ply, best score wins (ties: first).
public class Level3 implements MoveGenerator {
    i32 last_x;
    i32 last_y;

    public Level3() {
        this.last_x = -1;
        this.last_y = -1;
    }

    public i32 last_x() {
        return this.last_x;
    }

    public i32 last_y() {
        return this.last_y;
    }

    public Board genmove(Board board, i32 color) {
        Board b2 = board;
        debug_log_i32(1, "L3", "genmove color", color);
        i32 opp = b2.opponent(color);
        i32 best_enc = -1;
        i32 best_score = -1000000;
        i32[4] dxs = {0, 0, 1, -1};
        i32[4] dys = {1, -1, 0, 0};
        // Save full board state for restoration after virtual placement
        i32[13][13] saved_grid = {0};
        for (i32 i = 0; i < 13; i++) {
            for (i32 j = 0; j < 13; j++) {
                saved_grid[i][j] = b2.get(i, j);
            }
        }
        for (i32 x = 0; x < 13; x++) {
            for (i32 y = 0; y < 13; y++) {
                if (b2.get(x, y) == 0) {
                    bool is_ko = b2.is_ko_point(x, y);
                    // virtual placement
                    b2.set(x, y, color);
                    i32 cap = 0;
                    i32 atari = 0;
                    for (i32 d = 0; d < 4; d++) {
                        i32 nx = x + dxs[d];
                        i32 ny = y + dys[d];
                        if (b2.is_valid(nx, ny)) {
                            if (b2.get(nx, ny) == opp) {
                                i32 l = b2.count_liberties(nx, ny);
                                if (l == 0) {
                                    cap = cap + 1;
                                } else if (l == 1) {
                                    atari = atari + 1;
                                }
                            }
                        }
                    }
                    bool alive = b2.count_liberties(x, y) > 0;
                    i32 self_libs = b2.count_liberties(x, y);
                    // Restore full board state (including captured stones)
                    for (i32 i = 0; i < 13; i++) {
                        for (i32 j = 0; j < 13; j++) {
                            b2.set(i, j, saved_grid[i][j]);
                        }
                    }
                    // legality filter
                    bool legal = true;
                    if (!alive && cap == 0) {
                        legal = false;
                    }
                    if (is_ko && cap == 1) {
                        legal = false;
                    }
                    if (legal) {
                        i32 score = cap * 1000 + atari * 60 + self_libs * 8;
                        i32 neighbors = 0;
                        for (i32 d = 0; d < 4; d++) {
                            i32 nx = x + dxs[d];
                            i32 ny = y + dys[d];
                            if (b2.is_valid(nx, ny)) {
                                if (b2.get(nx, ny) != 0) {
                                    neighbors = neighbors + 1;
                                }
                            }
                        }
                        score = score + neighbors * 4;
                        i32 dist = x - 6;
                        if (dist < 0) {
                            dist = -dist;
                        }
                        i32 dy2 = y - 6;
                        if (dy2 < 0) {
                            dy2 = -dy2;
                        }
                        score = score + (12 - dist - dy2) * 2;
                        if (score > best_score) {
                            best_score = score;
                            best_enc = x * 13 + y;
                        }
                    }
                }
            }
        }
        if (best_enc < 0) {
            this.last_x = -1;
            this.last_y = -1;
            return b2;
        }
        i32 mx = best_enc / 13;
        i32 my = best_enc - mx * 13;
        i32 r = b2.place_stone(mx, my, color);
        if (r >= 0) {
            this.last_x = mx;
            this.last_y = my;
        } else {
            this.last_x = -1;
            this.last_y = -1;
        }
        return b2;
    }
}

// Level 4: heuristic greedy + shallow search (depth-1) on top candidates.
// Scores all points with Level3 heuristic, then does depth-1 minimax on
// the top 5 candidates to break ties / avoid blunders.
public class Level4 implements MoveGenerator {
    i32 last_x;
    i32 last_y;

    public Level4() {
        this.last_x = -1;
        this.last_y = -1;
    }

    public i32 last_x() {
        return this.last_x;
    }

    public i32 last_y() {
        return this.last_y;
    }

    public Board genmove(Board board, i32 color) {
        Board b2 = board;
        debug_log_i32(1, "L4", "genmove color", color);
        i32 opp = b2.opponent(color);
        i32 best_enc = -1;
        i32 best_score = -1000000;
        i32[4] dxs = {0, 0, 1, -1};
        i32[4] dys = {1, -1, 0, 0};
        i32[13][13] saved_grid = {0};
        for (i32 i = 0; i < 13; i++) {
            for (i32 j = 0; j < 13; j++) {
                saved_grid[i][j] = b2.get(i, j);
            }
        }
        // Pass 1: heuristic scoring (same as Level3)
        i32[169] cand_enc = {0};
        i32[169] cand_score = {0};
        i32 n_cand = 0;
        for (i32 x = 0; x < 13; x++) {
            for (i32 y = 0; y < 13; y++) {
                if (b2.get(x, y) == 0) {
                    bool is_ko = b2.is_ko_point(x, y);
                    b2.set(x, y, color);
                    i32 cap = 0;
                    i32 atari = 0;
                    for (i32 d = 0; d < 4; d++) {
                        i32 nx = x + dxs[d];
                        i32 ny = y + dys[d];
                        if (b2.is_valid(nx, ny)) {
                            if (b2.get(nx, ny) == opp) {
                                i32 l = b2.count_liberties(nx, ny);
                                if (l == 0) {
                                    cap = cap + 1;
                                } else if (l == 1) {
                                    atari = atari + 1;
                                }
                            }
                        }
                    }
                    bool alive = b2.count_liberties(x, y) > 0;
                    i32 self_libs = b2.count_liberties(x, y);
                    for (i32 i = 0; i < 13; i++) {
                        for (i32 j = 0; j < 13; j++) {
                            b2.set(i, j, saved_grid[i][j]);
                        }
                    }
                    bool legal = true;
                    if (!alive && cap == 0) {
                        legal = false;
                    }
                    if (is_ko && cap == 1) {
                        legal = false;
                    }
                    if (legal) {
                        i32 score = cap * 1000 + atari * 60 + self_libs * 8;
                        i32 neighbors = 0;
                        for (i32 d = 0; d < 4; d++) {
                            i32 nx = x + dxs[d];
                            i32 ny = y + dys[d];
                            if (b2.is_valid(nx, ny)) {
                                if (b2.get(nx, ny) != 0) {
                                    neighbors = neighbors + 1;
                                }
                            }
                        }
                        score = score + neighbors * 4;
                        i32 dist = x - 6;
                        if (dist < 0) {
                            dist = -dist;
                        }
                        i32 dy2 = y - 6;
                        if (dy2 < 0) {
                            dy2 = -dy2;
                        }
                        score = score + (12 - dist - dy2) * 2;
                        cand_enc[n_cand] = x * 13 + y;
                        cand_score[n_cand] = score;
                        n_cand = n_cand + 1;
                    }
                }
            }
        }
        if (n_cand == 0) {
            this.last_x = -1;
            this.last_y = -1;
            return b2;
        }
        // Pass 2: pick top 5 by score, do depth-1 search
        i32[5] top_enc = {-1, -1, -1, -1, -1};
        i32[5] top_score = {-1000000, -1000000, -1000000, -1000000, -1000000};
        for (i32 i = 0; i < n_cand; i++) {
            i32 s = cand_score[i];
            i32 e = cand_enc[i];
            for (i32 k = 0; k < 5; k++) {
                if (s > top_score[k]) {
                    for (i32 m = 4; m > k; m--) {
                        top_score[m] = top_score[m - 1];
                        top_enc[m] = top_enc[m - 1];
                    }
                    top_score[k] = s;
                    top_enc[k] = e;
                    break;
                }
            }
        }
        b2.start_search(50000);
        i32 best_val = -999999;
        for (i32 k = 0; k < 5; k++) {
            if (top_enc[k] < 0) {
                break;
            }
            i32 cx = top_enc[k] / 13;
            i32 cy = top_enc[k] - cx * 13;
            i32[13][13] snap = {0};
            for (i32 i = 0; i < 13; i++) {
                for (i32 j = 0; j < 13; j++) {
                    snap[i][j] = b2.get(i, j);
                }
            }
            b2.set(cx, cy, color);
            for (i32 d = 0; d < 4; d++) {
                i32 nx = cx + dxs[d];
                i32 ny = cy + dys[d];
                if (b2.is_valid(nx, ny)) {
                    if (b2.get(nx, ny) == opp) {
                        if (b2.count_liberties(nx, ny) == 0) {
                            b2.remove_group(nx, ny);
                        }
                    }
                }
            }
            i32 val = b2.minimax(0, opp, color, -999999, 999999);
            for (i32 i = 0; i < 13; i++) {
                for (i32 j = 0; j < 13; j++) {
                    b2.set(i, j, snap[i][j]);
                }
            }
            if (val > best_val) {
                best_val = val;
                best_enc = top_enc[k];
            }
        }
        if (best_enc < 0) {
            best_enc = cand_enc[0];
        }
        i32 mx = best_enc / 13;
        i32 my = best_enc - mx * 13;
        i32 r = b2.place_stone(mx, my, color);
        if (r >= 0) {
            this.last_x = mx;
            this.last_y = my;
        } else {
            this.last_x = -1;
            this.last_y = -1;
        }
        return b2;
    }
}

// Level 5: alpha-beta search (root + 2-ply minimax on the Board).
// Root candidates: every legal empty point (virtual check, suicide and
// ko excluded). For each, snapshot -> place + real removal of captured
// groups -> minimax(depth 2) -> restore. Best value wins.
public class Level5 implements MoveGenerator {
    i32 last_x;
    i32 last_y;

    public Level5() {
        this.last_x = -1;
        this.last_y = -1;
    }

    public i32 last_x() {
        return this.last_x;
    }

    public i32 last_y() {
        return this.last_y;
    }

    public Board genmove(Board board, i32 color) {
        Board b2 = board;
        debug_log_i32(1, "L5", "genmove color", color);
        i32 opp = b2.opponent(color);
        i32 best_enc = -1;
        i32 best_val = -999999;
        i32[4] dxs = {0, 0, 1, -1};
        i32[4] dys = {1, -1, 0, 0};
        
        // Atari rescue: check if our group is in atari and find rescue moves
        i32[6] gres = b2.analyze_groups(color);
        i32 my_gval = gres[0];
        i32 opp_gval = gres[1];
        i32 my_atari_cnt = gres[2];
        i32 opp_atari_cnt = gres[3];
        i32 my_atari_max = gres[4];
        i32 opp_atari_max = gres[5];
        
        if (my_atari_cnt > 0) {
            debug_log_i32(1, "L5", "atari detected, max_size", my_atari_max);
            // Try to find rescue moves for atari groups
            // A rescue move either: captures the attacking stones, or extends liberties
            for (i32 x = 0; x < 13; x++) {
                for (i32 y = 0; y < 13; y++) {
                    if (b2.get(x, y) == 0) {
                        // Check if this move rescues an atari group
                        bool is_rescue = false;
                        // Try placing here and see if any atari group gains liberties
                        i32[13][13] snap = {0};
                        for (i32 i = 0; i < 13; i++) {
                            for (i32 j = 0; j < 13; j++) {
                                snap[i][j] = b2.get(i, j);
                            }
                        }
                        b2.set(x, y, color);
                        // Check if any neighboring friendly group was in atari and now has >1 liberty
                        for (i32 d = 0; d < 4; d++) {
                            i32 nx = x + dxs[d];
                            i32 ny = y + dys[d];
                            if (b2.is_valid(nx, ny) && b2.get(nx, ny) == color) {
                                i32 libs = b2.count_liberties(nx, ny);
                                if (libs > 1) {
                                    // This group might have been in atari
                                    // Check if it was in atari before by checking snapshot
                                    // Simple heuristic: if this group is connected to our stones and now has >1 lib
                                    is_rescue = true;
                                }
                            }
                        }
                        // Also check if this captures enemy stones that were attacking
                        i32 cap = 0;
                        for (i32 d = 0; d < 4; d++) {
                            i32 nx = x + dxs[d];
                            i32 ny = y + dys[d];
                            if (b2.is_valid(nx, ny) && b2.get(nx, ny) == opp) {
                                if (b2.count_liberties(nx, ny) == 0) {
                                    cap = cap + b2.remove_group(nx, ny);
                                    is_rescue = true;
                                }
                            }
                        }
                        // Restore
                        for (i32 i = 0; i < 13; i++) {
                            for (i32 j = 0; j < 13; j++) {
                                b2.set(i, j, snap[i][j]);
                            }
                        }
                        
                        if (is_rescue) {
                            debug_log_i32_2(1, "L5", "rescue_x", x, "rescue_y", y);
                            // Evaluate this rescue move with minimax
                            b2.set(x, y, color);
                            for (i32 d = 0; d < 4; d++) {
                                i32 nx = x + dxs[d];
                                i32 ny = y + dys[d];
                                if (b2.is_valid(nx, ny) && b2.get(nx, ny) == opp) {
                                    if (b2.count_liberties(nx, ny) == 0) {
                                        b2.remove_group(nx, ny);
                                    }
                                }
                            }
                            i32 val = b2.minimax(2, opp, color, -999999, 999999);
                            for (i32 i = 0; i < 13; i++) {
                                for (i32 j = 0; j < 13; j++) {
                                    b2.set(i, j, snap[i][j]);
                                }
                            }
                            debug_log_i32(1, "L5", "rescue_val", val);
                            if (val > best_val) {
                                best_val = val;
                                best_enc = x * 13 + y;
                            }
                        }
                    }
                }
            }
            // If we found a rescue move, try them in order of best value
            if (best_enc >= 0) {
                debug_log_i32(1, "L5", "trying rescue move", best_enc);
                i32 mx = best_enc / 13;
                i32 my = best_enc - mx * 13;
                i32 r = b2.place_stone(mx, my, color);
                if (r >= 0) {
                    debug_log_i32_2(1, "L5", "rescue_ok_x", mx, "rescue_ok_y", my);
                    this.last_x = mx;
                    this.last_y = my;
                    return b2;
                } else {
                    debug_log_i32(1, "L5", "rescue failed, trying others", r);
                    // Try other rescue moves
                    for (i32 x = 0; x < 13; x++) {
                        for (i32 y = 0; y < 13; y++) {
                            if (b2.get(x, y) == 0) {
                                // Quick check if this is a rescue move
                                bool is_rescue = false;
                                i32[13][13] snap2 = {0};
                                for (i32 i = 0; i < 13; i++) {
                                    for (i32 j = 0; j < 13; j++) {
                                        snap2[i][j] = b2.get(i, j);
                                    }
                                }
                                b2.set(x, y, color);
                                for (i32 d = 0; d < 4; d++) {
                                    i32 nx = x + dxs[d];
                                    i32 ny = y + dys[d];
                                    if (b2.is_valid(nx, ny) && b2.get(nx, ny) == color) {
                                        if (b2.count_liberties(nx, ny) > 1) {
                                            is_rescue = true;
                                        }
                                    }
                                }
                                for (i32 i = 0; i < 13; i++) {
                                    for (i32 j = 0; j < 13; j++) {
                                        b2.set(i, j, snap2[i][j]);
                                    }
                                }
                                if (is_rescue) {
                                    r = b2.place_stone(x, y, color);
                                    if (r >= 0) {
                                        debug_log_i32_2(1, "L5", "fallback_rescue_x", x, "fallback_rescue_y", y);
                                        this.last_x = x;
                                        this.last_y = y;
                                        return b2;
                                    }
                                }
                            }
                        }
                    }
                    // No rescue worked, return -1
                    this.last_x = -1;
                    this.last_y = -1;
                    return b2;
                }
            }
        }
        
        // Normal search if no atari rescue found
        for (i32 x = 0; x < 13; x++) {
            for (i32 y = 0; y < 13; y++) {
                if (b2.get(x, y) == 0) {
                    bool is_ko = b2.is_ko_point(x, y);
                    // snapshot before this root candidate
                    i32[13][13] snap = {0};
                    for (i32 i = 0; i < 13; i++) {
                        for (i32 j = 0; j < 13; j++) {
                            snap[i][j] = b2.get(i, j);
                        }
                    }
                    b2.set(x, y, color);
                    i32 cap = 0;
                    for (i32 d = 0; d < 4; d++) {
                        i32 nx = x + dxs[d];
                        i32 ny = y + dys[d];
                        if (b2.is_valid(nx, ny)) {
                            if (b2.get(nx, ny) == opp) {
                                if (b2.count_liberties(nx, ny) == 0) {
                                    cap = cap + b2.remove_group(nx, ny);
                                }
                            }
                        }
                    }
                    bool alive = b2.count_liberties(x, y) > 0;
                    i32 val = -999999;
                    if (alive && !(is_ko && cap == 1)) {
                        val = b2.minimax(2, opp, color, -999999, 999999);
                    }
                    for (i32 i = 0; i < 13; i++) {
                        for (i32 j = 0; j < 13; j++) {
                            b2.set(i, j, snap[i][j]);
                        }
                    }
                    if (val > best_val) {
                        best_val = val;
                        best_enc = x * 13 + y;
                    } else if (val == best_val && val > -999999) {
                        // Random tie-breaking: equal value, randomly switch
                        if (b2.rand_below(2) == 0) {
                            best_enc = x * 13 + y;
                        }
                    }
                }
            }
        }
        if (best_enc < 0) {
            debug_log(1, "L5", "ERROR: no legal move found!");
            debug_log_i32(1, "L5", "color", color);
            b2.print_board();
            i32 legal = 0;
            for (i32 lx = 0; lx < 13; lx++) {
                for (i32 ly = 0; ly < 13; ly++) {
                    if (b2.get(lx, ly) == 0) {
                        legal = legal + 1;
                    }
                }
            }
            debug_log_i32(1, "L5", "empty_points", legal);
            this.last_x = -1;
            this.last_y = -1;
            return b2;
        }
        i32 mx = best_enc / 13;
        i32 my = best_enc - mx * 13;
        i32 r = b2.place_stone(mx, my, color);
        if (r >= 0) {
            this.last_x = mx;
            this.last_y = my;
        } else {
            this.last_x = -1;
            this.last_y = -1;
        }
        return b2;
    }
}

// Level 6: alpha-beta search depth-3 (one ply deeper than Level5).
public class Level6 implements MoveGenerator {
    i32 last_x;
    i32 last_y;

    public Level6() {
        this.last_x = -1;
        this.last_y = -1;
    }

    public i32 last_x() {
        return this.last_x;
    }

    public i32 last_y() {
        return this.last_y;
    }

    public Board genmove(Board board, i32 color) {
        Board b2 = board;
        debug_log_i32(1, "L6", "genmove color", color);
        i32 opp = b2.opponent(color);
        i32 best_enc = -1;
        i32 best_val = -999999;
        i32[4] dxs = {0, 0, 1, -1};
        i32[4] dys = {1, -1, 0, 0};
        b2.start_search(400000);
        for (i32 x = 0; x < 13; x++) {
            for (i32 y = 0; y < 13; y++) {
                if (b2.get(x, y) == 0) {
                    bool is_ko = b2.is_ko_point(x, y);
                    i32[13][13] snap = {0};
                    for (i32 i = 0; i < 13; i++) {
                        for (i32 j = 0; j < 13; j++) {
                            snap[i][j] = b2.get(i, j);
                        }
                    }
                    b2.set(x, y, color);
                    i32 cap = 0;
                    for (i32 d = 0; d < 4; d++) {
                        i32 nx = x + dxs[d];
                        i32 ny = y + dys[d];
                        if (b2.is_valid(nx, ny)) {
                            if (b2.get(nx, ny) == opp) {
                                if (b2.count_liberties(nx, ny) == 0) {
                                    cap = cap + b2.remove_group(nx, ny);
                                }
                            }
                        }
                    }
                    bool alive = b2.count_liberties(x, y) > 0;
                    i32 val = -999999;
                    if (alive && !(is_ko && cap == 1)) {
                        val = b2.minimax(3, opp, color, -999999, 999999);
                    }
                    for (i32 i = 0; i < 13; i++) {
                        for (i32 j = 0; j < 13; j++) {
                            b2.set(i, j, snap[i][j]);
                        }
                    }
                    if (val > best_val) {
                        best_val = val;
                        best_enc = x * 13 + y;
                    }
                }
            }
        }
        if (best_enc < 0) {
            this.last_x = -1;
            this.last_y = -1;
            return b2;
        }
        i32 mx = best_enc / 13;
        i32 my = best_enc - mx * 13;
        i32 r = b2.place_stone(mx, my, color);
        if (r >= 0) {
            this.last_x = mx;
            this.last_y = my;
        } else {
            this.last_x = -1;
            this.last_y = -1;
        }
        return b2;
    }
}

// Level 7: iterative deepening (depth 2..5) + node budget.
// Wood Capture Go forbids passing: the engine always returns a real move.
// Level7 returns -1 only when there is genuinely no legal point
// (theoretically unreachable on a 13x13 board).
public class Level7 implements MoveGenerator {
    i32 last_x;
    i32 last_y;

    public Level7() {
        this.last_x = -1;
        this.last_y = -1;
    }

    public i32 last_x() {
        return this.last_x;
    }

    public i32 last_y() {
        return this.last_y;
    }

    public Board genmove(Board board, i32 color) {
        Board b2 = board;
        debug_log_i32(1, "L7", "genmove color", color);
        i32 opp = b2.opponent(color);
        i32[4] dxs = {0, 0, 1, -1};
        i32[4] dys = {1, -1, 0, 0};
        // iterative deepening: 2..5 ply
        i32 best_enc = -1;
        for (i32 dd = 2; dd <= 5; dd++) {
            best_enc = -1;
            i32 best_val = -999999;
            b2.start_search(300000);
            for (i32 x = 0; x < 13; x++) {
                for (i32 y = 0; y < 13; y++) {
                    if (b2.get(x, y) == 0) {
                        bool is_ko = b2.is_ko_point(x, y);
                        i32[13][13] snap = {0};
                        for (i32 i = 0; i < 13; i++) {
                            for (i32 j = 0; j < 13; j++) {
                                snap[i][j] = b2.get(i, j);
                            }
                        }
                        b2.set(x, y, color);
                        i32 cap = 0;
                        for (i32 d = 0; d < 4; d++) {
                            i32 nx = x + dxs[d];
                            i32 ny = y + dys[d];
                            if (b2.is_valid(nx, ny)) {
                                if (b2.get(nx, ny) == opp) {
                                    if (b2.count_liberties(nx, ny) == 0) {
                                        cap = cap + b2.remove_group(nx, ny);
                                    }
                                }
                            }
                        }
                        bool alive = b2.count_liberties(x, y) > 0;
                        i32 val = -999999;
                        if (alive && !(is_ko && cap == 1)) {
                            val = b2.minimax(dd - 1, opp, color, -999999, 999999);
                        }
                        for (i32 i = 0; i < 13; i++) {
                            for (i32 j = 0; j < 13; j++) {
                                b2.set(i, j, snap[i][j]);
                            }
                        }
                        if (val > best_val) {
                            best_val = val;
                            best_enc = x * 13 + y;
                        }
                    }
                }
            }
            if (b2.search_nodes > b2.search_budget) {
                break;
            }
        }
        if (best_enc < 0) {
            this.last_x = -1;
            this.last_y = -1;
            return b2;
        }
        i32 mx = best_enc / 13;
        i32 my = best_enc - mx * 13;
        i32 r = b2.place_stone(mx, my, color);
        if (r >= 0) {
            this.last_x = mx;
            this.last_y = my;
        } else {
            this.last_x = -1;
            this.last_y = -1;
        }
        return b2;
    }
}

