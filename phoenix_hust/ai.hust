// ai.hust - AI strategy layer (shape-interface pattern, r44)
//
// Declaration: no types (shape). Implementation: types filled in.
// Ownership round-trip: the board moves INTO genmove, the AI places
// its stone, and the board moves BACK to the caller
// (`b = l1.genmove(b, color);` - verified in io_probe v7b).
// Level1 records the move it made; the caller reads last_x/last_y
// to build the GTP response.

use board;

interface MoveGenerator {
    public newBoard genmove(board, color);
}

public class Level1 implements MoveGenerator {
    i32 last_x;
    i32 last_y;

    public Level1() {
        this.last_x = -1;
        this.last_y = -1;
    }

    // The move made by the last genmove call (-1 = no legal point; never a pass)
    public i32 last_x() {
        return this.last_x;
    }

    public i32 last_y() {
        return this.last_y;
    }

    public Board genmove(Board board, i32 color) {
        Board b2 = board;   // rebind: params immutable, locals are mut
        i32 opp = b2.opponent(color);
        i32[169] capture_moves = {0};
        i32 n_cap = 0;
        i32[169] empty_moves = {0};
        i32 n_empty = 0;
        i32[4] dxs = {0, 0, 1, -1};
        i32[4] dys = {1, -1, 0, 0};
        // Save full board state for restoration after virtual placement
        i32[13][13] saved_grid = {0};
        for (i32 i = 0; i < 13; i++) {
            for (i32 j = 0; j < 13; j++) {
                saved_grid[i][j] = b2.get(i, j);
            }
        }
        for (i32 x = 0; x < 13; x++) {
            for (i32 y = 0; y < 13; y++) {
                if (b2.get(x, y) == 0) {
                    bool is_ko = b2.is_ko_point(x, y);
                    // try the placement virtually
                    b2.set(x, y, color);
                    bool captures = false;
                    for (i32 d = 0; d < 4; d++) {
                        i32 nx = x + dxs[d];
                        i32 ny = y + dys[d];
                        if (b2.is_valid(nx, ny)) {
                            if (b2.get(nx, ny) == opp) {
                                if (b2.count_liberties(nx, ny) == 0) {
                                    captures = true;
                                }
                            }
                        }
                    }
                    bool alive = b2.count_liberties(x, y) > 0;
                    // Restore full board state (including captured stones)
                    for (i32 i = 0; i < 13; i++) {
                        for (i32 j = 0; j < 13; j++) {
                            b2.set(i, j, saved_grid[i][j]);
                        }
                    }
                    if (captures || alive) {
                        i32 enc = x * 13 + y;
                        empty_moves[n_empty] = enc;
                        n_empty = n_empty + 1;
                        if (captures) {
                            if (!is_ko) {
                                capture_moves[n_cap] = enc;
                                n_cap = n_cap + 1;
                            }
                        }
                    }
                }
            }
        }
        i32 mv = -1;
        if (n_cap > 0) {
            mv = capture_moves[b2.rand_below(n_cap)];
        } else if (n_empty > 0) {
            mv = empty_moves[b2.rand_below(n_empty)];
        }
        if (mv < 0) {
            // no legal point at all (not a pass): Wood rules forbid passing,
            // this state is theoretically unreachable on a 13x13 board
            this.last_x = -1;
            this.last_y = -1;
            return b2;
        }
        i32 mx = mv / 13;
        i32 my = mv - mx * 13;
        i32 r = b2.place_stone(mx, my, color);
        if (r >= 0) {
            this.last_x = mx;
            this.last_y = my;
        } else {
            // defensive: candidates are pre-checked, should not happen
            this.last_x = -1;
            this.last_y = -1;
        }
        return b2;
    }
}

// AIWrapper: unified AI interface (Hust V0.2.1 fix)
// Replaces interface-typed returns (MoveGenerator) which are not supported.
// Creates new AI instance per call (simple, avoids mut this issues).
public class AIWrapper {
    i32 level;
    i32 last_x;
    i32 last_y;
    
    public AIWrapper(i32 lvl) {
        this.level = lvl;
        this.last_x = -1;
        this.last_y = -1;
    }
    
    public Board genmove(Board board, i32 color) {
        if (this.level <= 1) {
            Level1 ai = new Level1();
            Board result = ai.genmove(board, color);
            this.last_x = ai.last_x();
            this.last_y = ai.last_y();
            return result;
        } else if (this.level <= 3) {
            Level3 ai = new Level3();
            Board result = ai.genmove(board, color);
            this.last_x = ai.last_x();
            this.last_y = ai.last_y();
            return result;
        } else if (this.level <= 5) {
            Level5 ai = new Level5();
            Board result = ai.genmove(board, color);
            this.last_x = ai.last_x();
            this.last_y = ai.last_y();
            return result;
        } else if (this.level <= 7) {
            Level7 ai = new Level7();
            Board result = ai.genmove(board, color);
            this.last_x = ai.last_x();
            this.last_y = ai.last_y();
            return result;
        } else {
            Level10 ai = new Level10();
            Board result = ai.genmove(board, color);
            this.last_x = ai.last_x();
            this.last_y = ai.last_y();
            return result;
        }
    }
    
    public i32 last_x() {
        return this.last_x;
    }
    
    public i32 last_y() {
        return this.last_y;
    }
}

// Factory: create AI wrapper for requested level (clamped to 1-10)
public AIWrapper create_ai(i32 requested_level) {
    i32 lvl = requested_level;
    if (lvl < 1) { lvl = 1; }
    if (lvl > 10) { lvl = 10; }
    return new AIWrapper(lvl);
}

// Level 3: heuristic greedy - capture bonus, atari pressure, liberties,
// adjacency, center preference. Single ply, best score wins (ties: first).
public class Level3 implements MoveGenerator {
    i32 last_x;
    i32 last_y;

    public Level3() {
        this.last_x = -1;
        this.last_y = -1;
    }

    public i32 last_x() {
        return this.last_x;
    }

    public i32 last_y() {
        return this.last_y;
    }

    public Board genmove(Board board, i32 color) {
        Board b2 = board;
        i32 opp = b2.opponent(color);
        i32 best_enc = -1;
        i32 best_score = -1000000;
        i32[4] dxs = {0, 0, 1, -1};
        i32[4] dys = {1, -1, 0, 0};
        // Save full board state for restoration after virtual placement
        i32[13][13] saved_grid = {0};
        for (i32 i = 0; i < 13; i++) {
            for (i32 j = 0; j < 13; j++) {
                saved_grid[i][j] = b2.get(i, j);
            }
        }
        for (i32 x = 0; x < 13; x++) {
            for (i32 y = 0; y < 13; y++) {
                if (b2.get(x, y) == 0) {
                    bool is_ko = b2.is_ko_point(x, y);
                    // virtual placement
                    b2.set(x, y, color);
                    i32 cap = 0;
                    i32 atari = 0;
                    for (i32 d = 0; d < 4; d++) {
                        i32 nx = x + dxs[d];
                        i32 ny = y + dys[d];
                        if (b2.is_valid(nx, ny)) {
                            if (b2.get(nx, ny) == opp) {
                                i32 l = b2.count_liberties(nx, ny);
                                if (l == 0) {
                                    cap = cap + 1;
                                } else if (l == 1) {
                                    atari = atari + 1;
                                }
                            }
                        }
                    }
                    bool alive = b2.count_liberties(x, y) > 0;
                    i32 self_libs = b2.count_liberties(x, y);
                    // Restore full board state (including captured stones)
                    for (i32 i = 0; i < 13; i++) {
                        for (i32 j = 0; j < 13; j++) {
                            b2.set(i, j, saved_grid[i][j]);
                        }
                    }
                    // legality filter
                    bool legal = true;
                    if (!alive && cap == 0) {
                        legal = false;
                    }
                    if (is_ko && cap == 1) {
                        legal = false;
                    }
                    if (legal) {
                        i32 score = cap * 1000 + atari * 60 + self_libs * 8;
                        i32 neighbors = 0;
                        for (i32 d = 0; d < 4; d++) {
                            i32 nx = x + dxs[d];
                            i32 ny = y + dys[d];
                            if (b2.is_valid(nx, ny)) {
                                if (b2.get(nx, ny) != 0) {
                                    neighbors = neighbors + 1;
                                }
                            }
                        }
                        score = score + neighbors * 4;
                        i32 dist = x - 6;
                        if (dist < 0) {
                            dist = -dist;
                        }
                        i32 dy2 = y - 6;
                        if (dy2 < 0) {
                            dy2 = -dy2;
                        }
                        score = score + (12 - dist - dy2) * 2;
                        if (score > best_score) {
                            best_score = score;
                            best_enc = x * 13 + y;
                        }
                    }
                }
            }
        }
        if (best_enc < 0) {
            this.last_x = -1;
            this.last_y = -1;
            return b2;
        }
        i32 mx = best_enc / 13;
        i32 my = best_enc - mx * 13;
        i32 r = b2.place_stone(mx, my, color);
        if (r >= 0) {
            this.last_x = mx;
            this.last_y = my;
        } else {
            this.last_x = -1;
            this.last_y = -1;
        }
        return b2;
    }
}

// Level 5: alpha-beta search (root + 2-ply minimax on the Board).
// Root candidates: every legal empty point (virtual check, suicide and
// ko excluded). For each, snapshot -> place + real removal of captured
// groups -> minimax(depth 2) -> restore. Best value wins.
public class Level5 implements MoveGenerator {
    i32 last_x;
    i32 last_y;

    public Level5() {
        this.last_x = -1;
        this.last_y = -1;
    }

    public i32 last_x() {
        return this.last_x;
    }

    public i32 last_y() {
        return this.last_y;
    }

    public Board genmove(Board board, i32 color) {
        Board b2 = board;
        i32 opp = b2.opponent(color);
        i32 best_enc = -1;
        i32 best_val = -999999;
        i32[4] dxs = {0, 0, 1, -1};
        i32[4] dys = {1, -1, 0, 0};
        for (i32 x = 0; x < 13; x++) {
            for (i32 y = 0; y < 13; y++) {
                if (b2.get(x, y) == 0) {
                    bool is_ko = b2.is_ko_point(x, y);
                    // snapshot before this root candidate
                    i32[13][13] snap = {0};
                    for (i32 i = 0; i < 13; i++) {
                        for (i32 j = 0; j < 13; j++) {
                            snap[i][j] = b2.get(i, j);
                        }
                    }
                    b2.set(x, y, color);
                    i32 cap = 0;
                    for (i32 d = 0; d < 4; d++) {
                        i32 nx = x + dxs[d];
                        i32 ny = y + dys[d];
                        if (b2.is_valid(nx, ny)) {
                            if (b2.get(nx, ny) == opp) {
                                if (b2.count_liberties(nx, ny) == 0) {
                                    cap = cap + b2.remove_group(nx, ny);
                                }
                            }
                        }
                    }
                    bool alive = b2.count_liberties(x, y) > 0;
                    i32 val = -999999;
                    if (alive && !(is_ko && cap == 1)) {
                        val = b2.minimax(2, opp, color, -999999, 999999);
                    }
                    for (i32 i = 0; i < 13; i++) {
                        for (i32 j = 0; j < 13; j++) {
                            b2.set(i, j, snap[i][j]);
                        }
                    }
                    if (val > best_val) {
                        best_val = val;
                        best_enc = x * 13 + y;
                    }
                }
            }
        }
        if (best_enc < 0) {
            this.last_x = -1;
            this.last_y = -1;
            return b2;
        }
        i32 mx = best_enc / 13;
        i32 my = best_enc - mx * 13;
        i32 r = b2.place_stone(mx, my, color);
        if (r >= 0) {
            this.last_x = mx;
            this.last_y = my;
        } else {
            this.last_x = -1;
            this.last_y = -1;
        }
        return b2;
    }
}

// Level 7: iterative deepening (depth 2..5) + node budget.
// Wood Capture Go forbids passing: the engine always returns a real move.
// Level7 returns -1 only when there is genuinely no legal point
// (theoretically unreachable on a 13x13 board).
public class Level7 implements MoveGenerator {
    i32 last_x;
    i32 last_y;

    public Level7() {
        this.last_x = -1;
        this.last_y = -1;
    }

    public i32 last_x() {
        return this.last_x;
    }

    public i32 last_y() {
        return this.last_y;
    }

    public Board genmove(Board board, i32 color) {
        Board b2 = board;
        i32 opp = b2.opponent(color);
        i32[4] dxs = {0, 0, 1, -1};
        i32[4] dys = {1, -1, 0, 0};
        // iterative deepening: 2..5 ply
        i32 best_enc = -1;
        for (i32 dd = 2; dd <= 5; dd++) {
            best_enc = -1;
            i32 best_val = -999999;
            b2.start_search(300000);
            for (i32 x = 0; x < 13; x++) {
                for (i32 y = 0; y < 13; y++) {
                    if (b2.get(x, y) == 0) {
                        bool is_ko = b2.is_ko_point(x, y);
                        i32[13][13] snap = {0};
                        for (i32 i = 0; i < 13; i++) {
                            for (i32 j = 0; j < 13; j++) {
                                snap[i][j] = b2.get(i, j);
                            }
                        }
                        b2.set(x, y, color);
                        i32 cap = 0;
                        for (i32 d = 0; d < 4; d++) {
                            i32 nx = x + dxs[d];
                            i32 ny = y + dys[d];
                            if (b2.is_valid(nx, ny)) {
                                if (b2.get(nx, ny) == opp) {
                                    if (b2.count_liberties(nx, ny) == 0) {
                                        cap = cap + b2.remove_group(nx, ny);
                                    }
                                }
                            }
                        }
                        bool alive = b2.count_liberties(x, y) > 0;
                        i32 val = -999999;
                        if (alive && !(is_ko && cap == 1)) {
                            val = b2.minimax(dd - 1, opp, color, -999999, 999999);
                        }
                        for (i32 i = 0; i < 13; i++) {
                            for (i32 j = 0; j < 13; j++) {
                                b2.set(i, j, snap[i][j]);
                            }
                        }
                        if (val > best_val) {
                            best_val = val;
                            best_enc = x * 13 + y;
                        }
                    }
                }
            }
            if (b2.search_nodes > b2.search_budget) {
                break;
            }
        }
        if (best_enc < 0) {
            this.last_x = -1;
            this.last_y = -1;
            return b2;
        }
        i32 mx = best_enc / 13;
        i32 my = best_enc - mx * 13;
        i32 r = b2.place_stone(mx, my, color);
        if (r >= 0) {
            this.last_x = mx;
            this.last_y = my;
        } else {
            this.last_x = -1;
            this.last_y = -1;
        }
        return b2;
    }
}

// Level 10: same engine as Level 7 with deeper iteration (2..7) and a
// larger node budget.
public class Level10 implements MoveGenerator {
    i32 last_x;
    i32 last_y;

    public Level10() {
        this.last_x = -1;
        this.last_y = -1;
    }

    public i32 last_x() {
        return this.last_x;
    }

    public i32 last_y() {
        return this.last_y;
    }

    public Board genmove(Board board, i32 color) {
        Board b2 = board;
        i32 opp = b2.opponent(color);
        i32[4] dxs = {0, 0, 1, -1};
        i32[4] dys = {1, -1, 0, 0};
        i32 best_enc = -1;
        for (i32 dd = 2; dd <= 7; dd++) {
            best_enc = -1;
            i32 best_val = -999999;
            b2.start_search(1000000);
            for (i32 x = 0; x < 13; x++) {
                for (i32 y = 0; y < 13; y++) {
                    if (b2.get(x, y) == 0) {
                        bool is_ko = b2.is_ko_point(x, y);
                        i32[13][13] snap = {0};
                        for (i32 i = 0; i < 13; i++) {
                            for (i32 j = 0; j < 13; j++) {
                                snap[i][j] = b2.get(i, j);
                            }
                        }
                        b2.set(x, y, color);
                        i32 cap = 0;
                        for (i32 d = 0; d < 4; d++) {
                            i32 nx = x + dxs[d];
                            i32 ny = y + dys[d];
                            if (b2.is_valid(nx, ny)) {
                                if (b2.get(nx, ny) == opp) {
                                    if (b2.count_liberties(nx, ny) == 0) {
                                        cap = cap + b2.remove_group(nx, ny);
                                    }
                                }
                            }
                        }
                        bool alive = b2.count_liberties(x, y) > 0;
                        i32 val = -999999;
                        if (alive && !(is_ko && cap == 1)) {
                            val = b2.minimax(dd - 1, opp, color, -999999, 999999);
                        }
                        for (i32 i = 0; i < 13; i++) {
                            for (i32 j = 0; j < 13; j++) {
                                b2.set(i, j, snap[i][j]);
                            }
                        }
                        if (val > best_val) {
                            best_val = val;
                            best_enc = x * 13 + y;
                        }
                    }
                }
            }
            if (b2.search_nodes > b2.search_budget) {
                break;
            }
        }
        if (best_enc < 0) {
            this.last_x = -1;
            this.last_y = -1;
            return b2;
        }
        i32 mx = best_enc / 13;
        i32 my = best_enc - mx * 13;
        i32 r = b2.place_stone(mx, my, color);
        if (r >= 0) {
            this.last_x = mx;
            this.last_y = my;
        } else {
            this.last_x = -1;
            this.last_y = -1;
        }
        return b2;
    }
}
