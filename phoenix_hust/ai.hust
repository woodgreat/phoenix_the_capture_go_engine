// ai.hust - Unified AI strategy layer (2026-10-10 revision)
//
// Design: 1-10 levels = thinking depth levels
//   Level 1: greedy + random (no search)
//   Level 2-10: alpha-beta iterative deepening search
//   Depth = level, budget increases with level
//
// This replaces the old Level1/3/5/7/10 classes with a single
// parameterized Level class.

use board;

interface MoveGenerator {
    genmove(board, color);
}

// Unified Level class
public class Level implements MoveGenerator {
    i32 level;      // 1-10
    i32 depth;      // search depth = level
    i32 budget;     // node budget from table
    i32 last_x;
    i32 last_y;
    i32[10] budgets;  // budget table (instance field, avoids module-level let)

    public Level(i32 lv) {
        self.level = lv;
        self.depth = lv;
        self.budgets = {1000, 5000, 10000, 30000, 60000,
                        100000, 150000, 220000, 300000, 500000};
        self.budget = self.budget_for_level(lv);
        self.last_x = -1;
        self.last_y = -1;
    }

    // Get budget for a given level (1-10)
    public i32 budget_for_level(i32 lv) {
        if (lv < 1) { return 1000; }
        if (lv > 10) { return 500000; }
        return self.budgets[lv - 1];
    }

    public i32 last_x() {
        return self.last_x;
    }

    public i32 last_y() {
        return self.last_y;
    }

    // Main entry: dispatch by level
    public Board genmove(Board board, i32 color) {
        Board b2 = board;
        if (self.level == 1) {
            return self.genmove_greedy(b2, color);
        }
        // Level 2-10: alpha-beta search
        i32 best_enc = self.search_root(b2, color, self.depth, self.budget);
        if (best_enc < 0) {
            self.last_x = -1;
            self.last_y = -1;
            return b2;
        }
        i32 mx = best_enc / 13;
        i32 my = best_enc - mx * 13;
        i32 r = b2.place_stone(mx, my, color);
        if (r >= 0) {
            self.last_x = mx;
            self.last_y = my;
        } else {
            self.last_x = -1;
            self.last_y = -1;
        }
        return b2;
    }

    // Level 1: greedy capture + random fallback
    public Board genmove_greedy(Board b2, i32 color) {
        i32 opp = b2.opponent(color);
        i32[169] capture_moves = {0};
        i32 n_cap = 0;
        i32[169] empty_moves = {0};
        i32 n_empty = 0;
        i32[4] dxs = {0, 0, 1, -1};
        i32[4] dys = {1, -1, 0, 0};
        for (i32 x = 0; x < 13; x++) {
            for (i32 y = 0; y < 13; y++) {
                if (b2.get(x, y) == 0) {
                    bool is_ko = b2.is_ko_point(x, y);
                    b2.set(x, y, color);
                    bool captures = false;
                    for (i32 d = 0; d < 4; d++) {
                        i32 nx = x + dxs[d];
                        i32 ny = y + dys[d];
                        if (b2.is_valid(nx, ny)) {
                            if (b2.get(nx, ny) == opp) {
                                if (b2.count_liberties(nx, ny) == 0) {
                                    captures = true;
                                }
                            }
                        }
                    }
                    bool alive = b2.count_liberties(x, y) > 0;
                    b2.set(x, y, 0);
                    if (captures || alive) {
                        i32 enc = x * 13 + y;
                        empty_moves[n_empty] = enc;
                        n_empty = n_empty + 1;
                        if (captures) {
                            if (!is_ko) {
                                capture_moves[n_cap] = enc;
                                n_cap = n_cap + 1;
                            }
                        }
                    }
                }
            }
        }
        i32 mv = -1;
        if (n_cap > 0) {
            mv = capture_moves[b2.rand_below(n_cap)];
        } else if (n_empty > 0) {
            mv = empty_moves[b2.rand_below(n_empty)];
        }
        if (mv < 0) {
            self.last_x = -1;
            self.last_y = -1;
            return b2;
        }
        i32 mx = mv / 13;
        i32 my = mv - mx * 13;
        i32 r = b2.place_stone(mx, my, color);
        if (r >= 0) {
            self.last_x = mx;
            self.last_y = my;
        } else {
            self.last_x = -1;
            self.last_y = -1;
        }
        return b2;
    }

    // Root search: iterative deepening alpha-beta
    // Returns best move encoding (x*13+y), or -1 for pass
    public i32 search_root(Board b2, i32 color, i32 max_depth, i32 budget) {
        i32 opp = b2.opponent(color);
        i32[4] dxs = {0, 0, 1, -1};
        i32[4] dys = {1, -1, 0, 0};
        i32 best_enc = -1;
        // Iterative deepening: 1..max_depth
        for (i32 dd = 1; dd <= max_depth; dd++) {
            best_enc = -1;
            i32 best_val = -999999;
            b2.start_search(budget);
            for (i32 x = 0; x < 13; x++) {
                for (i32 y = 0; y < 13; y++) {
                    if (b2.get(x, y) == 0) {
                        bool is_ko = b2.is_ko_point(x, y);
                        // Snapshot before this candidate
                        i32[13][13] snap = {0};
                        for (i32 i = 0; i < 13; i++) {
                            for (i32 j = 0; j < 13; j++) {
                                snap[i][j] = b2.get(i, j);
                            }
                        }
                        b2.set(x, y, color);
                        i32 cap = 0;
                        for (i32 d = 0; d < 4; d++) {
                            i32 nx = x + dxs[d];
                            i32 ny = y + dys[d];
                            if (b2.is_valid(nx, ny)) {
                                if (b2.get(nx, ny) == opp) {
                                    if (b2.count_liberties(nx, ny) == 0) {
                                        cap = cap + b2.remove_group(nx, ny);
                                    }
                                }
                            }
                        }
                        bool alive = b2.count_liberties(x, y) > 0;
                        i32 val = -999999;
                        if (alive && !(is_ko && cap == 1)) {
                            val = b2.minimax(dd - 1, opp, color, -999999, 999999);
                        }
                        // Restore snapshot
                        for (i32 i = 0; i < 13; i++) {
                            for (i32 j = 0; j < 13; j++) {
                                b2.set(i, j, snap[i][j]);
                            }
                        }
                        if (val > best_val) {
                            best_val = val;
                            best_enc = x * 13 + y;
                        }
                    }
                }
            }
            // Budget check: stop deepening if budget exceeded
            if (b2.search_nodes > b2.search_budget) {
                break;
            }
        }
        return best_enc;
    }
}

// Factory: create a Level instance for the requested level (1-10)
public MoveGenerator create_ai(i32 requested_level) {
    i32 lv = requested_level;
    if (lv < 1) { lv = 1; }
    if (lv > 10) { lv = 10; }
    return new Level(lv);
}
