// Level 10: selective alpha-beta, depth 4 plies after the root, 20-wide.
public class Level10 implements MoveGenerator {
    i32 last_x;
    i32 last_y;

    public Level10() {
        this.last_x = -1;
        this.last_y = -1;
    }

    public i32 last_x() {
        return this.last_x;
    }

    public i32 last_y() {
        return this.last_y;
    }

    public Board genmove(Board board, i32 color) {
        Board b2 = new Board();
        b2.copy_from(board);
        // 2026-11-09: unified compute ladder -- every level runs the same
        // selective search; only time budget / depth / width differ.
        i32 enc = b2.search_root_timed(color, 36, 5, 14, 1800, 20, 0);
        if (enc < 0) {
            // Wood rules forbid passing: fall back to any legal point.
            enc = b2.any_legal_move(color);
        }
        if (enc < 0) {
            this.last_x = -1;
            this.last_y = -1;
            return b2;
        }
        i32 mx = enc / 13;
        i32 my = enc - mx * 13;
        i32 r = b2.place_stone(mx, my, color);
        if (r >= 0) {
            this.last_x = mx;
            this.last_y = my;
        } else {
            this.last_x = -1;
            this.last_y = -1;
        }
        return b2;
    }
}
