// ai.hust - AI strategy layer (shape-interface pattern, r44)
//
// ALGORITHM FAMILY: SCM A.I - Simple Counting Method.
//   Chinese: 简洁数势法. It counts the EFFECTIVENESS OF STONES (势 = 子的
//   效能), not merely their number: a stone is worth more where it has
//   liberties, connections and eye potential, less where it is surrounded
//   and short of air. The method evaluates statically in layers and does
//   not rely on deep search.
//
//   This file is one instance of that family. The LevelN classes are
//   STRENGTH TIERS of the same algorithm (more tiers = deeper lookahead
//   and a richer layer mix), not different algorithms. Other agents on the
//   same board may implement entirely different families; SCM A.I names
//   only this one.
//
//   Layer stack (see ai_env_evaluate.hust):
//     L1 terminal -> L2 quota -> L4 non-linear liberties -> L3 fight zones
//     -> L5 forcing -> L6 ko
//
//   Perspective of every layer: the side being scored.
//
// Declaration: no types (shape). Implementation: types filled in.
// Ownership round-trip: the board moves INTO genmove, the AI places
// its stone, and the board moves BACK to the caller
// (`b = l1.genmove(b, color);` - verified in io_probe v7b).
// Level1 records the move it made; the caller reads last_x/last_y
// to build the GTP response.

use board;
use debug;

// ============================================================================
// 概率控制层 (Probability Control Layer)
// 2026-11-05: 按等级控制战术启用概率，避免低等级 AI 盲目使用高级战术
// ============================================================================

// 弃子概率表：等级 -> 概率 (0-100)
// 低等级搜索深度不够，弃子=胡走；高等级搜索够深，弃子有意义
public i32 get_sacrifice_probability(i32 level) {
    if (level <= 1) {
        return 0;    // LV1: 永不弃子
    } else if (level == 2) {
        return 20;   // LV2: 20% 概率弃子
    } else if (level == 3) {
        return 40;   // LV3: 40% 概率弃子
    } else if (level == 4) {
        return 60;   // LV4: 60% 概率弃子
    } else if (level == 5) {
        return 80;   // LV5: 80% 概率弃子
    } else {
        return 100;  // LV6+: 总是弃子
    }
}

// 救援概率表：等级 -> 概率 (0-100)
// 低等级优先保全，高等级可以权衡弃子
public i32 get_rescue_probability(i32 level) {
    if (level <= 1) {
        return 100;  // LV1: 总是救援
    } else if (level == 2) {
        return 90;   // LV2: 90% 概率救援
    } else if (level == 3) {
        return 80;   // LV3: 80% 概率救援
    } else if (level == 4) {
        return 70;   // LV4: 70% 概率救援
    } else {
        return 60;   // LV5+: 60% 概率救援
    }
}

// 劫争分析概率表：等级 -> 概率 (0-100)
// 低等级避免复杂劫争，高等级可以处理
public i32 get_ko_analysis_probability(i32 level) {
    if (level <= 1) {
        return 0;    // LV1: 不分析劫争
    } else if (level == 2) {
        return 30;   // LV2: 30% 概率分析
    } else if (level == 3) {
        return 50;   // LV3: 50% 概率分析
    } else if (level == 4) {
        return 70;   // LV4: 70% 概率分析
    } else {
        return 100;  // LV5+: 总是分析
    }
}

// 随机数生成器（调用方传入 b.rand_below(100)；不按值接收 Board，
// 因为 hust 0.3.9 对自由函数的对象参数生成 move 语义而不是 clone）
public bool roll_probability(i32 roll, i32 probability) {
    if (probability <= 0) {
        return false;
    }
    if (probability >= 100) {
        return true;
    }
    return roll < probability;
}

// ============================================================================
// 战术方法封装（Tactical Method Encapsulation）
// 2026-11-05: 将散布在 LevelN.genmove 中的硬编码战术逻辑抽取为独立函数，
// 便于统一调阅、单测和后续策略调优。
// ============================================================================

// 弃子判断：基于概率表 + 搜索预算 + 攻击性标志
// 语义：当前回合是否允许主动弃子（不救即将被提的己方子）
public bool should_sacrifice(i32 roll, i32 level, i32 search_budget, bool aggressive) {
    i32 prob = get_sacrifice_probability(level);
    // 攻击模式下提升弃子意愿（如有足够搜索深度能算清后续手段）
    if (aggressive && search_budget > 100000 && prob < 80) {
        prob = 80;
    }
    return roll_probability(roll, prob);
}

// 救援判断：基于概率表 + 搜索预算
// 语义：当前回合是否优先救援被叫吃的己方子
public bool should_rescue(i32 roll, i32 level, i32 search_budget) {
    // 搜索预算过低时放弃救援（救也看不清，不如直接脱先）
    if (search_budget < 50000) {
        return false;
    }
    return roll_probability(roll, get_rescue_probability(level));
}

// 劫威胁分析：基于概率表 + 搜索预算
// 语义：当前回合是否启用劫争分析（识别 ko 点、规避单劫归 imbalances）
public bool analyze_ko_threat(i32 roll, i32 level, i32 search_budget) {
    if (search_budget < 20000) {
        return false;
    }
    return roll_probability(roll, get_ko_analysis_probability(level));
}

interface MoveGenerator {
    public newBoard genmove(board, color);
}

public class Level1 implements MoveGenerator {
    i32 last_x;
    i32 last_y;

    public Level1() {
        this.last_x = -1;
        this.last_y = -1;
    }

    // The move made by the last genmove call (-1 = no legal point; never a pass)
    public i32 last_x() {
        return this.last_x;
    }

    public i32 last_y() {
        return this.last_y;
    }

    public Board genmove(Board board, i32 color) {
        Board b2 = new Board();
        b2.copy_from(board);
        // 2026-11-09: unified compute ladder -- every level runs the same
        // selective search; only time budget / depth / width differ.
        i32 enc = b2.search_root_timed(color, 24, 2, 18, 10, 20, 0);
        if (enc < 0) {
            // Wood rules forbid passing: fall back to any legal point.
            enc = b2.any_legal_move(color);
        }
        if (enc < 0) {
            this.last_x = -1;
            this.last_y = -1;
            return b2;
        }
        i32 mx = enc / 13;
        i32 my = enc - mx * 13;
        i32 r = b2.place_stone(mx, my, color);
        if (r >= 0) {
            this.last_x = mx;
            this.last_y = my;
        } else {
            this.last_x = -1;
            this.last_y = -1;
        }
        return b2;
    }
}

// AIWrapper: unified AI interface (Hust V0.2.1 fix)
// Replaces interface-typed returns (MoveGenerator) which are not supported.
// Creates new AI instance per call (simple, avoids mut this issues).
public class AIWrapper {
    i32 level;
    i32 last_x;
    i32 last_y;
    
    public AIWrapper(i32 lvl) {
        this.level = lvl;
        this.last_x = -1;
        this.last_y = -1;
    }
    
    public Board genmove(Board board, i32 color) {
        if (this.level == 1) {
            Level1 ai = new Level1();
            Board result = ai.genmove(board, color);
            this.last_x = ai.last_x();
            this.last_y = ai.last_y();
            debug_log_i32(1, "AI", "last_x", this.last_x);
            debug_log_i32(1, "AI", "last_y", this.last_y);
            return result;
        } else if (this.level == 2) {
            Level2 ai = new Level2();
            Board result = ai.genmove(board, color);
            this.last_x = ai.last_x();
            this.last_y = ai.last_y();
            debug_log_i32(1, "AI", "last_x", this.last_x);
            debug_log_i32(1, "AI", "last_y", this.last_y);
            return result;
        } else if (this.level == 3) {
            Level3 ai = new Level3();
            Board result = ai.genmove(board, color);
            this.last_x = ai.last_x();
            this.last_y = ai.last_y();
            debug_log_i32(1, "AI", "last_x", this.last_x);
            debug_log_i32(1, "AI", "last_y", this.last_y);
            return result;
        } else if (this.level == 4) {
            Level4 ai = new Level4();
            Board result = ai.genmove(board, color);
            this.last_x = ai.last_x();
            this.last_y = ai.last_y();
            debug_log_i32(1, "AI", "last_x", this.last_x);
            debug_log_i32(1, "AI", "last_y", this.last_y);
            return result;
        } else if (this.level == 5) {
            Level5 ai = new Level5();
            Board result = ai.genmove(board, color);
            this.last_x = ai.last_x();
            this.last_y = ai.last_y();
            debug_log_i32(1, "AI", "last_x", this.last_x);
            debug_log_i32(1, "AI", "last_y", this.last_y);
            return result;
        } else if (this.level == 6) {
            Level6 ai = new Level6();
            Board result = ai.genmove(board, color);
            this.last_x = ai.last_x();
            this.last_y = ai.last_y();
            debug_log_i32(1, "AI", "last_x", this.last_x);
            debug_log_i32(1, "AI", "last_y", this.last_y);
            return result;
        } else if (this.level == 7) {
            Level7 ai = new Level7();
            Board result = ai.genmove(board, color);
            this.last_x = ai.last_x();
            this.last_y = ai.last_y();
            debug_log_i32(1, "AI", "last_x", this.last_x);
            debug_log_i32(1, "AI", "last_y", this.last_y);
            return result;
        } else if (this.level == 8) {
            Level8 ai = new Level8();
            Board result = ai.genmove(board, color);
            this.last_x = ai.last_x();
            this.last_y = ai.last_y();
            debug_log_i32(1, "AI", "last_x", this.last_x);
            debug_log_i32(1, "AI", "last_y", this.last_y);
            return result;
        } else if (this.level == 9) {
            Level9 ai = new Level9();
            Board result = ai.genmove(board, color);
            this.last_x = ai.last_x();
            this.last_y = ai.last_y();
            debug_log_i32(1, "AI", "last_x", this.last_x);
            debug_log_i32(1, "AI", "last_y", this.last_y);
            return result;
        } else {
            Level10 ai = new Level10();
            Board result = ai.genmove(board, color);
            this.last_x = ai.last_x();
            this.last_y = ai.last_y();
            debug_log_i32(1, "AI", "last_x", this.last_x);
            debug_log_i32(1, "AI", "last_y", this.last_y);
            return result;
        }
    }
    
    public i32 last_x() {
        return this.last_x;
    }
    
    public i32 last_y() {
        return this.last_y;
    }
}

// Factory: create AI wrapper for requested level (clamped to 1-10)
public AIWrapper create_ai(i32 requested_level) {
    i32 lvl = requested_level;
    if (lvl < 1) { lvl = 1; }
    if (lvl > 10) { lvl = 10; }
    return new AIWrapper(lvl);
}

// Level 2: like Level1 but prefers the move capturing the MOST stones
// (deterministic; no randomness). Ties broken by first found.
public class Level2 implements MoveGenerator {
    i32 last_x;
    i32 last_y;

    public Level2() {
        this.last_x = -1;
        this.last_y = -1;
    }

    public i32 last_x() {
        return this.last_x;
    }

    public i32 last_y() {
        return this.last_y;
    }

    public Board genmove(Board board, i32 color) {
        Board b2 = new Board();
        b2.copy_from(board);
        // 2026-11-09: unified compute ladder -- every level runs the same
        // selective search; only time budget / depth / width differ.
        i32 enc = b2.search_root_timed(color, 32, 2, 20, 20, 20, 0);
        if (enc < 0) {
            // Wood rules forbid passing: fall back to any legal point.
            enc = b2.any_legal_move(color);
        }
        if (enc < 0) {
            this.last_x = -1;
            this.last_y = -1;
            return b2;
        }
        i32 mx = enc / 13;
        i32 my = enc - mx * 13;
        i32 r = b2.place_stone(mx, my, color);
        if (r >= 0) {
            this.last_x = mx;
            this.last_y = my;
        } else {
            this.last_x = -1;
            this.last_y = -1;
        }
        return b2;
    }
}

// Level 3: heuristic greedy - capture bonus, atari pressure, liberties,
// adjacency, center preference. Single ply, best score wins (ties: first).
public class Level3 implements MoveGenerator {
    i32 last_x;
    i32 last_y;

    public Level3() {
        this.last_x = -1;
        this.last_y = -1;
    }

    public i32 last_x() {
        return this.last_x;
    }

    public i32 last_y() {
        return this.last_y;
    }

    public Board genmove(Board board, i32 color) {
        Board b2 = new Board();
        b2.copy_from(board);
        // 2026-11-09: unified compute ladder -- every level runs the same
        // selective search; only time budget / depth / width differ.
        i32 enc = b2.search_root_timed(color, 24, 3, 14, 50, 20, 0);
        if (enc < 0) {
            // Wood rules forbid passing: fall back to any legal point.
            enc = b2.any_legal_move(color);
        }
        if (enc < 0) {
            this.last_x = -1;
            this.last_y = -1;
            return b2;
        }
        i32 mx = enc / 13;
        i32 my = enc - mx * 13;
        i32 r = b2.place_stone(mx, my, color);
        if (r >= 0) {
            this.last_x = mx;
            this.last_y = my;
        } else {
            this.last_x = -1;
            this.last_y = -1;
        }
        return b2;
    }
}

// Level 4: heuristic greedy + shallow search (depth-1) on top candidates.
// Scores all points with Level3 heuristic, then does depth-1 minimax on
// the top 5 candidates to break ties / avoid blunders.
public class Level4 implements MoveGenerator {
    i32 last_x;
    i32 last_y;

    public Level4() {
        this.last_x = -1;
        this.last_y = -1;
    }

    public i32 last_x() {
        return this.last_x;
    }

    public i32 last_y() {
        return this.last_y;
    }

    public Board genmove(Board board, i32 color) {
        Board b2 = new Board();
        b2.copy_from(board);
        // 2026-11-09: unified compute ladder -- every level runs the same
        // selective search; only time budget / depth / width differ.
        i32 enc = b2.search_root_timed(color, 28, 3, 16, 80, 20, 0);
        if (enc < 0) {
            // Wood rules forbid passing: fall back to any legal point.
            enc = b2.any_legal_move(color);
        }
        if (enc < 0) {
            this.last_x = -1;
            this.last_y = -1;
            return b2;
        }
        i32 mx = enc / 13;
        i32 my = enc - mx * 13;
        i32 r = b2.place_stone(mx, my, color);
        if (r >= 0) {
            this.last_x = mx;
            this.last_y = my;
        } else {
            this.last_x = -1;
            this.last_y = -1;
        }
        return b2;
    }
}

// Level 5: alpha-beta search (root + 2-ply minimax on the Board).
// Root candidates: every legal empty point (virtual check, suicide and
// ko excluded). For each, snapshot -> place + real removal of captured
// groups -> minimax(depth 2) -> restore. Best value wins.
public class Level5 implements MoveGenerator {
    i32 last_x;
    i32 last_y;

    public Level5() {
        this.last_x = -1;
        this.last_y = -1;
    }

    public i32 last_x() {
        return this.last_x;
    }

    public i32 last_y() {
        return this.last_y;
    }

    public Board genmove(Board board, i32 color) {
        Board b2 = new Board();
        b2.copy_from(board);
        // 2026-11-09: unified compute ladder -- every level runs the same
        // selective search; only time budget / depth / width differ.
        i32 enc = b2.search_root_timed(color, 32, 3, 18, 120, 20, 0);
        if (enc < 0) {
            // Wood rules forbid passing: fall back to any legal point.
            enc = b2.any_legal_move(color);
        }
        if (enc < 0) {
            this.last_x = -1;
            this.last_y = -1;
            return b2;
        }
        i32 mx = enc / 13;
        i32 my = enc - mx * 13;
        i32 r = b2.place_stone(mx, my, color);
        if (r >= 0) {
            this.last_x = mx;
            this.last_y = my;
        } else {
            this.last_x = -1;
            this.last_y = -1;
        }
        return b2;
    }
}

