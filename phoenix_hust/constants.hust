// constants.hust - Phoenix Wood Capture Go Engine constants
// Extracted from magic numbers across the codebase (2026-10-10)
// Hust const syntax: const i32 NAME = value;

// Board dimensions
const i32 BOARD_SIZE = 13;
const i32 BOARD_CELLS = 169;  // 13 * 13

// Victory targets (Wood Capture Go rules)
const i32 BLACK_TARGET = 6;
const i32 WHITE_TARGET = 5;

// Search bounds
const i32 INF = 999999;
const i32 NEG_INF = -999999;

// Transposition Table
const i32 TT_SIZE = 256;
const i32 TT_PROBE_SLOTS = 4;
const i32 ZOBRIST_ENTRIES = 338;  // 169 black + 169 white

// AI search budgets
const i32 L5_BUDGET = 300000;
const i32 L7_BUDGET = 300000;
const i32 L10_BUDGET = 1000000;

// AI search depth limits
const i32 L5_DEPTH = 2;
const i32 L7_MIN_DEPTH = 2;
const i32 L7_MAX_DEPTH = 5;
const i32 L10_MIN_DEPTH = 2;
const i32 L10_MAX_DEPTH = 7;

// Direction vectors (4-neighborhood)
// Note: Hust does not support const arrays, use class or regular arrays
