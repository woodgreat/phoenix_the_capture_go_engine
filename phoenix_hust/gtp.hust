// gtp.hust - GTP protocol helpers
// Step 3: coordinate conversion (GTP <-> internal board coords)
// Step 6: final score formatting
// Step 7: string utilities for command parsing
//
// 2026-11-03: Coordinate conversion delegated to coordinate.hust
// This file keeps GTP-specific helpers for backward compatibility.

use coordinate;

// 2026-11-06: Wood coordinates are <column letter A-M><row number 1-13>.
// Columns run left->right, rows are numbered top->bottom (no flip).
// gtp_coord_to_x parses the letter; gtp_coord_to_y parses the number.

// Wood column (0-12) -> GTP column letter (A-M).
public char x_to_gtp_col(i32 x) {
    return wood_x_to_gtp_letter(x);
}

// GTP column letter -> Wood column (0-12); -1 if invalid.
public i32 gtp_col_to_x(char c) {
    return gtp_letter_to_wood_x(c);
}

// Parse the column letter of a coordinate ("G7" -> 6). -1 if invalid.
public i32 gtp_coord_to_x(String coord) {
    if (coord.len() == 0) {
        return -1;
    }
    char c = coord.chars().nth(0).unwrap();
    return gtp_col_to_x(c);
}

// Parse the row number of a coordinate ("G7" -> 6, "M13" -> 12).
// Returns -1 for missing/out-of-range numbers (covers "pass"/"resign").
public i32 gtp_coord_to_y(String coord) {
    i32 num = 0;
    bool has_digit = false;
    for (i32 i = 1; i < coord.len(); i++) {
        char c = coord.chars().nth((usize)i).unwrap();
        if (c >= '0' && c <= '9') {
            has_digit = true;
            i32 d = (i32)c - (i32)'0';
            num = num * 10 + d;
        } else {
            return -1;
        }
    }
    if (!has_digit || num < 1 || num > 13) {
        return -1;
    }
    return num - 1;
}

// Internal coords to GTP: (6,6) -> "G7".
public String xy_to_gtp(i32 x, i32 y) {
    return wood_to_gtp(x, y);
}

// Internal coords to standard SGF: column letter then row letter.
// (7,6) = G8 -> "hg"; (6,7) = H7 -> "gh".
public String xy_to_sgf(i32 x, i32 y) {
    char x_char = i32_to_sgf_char(x);
    char y_char = i32_to_sgf_char(y);
    return format!("{}{}", x_char, y_char);
}

// Convert 0-12 to SGF letter (a-m).
public char i32_to_sgf_char(i32 v) {
    return wood_x_to_sgf(v);
}

// SGF column letter -> internal x.
public i32 sgf_to_x(String sgf) {
    if (sgf.len() < 1) {
        return -1;
    }
    char c = sgf.chars().nth(0).unwrap();
    return sgf_char_to_i32(c);
}

// SGF row letter -> internal y.
public i32 sgf_to_y(String sgf) {
    if (sgf.len() < 2) {
        return -1;
    }
    char c = sgf.chars().nth(1).unwrap();
    return sgf_char_to_i32(c);
}

// Convert SGF letter (a-m) to 0-12.
public i32 sgf_char_to_i32(char c) {
    return sgf_to_wood_x(c);
}

// Parse a non-negative decimal integer; -1 on empty string or any
// non-digit character (GTP command arguments like boardsize 13).
public i32 str_to_i32(String s) {
    i32 num = 0;
    bool has_digit = false;
    for (i32 i = 0; i < s.len(); i++) {
        char c = s.chars().nth((usize)i).unwrap();
        if (c >= '0' && c <= '9') {
            has_digit = true;
            i32 d = (i32)c - (i32)'0';
            num = num * 10 + d;
        } else {
            return -1;
        }
    }
    if (!has_digit) {
        return -1;
    }
    return num;
}

// Format the capture difference as a GTP final_score result.
// B+N when black is ahead, W+N when white is ahead, "0" on a tie.
// (Wood Capture Go has no territory score; the difference is captures.)
public String format_final_score(i32 black_cap, i32 white_cap) {
    i32 diff = black_cap - white_cap;
    if (diff > 0) {
        return format!("B+{}", diff);
    }
    if (diff < 0) {
        return format!("W+{}", -diff);
    }
    return "0".to_string();
}
