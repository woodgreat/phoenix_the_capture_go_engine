// gtp.hust - GTP protocol helpers
// Step 3: coordinate conversion (GTP <-> internal board coords)
// Step 6: final score formatting
// Step 7: string utilities for command parsing
//
// Coordinate system (Wood Capture Go: NO letter skipping):
//   Columns A..M continuous (13 letters, I and O are NOT skipped),
//   rows 1..13. A1 = bottom-left, M13 = top-right.
// Internal coordinates:
//   x = column index 0..12 (A=0, B=1, ..., M=12)
//   y = row index 0..12 (row 1 -> 0, ..., row 13 -> 12)
//
// NOTE (Hust transpiler): nested casts like (char)((i32)'A' + x) are
// buggy (stray parentheses in output); use step-by-step casts
// (i32 -> u8 -> char) instead.

// Column letter to internal x. A..M -> 0..12 (case-insensitive:
// a..m accepted), otherwise -1.
public i32 gtp_col_to_x(char c) {
    char cc = c;
    if (cc >= 'a' && cc <= 'z') {
        i32 code = (i32)cc - 32;
        u8 u = (u8)code;
        cc = (char)u;
    }
    if (cc >= 'A' && cc <= 'M') {
        return (i32)cc - (i32)'A';
    }
    return -1;
}

// Internal x to column letter. 0..12 -> A..M.
// Invalid x returns '?'.
public char x_to_gtp_col(i32 x) {
    if (x < 0 || x > 12) {
        return '?';
    }
    i32 code = (i32)'A' + x;
    u8 u = (u8)code;
    return (char)u;
}

// Parse the column letter of a GTP coordinate string ("D4" -> 3).
// Returns -1 if the string is empty or the first char is not a column.
public i32 gtp_coord_to_x(String coord) {
    if (coord.len() == 0) {
        return -1;
    }
    char c = coord.chars().nth(0).unwrap();
    return gtp_col_to_x(c);
}

// Parse the row number of a GTP coordinate string ("D4" -> 3).
// Scans all digits in the string ("A13" -> 12). Returns -1 for
// missing/out-of-range row numbers (covers "pass" and "resign").
public i32 gtp_coord_to_y(String coord) {
    i32 num = 0;
    bool has_digit = false;
    for (i32 i = 0; i < coord.len(); i++) {
        char c = coord.chars().nth((usize)i).unwrap();
        if (c >= '0' && c <= '9') {
            has_digit = true;
            i32 d = (i32)c - (i32)'0';
            num = num * 10 + d;
        }
    }
    if (!has_digit || num < 1 || num > 13) {
        return -1;
    }
    return num - 1;
}

// Internal coords to GTP coordinate string: (6,6) -> "G7".
public String xy_to_gtp(i32 x, i32 y) {
    char col = x_to_gtp_col(x);
    i32 row = y + 1;
    return format!("{}{}", col, row);
}

// Internal coords to SGF coordinate string: (6,6) -> "gd".
// SGF uses lowercase letters, bottom-left origin, skips 'i'.
public String xy_to_sgf(i32 x, i32 y) {
    // Convert to SGF coordinates: bottom-left origin
    i32 sgf_x = x;
    i32 sgf_y = 12 - y;  // Flip y: top-left (0) -> bottom-left (12)
    
    // Convert to letters, skipping 'i' (SGF standard)
    char x_char = i32_to_sgf_char(sgf_x);
    char y_char = i32_to_sgf_char(sgf_y);
    
    return format!("{}{}", x_char, y_char);
}

// Convert 0-12 to SGF letter (a-s, skipping i).
// 0->a, 1->b, ..., 7->h, 8->j (skip i), 9->k, ..., 12->s
public char i32_to_sgf_char(i32 v) {
    if (v < 0 || v > 12) {
        return 'a';
    }
    if (v < 8) {
        // 0-7: a-h
        u8 u = (u8)v + (u8)97;  // 97 = 'a'
        return u as char;
    } else {
        // 8-12: j-s (skip 'i' at 8)
        u8 u = (u8)v + (u8)98;  // 98 = 'a' + 1, so 8->j
        return u as char;
    }
}

// SGF coordinate string to internal coords: "gd" -> (6,6).
public i32 sgf_to_x(String sgf) {
    if (sgf.len() < 1) {
        return -1;
    }
    char c = sgf.chars().nth(0).unwrap();
    return sgf_char_to_i32(c);
}

public i32 sgf_to_y(String sgf) {
    if (sgf.len() < 2) {
        return -1;
    }
    char c = sgf.chars().nth(1).unwrap();
    i32 sgf_y = sgf_char_to_i32(c);
    // Flip y: bottom-left (12) -> top-left (0)
    return 12 - sgf_y;
}

// Convert SGF letter (a-s, skipping i) to 0-12.
// a->0, b->1, ..., h->7, j->8 (skip i), k->9, ..., s->12
public i32 sgf_char_to_i32(char c) {
    i32 v = (i32)c - (i32)97;  // 97 = 'a'
    if (v < 0 || v > 18) {
        return -1;
    }
    if (v < 8) {
        // a-h: 0-7
        return v;
    } else if (v < 17) {
        // j-r: 8-16 (skip 'i' at 8)
        return v - 1;
    } else if (v == 18) {
        // s: 12
        return 12;
    }
    return -1;
}

// Parse a non-negative decimal integer; -1 on empty string or any
// non-digit character (GTP command arguments like boardsize 13).
public i32 str_to_i32(String s) {
    i32 num = 0;
    bool has_digit = false;
    for (i32 i = 0; i < s.len(); i++) {
        char c = s.chars().nth((usize)i).unwrap();
        if (c >= '0' && c <= '9') {
            has_digit = true;
            i32 d = (i32)c - (i32)'0';
            num = num * 10 + d;
        } else {
            return -1;
        }
    }
    if (!has_digit) {
        return -1;
    }
    return num;
}

// Format the capture difference as a GTP final_score result.
// B+N when black is ahead, W+N when white is ahead, "0" on a tie.
// (Wood Capture Go has no territory score; the difference is captures.)
public String format_final_score(i32 black_cap, i32 white_cap) {
    i32 diff = black_cap - white_cap;
    if (diff > 0) {
        return format!("B+{}", diff);
    }
    if (diff < 0) {
        return format!("W+{}", -diff);
    }
    return "0".to_string();
}
