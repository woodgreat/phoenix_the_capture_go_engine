// ai_env_datatypes.hust - AI Engine Core Data Structures (Minimal)
//
// B方案重构：Group/FightGroup/Jie 数据结构
// 设计日期：2026-10-17
// 2026-10-17 修订：最小可编译版本，逐步扩展

use board;

// ==================== 常量定义 ====================

const i32 BLACK = 1;
const i32 WHITE = 2;
const i32 EMPTY = 0;

// ==================== Group 连通块（最小版本） ====================

// 连通块：同色相邻棋子组成的整体
// 使用固定数组存储，简化实现
public class Group {
    i32 id;                     // 唯一标识（0-based）
    i32 color;                  // BLACK=1, WHITE=2
    i32 size;                   // 棋子数量
    i32 lib_count;              // 气数
    bool alive;                 // 是否存活
    
    // 棋子坐标存储（固定数组，最多 169 个）
    i32[169] stones;
    i32 stone_count;
    
    // 气坐标存储（固定数组，最多 169 个）
    i32[169] libs;
    i32 lib_top;
    
    public Group() {
        self.id = -1;
        self.color = 0;
        self.size = 0;
        self.lib_count = 0;
        self.alive = false;
        self.stone_count = 0;
        self.lib_top = 0;
    }
    
    // 添加棋子
    public void add_stone(i32 enc) {
        if (self.stone_count < 169) {
            self.stones[self.stone_count] = enc;
            self.stone_count = self.stone_count + 1;
            self.size = self.size + 1;
        }
    }
    
    // 添加气（去重）
    public void add_lib(i32 enc) {
        for (i32 i = 0; i < self.lib_top; i++) {
            if (self.libs[i] == enc) {
                return;
            }
        }
        if (self.lib_top < 169) {
            self.libs[self.lib_top] = enc;
            self.lib_top = self.lib_top + 1;
            self.lib_count = self.lib_count + 1;
        }
    }
    
    // 更新存活状态
    public void update_alive() {
        self.alive = self.lib_count > 0;
    }
}

// ==================== 主函数 ====================

public void main() {
    // 空实现，仅用于编译通过
}
