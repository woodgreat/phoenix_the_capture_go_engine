use board;

// ==================== 常量定义 ====================

const i32 BLACK = 1;
const i32 WHITE = 2;
const i32 EMPTY = 0;
const i32 INVALID = -1;

// ==================== Group 连通块（最小版本） ====================

public class Group {
    i32 id;
    i32 color;
    i32 size;
    i32 lib_count;
    bool alive;
    i32[169] stones;
    i32 stone_count;
    i32[169] libs;
    i32 lib_top;
    
    public Group() {
        self.id = INVALID;
        self.color = 0;
        self.size = 0;
        self.lib_count = 0;
        self.alive = false;
        self.stone_count = 0;
        self.lib_top = 0;
    }
    
    public void add_stone(i32 enc) {
        if (self.stone_count < 169) {
            self.stones[self.stone_count] = enc;
            self.stone_count = self.stone_count + 1;
            self.size = self.size + 1;
        }
    }
    
    public void add_lib(i32 enc) {
        for (i32 i = 0; i < self.lib_top; i++) {
            if (self.libs[i] == enc) {
                return;
            }
        }
        if (self.lib_top < 169) {
            self.libs[self.lib_top] = enc;
            self.lib_top = self.lib_top + 1;
            self.lib_count = self.lib_count + 1;
        }
    }
    
    public void update_alive() {
        self.alive = self.lib_count > 0;
    }
}

// ==================== 主函数 ====================

public void main() {
    // 空实现
}
