// ai_env_datatypes.hust - AI Engine Core Data Structures
//
// B方案重构：Group/FightGroup/Jie 数据结构
// 设计日期：2026-10-17
// 2026-10-17 修订：避免使用 bool 数组，改用 i32 表示
// 2026-10-17 Phase 1.3：改为 Group 对象数组 + .replaceit()

// ==================== Group 类 ====================

// Group：棋子组（含棋子列表和气列表）
public class Group {
    i32 id;                 // Group ID
    i32 color;              // 颜色：1=黑, 2=白
    i32 size;               // 棋子数量
    i32 lib_count;          // 气数
    i32 state;              // 状态：0=死, 1=活
    i32[169] stones;        // 棋子位置列表（编码：x*13+y）
    i32 stone_count;        // 棋子数量（实际）
    i32[169] libs;          // 气位置列表
    i32 lib_top;            // 气数量（实际）
    
    public Group() {
        self.id = -1;
        self.color = 0;
        self.size = 0;
        self.lib_count = 0;
        self.state = 0;
        self.stone_count = 0;
        self.lib_top = 0;
    }
    
    // 添加棋子
    public void add_stone(i32 enc) {
        if (self.stone_count < 169) {
            self.stones[self.stone_count] = enc;
            self.stone_count = self.stone_count + 1;
            self.size = self.size + 1;
        }
    }
    
    // 添加气（去重）
    public bool add_lib(i32 enc) {
        // 检查是否已存在
        for (i32 i = 0; i < self.lib_top; i++) {
            if (self.libs[i] == enc) {
                return false;
            }
        }
        // 添加新气
        if (self.lib_top < 169) {
            self.libs[self.lib_top] = enc;
            self.lib_top = self.lib_top + 1;
            self.lib_count = self.lib_count + 1;
            return true;
        }
        return false;
    }
    
    // 更新存活状态（有气即为活）
    public void update_state() {
        if (self.lib_count > 0) {
            self.state = 1;
        } else {
            self.state = 0;
        }
    }
    
    // 清空 Group
    public void clear() {
        self.id = -1;
        self.color = 0;
        self.size = 0;
        self.lib_count = 0;
        self.state = 0;
        self.stone_count = 0;
        self.lib_top = 0;
    }
}

// ==================== GroupManager 管理器 ====================

// Group 管理器：使用 Group 对象动态数组存储（V0.2.5+）
public class GroupManager {
    Group[] groups;             // Group 对象动态数组（Hust V0.2.5+）
    i32 group_count;            // 当前 Group 数量
    i32[169] belong;            // 每个位置属于哪个 Group（-1 = 无）
    
    public GroupManager() {
        self.group_count = 0;
        // groups 是动态数组，默认即为空，无需初始化
        for (i32 i = 0; i < 169; i++) {
            self.belong[i] = -1;
        }
    }
    
    // 从棋盘网格全量构建 Group
    public void build_from_grid(i32[169] grid) {
        self.clear_all();
        
        for (i32 x = 0; x < 13; x++) {
            for (i32 y = 0; y < 13; y++) {
                i32 color = grid[x * 13 + y];
                if (color != 0) {
                    i32 enc = x * 13 + y;
                    if (self.belong[enc] == -1) {
                        self.flood_fill_group(grid, x, y, color);
                    }
                }
            }
        }
        
        self.calculate_all_libs(grid);
    }
    
    // 洪水填充构建单个 Group
    void flood_fill_group(i32[169] grid, i32 sx, i32 sy, i32 color) {
        i32 gid = self.group_count;
        
        // 创建新 Group
        Group new_group = new Group();
        new_group.id = gid;
        new_group.color = color;
        
        // BFS 队列
        i32[169] queue = {0};
        i32 q_head = 0;
        i32 q_tail = 0;
        
        i32 start_enc = sx * 13 + sy;
        queue[q_tail] = start_enc;
        q_tail = q_tail + 1;
        self.belong[start_enc] = gid;
        
        i32[4] dxs = {0, 0, 1, -1};
        i32[4] dys = {1, -1, 0, 0};
        
        while (q_head < q_tail) {
            i32 cur = queue[q_head];
            q_head = q_head + 1;
            
            i32 cx = cur / 13;
            i32 cy = cur - cx * 13;
            
            // 添加棋子到当前 Group
            new_group.add_stone(cur);
            
            for (i32 d = 0; d < 4; d++) {
                i32 nx = cx + dxs[d];
                i32 ny = cy + dys[d];
                
                if (nx >= 0 && nx < 13 && ny >= 0 && ny < 13) {
                    i32 nenc = nx * 13 + ny;
                    i32 ncolor = grid[nenc];
                    
                    if (ncolor == color && self.belong[nenc] == -1) {
                        queue[q_tail] = nenc;
                        q_tail = q_tail + 1;
                        self.belong[nenc] = gid;
                    }
                }
            }
        }
        
        // 使用 push() 添加新 Group 到动态数组
        self.groups.push(new_group);
        self.group_count = self.group_count + 1;
    }
    
    // 计算所有 Group 的气
    void calculate_all_libs(i32[169] grid) {
        i32[4] dxs = {0, 0, 1, -1};
        i32[4] dys = {1, -1, 0, 0};
        
        for (i32 gi = 0; gi < self.group_count; gi++) {
            // 获取当前 Group 的副本
            Group g = self.groups[gi].clone();
            
            for (i32 si = 0; si < g.stone_count; si++) {
                i32 enc = g.stones[si];
                i32 x = enc / 13;
                i32 y = enc - x * 13;
                
                for (i32 d = 0; d < 4; d++) {
                    i32 nx = x + dxs[d];
                    i32 ny = y + dys[d];
                    
                    if (nx >= 0 && nx < 13 && ny >= 0 && ny < 13) {
                        if (grid[nx * 13 + ny] == 0) {
                            i32 lib_enc = nx * 13 + ny;
                            g.add_lib(lib_enc);
                        }
                    }
                }
            }
            
            // 更新存活状态
            g.update_state();
            
            // 使用 .replaceit() 更新 Group（动态数组支持）
            self.groups.replaceit(gi, g);
        }
    }
    
    // 获取位置所属 Group ID（readonly：只读查询）
    public readonly i32 get_group_id_at(i32 enc) {
        return self.belong[enc];
    }
    
    // 获取 Group 颜色（readonly：只读查询）
    public readonly i32 get_group_color(i32 gid) {
        Group g = self.groups[gid].clone();
        return g.color;
    }
    
    // 获取 Group 气数（readonly：只读查询）
    public readonly i32 get_group_lib_count(i32 gid) {
        Group g = self.groups[gid].clone();
        return g.lib_count;
    }
    
    // 检查 Group 是否存活（readonly：只读查询）
    public readonly bool is_group_alive(i32 gid) {
        Group g = self.groups[gid].clone();
        return g.state > 0;
    }
    
    // 获取 Group 大小（棋子数）（readonly：只读查询）
    public readonly i32 get_group_size(i32 gid) {
        Group g = self.groups[gid].clone();
        return g.size;
    }
    
    // 清空
    public void clear_all() {
        self.group_count = 0;
        // 清空动态数组：逐个 pop（动态数组的"动"字诀）
        while (self.groups.len() > 0) {
            self.groups.pop();
        }
        for (i32 i = 0; i < 169; i++) {
            self.belong[i] = -1;
        }
    }
    
    // 获取 Group 数量（readonly：只读查询）
    public readonly i32 count() {
        return self.group_count;
    }
}

// ==================== 结束 ====================
