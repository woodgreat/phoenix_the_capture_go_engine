// ai_env_datatypes.hust - AI Engine Core Data Structures
//
// B方案重构：Group/FightGroup/Jie 数据结构
// 设计日期：2026-10-17
// 2026-10-17 修订：避免使用 bool 数组，改用 i32 表示
// 2026-10-17 Phase 1.3：改为 Group 对象数组 + .replaceit()

// ==================== Group 类 ====================

// Group：棋子组（含棋子列表和气列表）
public class Group {
    i32 id;                 // Group ID
    i32 color;              // 颜色：1=黑, 2=白
    i32 size;               // 棋子数量
    i32 lib_count;          // 气数
    i32 state;              // 状态：0=死, 1=活
    i32[169] stones;        // 棋子位置列表（编码：x*13+y）
    i32 stone_count;        // 棋子数量（实际）
    i32[169] libs;          // 气位置列表
    i32 lib_top;            // 气数量（实际）
    
    public Group() {
        this.id = -1;
        this.color = 0;
        this.size = 0;
        this.lib_count = 0;
        this.state = 0;
        this.stone_count = 0;
        this.lib_top = 0;
    }
    
    // 添加棋子
    public void add_stone(i32 enc) {
        if (this.stone_count < 169) {
            this.stones[this.stone_count] = enc;
            this.stone_count = this.stone_count + 1;
            this.size = this.size + 1;
        }
    }
    
    // 添加气（去重）
    public bool add_lib(i32 enc) {
        // 检查是否已存在
        for (i32 i = 0; i < this.lib_top; i++) {
            if (this.libs[i] == enc) {
                return false;
            }
        }
        // 添加新气
        if (this.lib_top < 169) {
            this.libs[this.lib_top] = enc;
            this.lib_top = this.lib_top + 1;
            this.lib_count = this.lib_count + 1;
            return true;
        }
        return false;
    }
    
    // 更新存活状态（有气即为活）
    public void update_state() {
        if (this.lib_count > 0) {
            this.state = 1;
        } else {
            this.state = 0;
        }
    }
    
    // 清空 Group
    public void clear() {
        this.id = -1;
        this.color = 0;
        this.size = 0;
        this.lib_count = 0;
        this.state = 0;
        this.stone_count = 0;
        this.lib_top = 0;
    }
}

// ==================== GroupManager 管理器 ====================

// Group 管理器：使用 Group 对象动态数组存储（V0.2.5+）
public class GroupManager {
    Group[] groups;             // Group 对象动态数组（Hust V0.2.5+）
    i32 group_count;            // 当前 Group 数量
    i32[169] belong;            // 每个位置属于哪个 Group（-1 = 无）
    
    public GroupManager() {
        this.group_count = 0;
        // groups 是动态数组，默认即为空，无需初始化
        for (i32 i = 0; i < 169; i++) {
            this.belong[i] = -1;
        }
    }
    
    // 从棋盘网格全量构建 Group
    public void build_from_grid(i32[169] grid) {
        this.clear_all();
        
        for (i32 x = 0; x < 13; x++) {
            for (i32 y = 0; y < 13; y++) {
                i32 color = grid[x * 13 + y];
                if (color != 0) {
                    i32 enc = x * 13 + y;
                    if (this.belong[enc] == -1) {
                        this.flood_fill_group(grid, x, y, color);
                    }
                }
            }
        }
        
        this.calculate_all_libs(grid);
    }
    
    // 洪水填充构建单个 Group
    void flood_fill_group(i32[169] grid, i32 sx, i32 sy, i32 color) {
        i32 gid = this.group_count;
        
        // 创建新 Group
        Group new_group = new Group();
        new_group.id = gid;
        new_group.color = color;
        
        // BFS 队列
        i32[169] queue = {0};
        i32 q_head = 0;
        i32 q_tail = 0;
        
        i32 start_enc = sx * 13 + sy;
        queue[q_tail] = start_enc;
        q_tail = q_tail + 1;
        this.belong[start_enc] = gid;
        
        i32[4] dxs = {0, 0, 1, -1};
        i32[4] dys = {1, -1, 0, 0};
        
        while (q_head < q_tail) {
            i32 cur = queue[q_head];
            q_head = q_head + 1;
            
            i32 cx = cur / 13;
            i32 cy = cur - cx * 13;
            
            // 添加棋子到当前 Group
            new_group.add_stone(cur);
            
            for (i32 d = 0; d < 4; d++) {
                i32 nx = cx + dxs[d];
                i32 ny = cy + dys[d];
                
                if (nx >= 0 && nx < 13 && ny >= 0 && ny < 13) {
                    i32 nenc = nx * 13 + ny;
                    i32 ncolor = grid[nenc];
                    
                    if (ncolor == color && this.belong[nenc] == -1) {
                        queue[q_tail] = nenc;
                        q_tail = q_tail + 1;
                        this.belong[nenc] = gid;
                    }
                }
            }
        }
        
        // 使用 push() 添加新 Group 到动态数组
        this.groups.push(new_group);
        this.group_count = this.group_count + 1;
    }
    
    // 计算所有 Group 的气
    void calculate_all_libs(i32[169] grid) {
        i32[4] dxs = {0, 0, 1, -1};
        i32[4] dys = {1, -1, 0, 0};
        
        for (i32 gi = 0; gi < this.group_count; gi++) {
            // 获取当前 Group 的副本
            Group g = this.groups[gi].clone();
            
            for (i32 si = 0; si < g.stone_count; si++) {
                i32 enc = g.stones[si];
                i32 x = enc / 13;
                i32 y = enc - x * 13;
                
                for (i32 d = 0; d < 4; d++) {
                    i32 nx = x + dxs[d];
                    i32 ny = y + dys[d];
                    
                    if (nx >= 0 && nx < 13 && ny >= 0 && ny < 13) {
                        if (grid[nx * 13 + ny] == 0) {
                            i32 lib_enc = nx * 13 + ny;
                            g.add_lib(lib_enc);
                        }
                    }
                }
            }
            
            // 更新存活状态
            g.update_state();
            
            // 使用 .replaceit() 更新 Group（动态数组支持）
            this.groups.replaceit(gi, g);
        }
    }
    
    // 获取位置所属 Group ID（readonly：只读查询）
    public readonly i32 get_group_id_at(i32 enc) {
        return this.belong[enc];
    }
    
    // 获取 Group 颜色（readonly：只读查询）
    public readonly i32 get_group_color(i32 gid) {
        Group g = this.groups[gid].clone();
        return g.color;
    }
    
    // 获取 Group 气数（readonly：只读查询）
    public readonly i32 get_group_lib_count(i32 gid) {
        Group g = this.groups[gid].clone();
        return g.lib_count;
    }
    
    // 检查 Group 是否存活（readonly：只读查询）
    public readonly bool is_group_alive(i32 gid) {
        Group g = this.groups[gid].clone();
        return g.state > 0;
    }
    
    // 获取 Group 大小（棋子数）（readonly：只读查询）
    public readonly i32 get_group_size(i32 gid) {
        Group g = this.groups[gid].clone();
        return g.size;
    }
    
    // 清空
    public void clear_all() {
        this.group_count = 0;
        // 清空动态数组：逐个 pop（动态数组的"动"字诀）
        while (this.groups.len() > 0) {
            this.groups.pop();
        }
        for (i32 i = 0; i < 169; i++) {
            this.belong[i] = -1;
        }
    }
    
    // 获取 Group 数量（readonly：只读查询）
    public readonly i32 count() {
        return this.group_count;
    }
}

// ==================== FightGroup 类 ====================

// FightGroup：战斗组（多个 Group 的集合，用于评估战斗形势）
// 设计目标：
// 1. 跟踪黑白双方的纠缠 Group
// 2. 计算战斗形势（气数、棋子数、眼位等）
// 3. 支持 DFS+αβ剪枝的局部战斗评估
public class FightGroup {
    i32 id;                     // FightGroup ID
    i32 color;                  // 0=双方争夺区, 1=黑主导, 2=白主导
    i32 state;                  // 状态：0=死, 1=活, 2=劫
    Group[] groups;             // 包含的 Group 列表（动态数组）
    i32 group_count;            // Group 数量
    i32 total_size;             // 总棋子数
    i32 total_libs;             // 总气数
    i32 eye_count;              // 眼位数量
    i32[169] stones;            // 所有棋子位置（去重）
    i32 stone_count;            // 棋子数量（实际）
    // Shared liberties of the whole hot zone (2026-10-22): the points both
    // colours can still fill. Together with stones[] this is the zone map.
    i32[169] shared_libs;
    i32 shared_lib_count;
    // Group counts per colour, so the zone colour is derived, not guessed.
    i32 black_groups;
    i32 white_groups;
    // Zone footprint (2026-10-22): every cell inside the hot zone after the
    // boundary stones were grown by one step in all eight directions. This
    // is a superset of stones[]: it also carries empty points and the ring.
    i32[169] zone;
    i32 zone_count;
    
    public FightGroup() {
        this.id = -1;
        this.color = 0;
        this.state = 0;
        this.group_count = 0;
        this.total_size = 0;
        this.total_libs = 0;
        this.eye_count = 0;
        this.stone_count = 0;
        this.shared_lib_count = 0;
        this.black_groups = 0;
        this.white_groups = 0;
        this.zone_count = 0;
    }

    // Mark one cell as part of the hot zone footprint (deduplicated).
    public bool add_zone_cell(i32 enc) {
        for (i32 i = 0; i < this.zone_count; i++) {
            if (this.zone[i] == enc) {
                return false;
            }
        }
        if (this.zone_count < 169) {
            this.zone[this.zone_count] = enc;
            this.zone_count = this.zone_count + 1;
            return true;
        }
        return false;
    }

    // True when the position belongs to the hot zone footprint.
    public bool in_zone(i32 enc) {
        for (i32 i = 0; i < this.zone_count; i++) {
            if (this.zone[i] == enc) {
                return true;
            }
        }
        return false;
    }
    
    // Add a stone position to the zone map (deduplicated). Together with
    // shared_libs[] this is the map of the hot zone.
    public bool add_stone(i32 enc) {
        for (i32 i = 0; i < this.stone_count; i++) {
            if (this.stones[i] == enc) {
                return false;
            }
        }
        if (this.stone_count < 169) {
            this.stones[this.stone_count] = enc;
            this.stone_count = this.stone_count + 1;
            return true;
        }
        return false;
    }

    // Add a shared liberty (deduplicated). These are the points that both
    // colours still have as liberties: the contested spots of the zone.
    public bool add_shared_lib(i32 enc) {
        for (i32 i = 0; i < this.shared_lib_count; i++) {
            if (this.shared_libs[i] == enc) {
                return false;
            }
        }
        if (this.shared_lib_count < 169) {
            this.shared_libs[this.shared_lib_count] = enc;
            this.shared_lib_count = this.shared_lib_count + 1;
            return true;
        }
        return false;
    }
    
    // 添加 Group 到战斗组
    public void add_group(Group g) {
        // 检查是否已存在
        for (i32 i = 0; i < this.group_count; i++) {
            if (this.groups[i].id == g.id) {
                return;
            }
        }
        
        // 保存 Group 属性（避免 move 后使用）
        i32 g_size = g.size;
        i32 g_lib_count = g.lib_count;
        i32 g_color = g.color;
        
        // 添加新 Group
        this.groups.push(g);
        this.group_count = this.group_count + 1;
        this.total_size = this.total_size + g_size;
        this.total_libs = this.total_libs + g_lib_count;
        
        // Colour of the zone is derived from the per-colour group counts:
        // 1 only black, 2 only white, 0 when both are present.
        if (g_color == 1) {
            this.black_groups = this.black_groups + 1;
        } else if (g_color == 2) {
            this.white_groups = this.white_groups + 1;
        }
        if (this.black_groups > 0 && this.white_groups > 0) {
            this.color = 0;
        } else if (this.black_groups > 0) {
            this.color = 1;
        } else if (this.white_groups > 0) {
            this.color = 2;
        } else {
            this.color = 0;
        }
    }
    
    // 计算眼位数量（简化版：检查每个气是否是眼）
    public void calculate_eyes(i32[169] grid) {
        this.eye_count = 0;
        
        // 检查每个气是否是眼
        for (i32 gi = 0; gi < this.group_count; gi++) {
            Group g = this.groups[gi].clone();
            for (i32 li = 0; li < g.lib_top; li++) {
                i32 lib_enc = g.libs[li];
                if (this.is_eye(grid, lib_enc)) {
                    this.eye_count = this.eye_count + 1;
                }
            }
        }
    }
    
    // 检查位置是否是眼（简化版）
    bool is_eye(i32[169] grid, i32 enc) {
        i32 x = enc / 13;
        i32 y = enc - x * 13;
        
        // 检查四个方向是否都是己方棋子
        i32[4] dxs = {0, 0, 1, -1};
        i32[4] dys = {1, -1, 0, 0};
        
        for (i32 d = 0; d < 4; d++) {
            i32 nx = x + dxs[d];
            i32 ny = y + dys[d];
            
            if (nx >= 0 && nx < 13 && ny >= 0 && ny < 13) {
                i32 nenc = nx * 13 + ny;
                if (grid[nenc] != this.color) {
                    return false;
                }
            }
        }
        return true;
    }
    
    // 更新存活状态
    public void update_state() {
        if (this.total_libs > 0) {
            this.state = 1;
        } else {
            this.state = 0;
        }
    }
    
    // 清空 FightGroup
    public void clear() {
        this.id = -1;
        this.color = 0;
        this.state = 0;
        this.group_count = 0;
        this.total_size = 0;
        this.total_libs = 0;
        this.eye_count = 0;
        this.stone_count = 0;
        this.shared_lib_count = 0;
        this.black_groups = 0;
        this.white_groups = 0;
        this.zone_count = 0;
        while (this.groups.len() > 0) {
            this.groups.pop();
        }
    }
}

// ==================== Jie 类 ====================

// Jie：打劫状态
// 设计目标：
// 1. 记录打劫位置和颜色
// 2. 支持打劫规则检查
// 3. 支持劫争解决
public class Jie {
    i32 id;                     // Jie ID
    i32 state;                  // 状态：0=无劫, 1=有劫, 2=劫争解决
    i32 ko_x;                   // 劫位置 x
    i32 ko_y;                   // 劫位置 y
    i32 ko_color;               // 劫颜色：1=黑, 2=白
    i32 capture_count;          // 提子数量
    i32[169] captured_stones;   // 被提棋子位置
    i32 captured_count;         // 被提棋子数量（实际）
    
    public Jie() {
        this.id = -1;
        this.state = 0;
        this.ko_x = -1;
        this.ko_y = -1;
        this.ko_color = 0;
        this.capture_count = 0;
        this.captured_count = 0;
    }
    
    // 设置劫状态
    public void set_ko(i32 x, i32 y, i32 color) {
        this.state = 1;
        this.ko_x = x;
        this.ko_y = y;
        this.ko_color = color;
    }
    
    // 清除劫状态
    public void clear_ko() {
        this.state = 0;
        this.ko_x = -1;
        this.ko_y = -1;
        this.ko_color = 0;
    }
    
    // 检查是否是劫位置
    public readonly bool is_ko_point(i32 x, i32 y) {
        return this.state == 1 && this.ko_x == x && this.ko_y == y;
    }
    
    // 添加被提棋子
    public void add_captured(i32 enc) {
        if (this.captured_count < 169) {
            this.captured_stones[this.captured_count] = enc;
            this.captured_count = this.captured_count + 1;
            this.capture_count = this.capture_count + 1;
        }
    }
    
    // 获取被提棋子数量（readonly）
    public readonly i32 get_capture_count() {
        return this.capture_count;
    }
    
    // 清空 Jie
    public void clear() {
        this.id = -1;
        this.state = 0;
        this.ko_x = -1;
        this.ko_y = -1;
        this.ko_color = 0;
        this.capture_count = 0;
        this.captured_count = 0;
    }
}

// ==================== FightGroupManager 类 ====================

// FightGroupManager：战斗组管理器
// 设计目标：
// 1. 管理多个 FightGroup
// 2. 提供 FightGroup 的创建、查询、更新、删除功能
// 3. 支持战斗形势评估
public class FightGroupManager {
    FightGroup[] fight_groups;      // FightGroup 动态数组
    i32 fight_group_count;          // FightGroup 数量
    
    public FightGroupManager() {
        this.fight_group_count = 0;
    }
    
    // 创建新 FightGroup
    public FightGroup create_fight_group() {
        FightGroup fg = new FightGroup();
        fg.id = this.fight_group_count;
        
        // 保存 id（避免 move 后使用）
        i32 fg_id = fg.id;
        
        this.fight_groups.push(fg);
        this.fight_group_count = this.fight_group_count + 1;
        
        // 返回新创建的 FightGroup（重新获取）
        return this.fight_groups[this.fight_group_count - 1].clone();
    }
    
    // 获取 FightGroup 数量（readonly）
    public readonly i32 count() {
        return this.fight_group_count;
    }
    
    // 获取 FightGroup（readonly）
    public readonly FightGroup get_fight_group(i32 id) {
        return this.fight_groups[id].clone();
    }
    
    // 更新 FightGroup
    public void update_fight_group(i32 id, FightGroup fg) {
        this.fight_groups.replaceit(id, fg);
    }
    
    // 删除 FightGroup
    public void delete_fight_group(i32 id) {
        // 简化实现：标记为无效
        FightGroup fg = this.fight_groups[id].clone();
        fg.id = -1;
        this.fight_groups.replaceit(id, fg);
    }
    
    // 清空所有 FightGroup
    public void clear_all() {
        this.fight_group_count = 0;
        while (this.fight_groups.len() > 0) {
            this.fight_groups.pop();
        }
    }
    
    // 获取有效 FightGroup 数量（readonly）
    public readonly i32 valid_count() {
        i32 count = 0;
        for (i32 i = 0; i < this.fight_group_count; i++) {
            if (this.fight_groups[i].id >= 0) {
                count = count + 1;
            }
        }
        return count;
    }
}

// ==================== JieManager 类 ====================

// JieManager：打劫管理器
// 设计目标：
// 1. 管理多个 Jie
// 2. 提供 Jie 的创建、查询、更新、删除功能
// 3. 支持打劫规则检查
public class JieManager {
    Jie[] jies;                     // Jie 动态数组
    i32 jie_count;                  // Jie 数量
    
    public JieManager() {
        this.jie_count = 0;
    }
    
    // 创建新 Jie
    public Jie create_jie() {
        Jie jie = new Jie();
        jie.id = this.jie_count;
        
        // 保存 id（避免 move 后使用）
        i32 jie_id = jie.id;
        
        this.jies.push(jie);
        this.jie_count = this.jie_count + 1;
        
        // 返回新创建的 Jie（重新获取）
        return this.jies[this.jie_count - 1].clone();
    }
    
    // 获取 Jie 数量（readonly）
    public readonly i32 count() {
        return this.jie_count;
    }
    
    // 获取 Jie（readonly）
    public readonly Jie get_jie(i32 id) {
        return this.jies[id].clone();
    }
    
    // 更新 Jie
    public void update_jie(i32 id, Jie jie) {
        this.jies.replaceit(id, jie);
    }
    
    // 删除 Jie
    public void delete_jie(i32 id) {
        // 简化实现：标记为无效
        Jie jie = this.jies[id].clone();
        jie.id = -1;
        this.jies.replaceit(id, jie);
    }
    
    // 清空所有 Jie
    public void clear_all() {
        this.jie_count = 0;
        while (this.jies.len() > 0) {
            this.jies.pop();
        }
    }
    
    // 获取有效 Jie 数量（readonly）
    public readonly i32 valid_count() {
        i32 count = 0;
        for (i32 i = 0; i < this.jie_count; i++) {
            if (this.jies[i].id >= 0) {
                count = count + 1;
            }
        }
        return count;
    }
    
    // 检查是否有劫（readonly）
    public readonly bool has_ko() {
        for (i32 i = 0; i < this.jie_count; i++) {
            if (this.jies[i].state == 1) {
                return true;
            }
        }
        return false;
    }
    
    // 获取当前劫（readonly）
    public readonly Jie get_current_ko() {
        for (i32 i = 0; i < this.jie_count; i++) {
            if (this.jies[i].state == 1) {
                return this.jies[i].clone();
            }
        }
        return new Jie();
    }
}

// ==================== 结束 ====================
