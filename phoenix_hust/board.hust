// board.hust - 13x13 board representation with twist-cross opening
// Step 2: full board logic (liberties/captures/ko come in Step 4-5)
//
// Internal coordinates:
//   x = column (0=A, 1=B, ..., 12=M; letters A-M continuous, no I/O skip)
//   y = row - 1 (0 = row 1, ..., 12 = row 13)
//
// Stone codes: 0 = empty, 1 = black, 2 = white
//
// NOTE (2026-10-09): transposition table implementation PAUSED - blocked
// by Hust transpiler issues B6~B9 (see hust_issues_for_longerxia.md).
// The TT probe/store code inside minimax is INERT: zobrist_hash() returns
// a value but tt_hash[] etc. do not exist, so no TT path compiles in.
// Resume when any of B6/B7/B8/B9 or out-params is fixed.

// === Constants (P0 optimization 2026-10-10) ===
// Extracted from magic numbers across the codebase.
// Same-file const supports array dimensions (i32[BOARD_SIZE][BOARD_SIZE]).

const i32 BOARD_SIZE = 13;
const i32 BOARD_CELLS = 169;  // 13 * 13
const i32 BLACK_TARGET = 6;
const i32 WHITE_TARGET = 5;
const i32 INF = 999999;
// Note: Hust transpiler has issue with negative const literals,
// so we use -INF instead of a separate NEG_INF constant

public class Board {
    // Hust V0.2.1 fix: use literal 13 instead of const BOARD_SIZE for array dims
    // (const array dims not substituted in generated Rust)
    i32[13][13] grid;

    // Capture counters (victory: black 6, white 5)
    i32 black_captures;
    i32 white_captures;

    // Move counter (placement moves only, opening setup not counted)
    i32 move_count;

    // Pseudo-random seed for AI move selection (LCG)
    i32 rng_seed;

    // Search node budget (Step 12): minimax counts visited nodes and
    // bails out to the static evaluation once the budget is spent.
    i32 search_nodes;
    i32 search_budget;

    // Simple ko: point of the last single-stone capture (-1 = no ko).
    // The side to move may not capture exactly one stone at this point
    // (immediate recapture would repeat the position).
    i32 ko_x;
    i32 ko_y;

    // === Transposition Table (TT) fields (2026-10-10) ===
    // 256-entry TT with linear probing (4 slots), Zobrist hashing.
    // Resumes the PAUSED TT implementation now that Hust B6-B9 are fixed.
    i32[] tt_hash;    // 256 entries
    i32[] tt_score;   // 256 entries
    i32[] tt_depth;   // 256 entries
    i32[] tt_alpha;   // 256 entries
    i32[] tt_beta;    // 256 entries
    i32[] zobrist_table;  // 338 entries (169 black + 169 white)

    // Constructor: scalar fields + twist-cross opening setup.
    // (2026-10-10) A2 fix: ctor now supports full statements, so
    // setup_twist_cross() is called directly instead of requiring the
    // caller to invoke it after `new Board()`.
    public Board() {
        this.black_captures = 0;
        this.white_captures = 0;
        this.move_count = 0;
        this.ko_x = -1;
        this.ko_y = -1;
        this.rng_seed = 88675123;
        this.search_nodes = 0;
        this.search_budget = 300000;
        this.setup_twist_cross();
        // Initialize TT arrays (2026-10-10)
        this.init_search_tables();
    }

    // Initialize transposition table and Zobrist hashing tables.
    // Called once from the constructor.
    public void init_search_tables() {
        // Zobrist table: 338 pseudo-random values (169 black + 169 white)
        i32 seed = 88675123;
        for (i32 i = 0; i < 338; i++) {
            i64 s = (i64)seed * 1103515245 + 12345;
            i64 t = s >> 16;
            i64 t2 = t & 32767;
            seed = (i32)t2;
            i32 v = seed;
            if (v < 0) {
                v = -v;
            }
            this.zobrist_table.push(v);
        }
        // TT arrays: 256 entries each
        for (i32 i = 0; i < 256; i++) {
            this.tt_hash.push(0);
            this.tt_score.push(0);
            this.tt_depth.push(0);
            this.tt_alpha.push(-INF);
            this.tt_beta.push(INF);
        }
    }

    // Reset board to the mandatory twist-cross opening position
    public void clear() {
        this.black_captures = 0;
        this.white_captures = 0;
        this.move_count = 0;
        this.ko_x = -1;
        this.ko_y = -1;
        for (i32 i = 0; i < BOARD_SIZE; i++) {
            for (i32 j = 0; j < BOARD_SIZE; j++) {
                this.grid[i][j] = 0;
            }
        }
        this.setup_twist_cross();
    }

    // Mandatory twist-cross opening (mutual cut, 2x2 block at center):
    //   Black: G7 (6,6) and H8 (7,7)   - main diagonal
    //   White: G8 (6,7) and H7 (7,6)   - anti diagonal
    public void setup_twist_cross() {
        this.grid[6][6] = 1;
        this.grid[6][7] = 2;
        this.grid[7][6] = 2;
        this.grid[7][7] = 1;
    }

    // Coordinate in range check
    public bool is_valid(i32 x, i32 y) {
        return x >= 0 && x < BOARD_SIZE && y >= 0 && y < BOARD_SIZE;
    }

    // Empty point check (out of range counts as not empty)
    public bool is_empty(i32 x, i32 y) {
        if (!this.is_valid(x, y)) {
            return false;
        }
        return this.grid[x][y] == 0;
    }

    // Get stone color at (x, y); -1 if out of range
    public i32 get(i32 x, i32 y) {
        if (!this.is_valid(x, y)) {
            return -1;
        }
        return this.grid[x][y];
    }

    // Set color directly (for rules/AI internals, no counter updates)
    public void set(i32 x, i32 y, i32 val) {
        if (this.is_valid(x, y)) {
            this.grid[x][y] = val;
        }
    }

    // Basic placement: occupied/range check only.
    // Capture detection, suicide and ko rules are added in Step 4-5.
    // Returns true on success.
    public bool place_raw(i32 x, i32 y, i32 color) {
        if (!this.is_valid(x, y)) {
            return false;
        }
        if (!this.is_empty(x, y)) {
            return false;
        }
        this.grid[x][y] = color;
        this.move_count = this.move_count + 1;
        return true;
    }

    // Count liberties of the connected group at (x, y) via BFS flood fill.
    // A liberty is an empty point adjacent to the group (counted once).
    // Returns 0 for empty points.
    // (2026-10-10) B7 fix: use Vec<i32> instead of static arrays
    public i32 count_liberties(i32 x, i32 y) {
        i32 color = this.get(x, y);
        if (color <= 0) {
            return 0;
        }
        i32[BOARD_SIZE][BOARD_SIZE] seen_stone = {0};
        i32[BOARD_SIZE][BOARD_SIZE] seen_lib = {0};
        i32[] stack;
        i32[] liblist;
        stack.push(x * BOARD_SIZE + y);
        seen_stone[x][y] = 1;
        i32[4] dxs = {0, 0, 1, -1};
        i32[4] dys = {1, -1, 0, 0};
        while (stack.len() > (usize)0) {
            i32 code = stack[stack.len() - (usize)1];
            stack.truncate(stack.len() - (usize)1);
            i32 cx = code / BOARD_SIZE;
            i32 cy = code - cx * BOARD_SIZE;
            for (i32 d = 0; d < 4; d++) {
                i32 nx = cx + dxs[d];
                i32 ny = cy + dys[d];
                if (this.is_valid(nx, ny)) {
                    if (this.grid[nx][ny] == 0) {
                        if (seen_lib[nx][ny] == 0) {
                            seen_lib[nx][ny] = 1;
                            liblist.push(nx * BOARD_SIZE + ny);
                        }
                    } else if (this.grid[nx][ny] == color) {
                        if (seen_stone[nx][ny] == 0) {
                            seen_stone[nx][ny] = 1;
                            stack.push(nx * BOARD_SIZE + ny);
                        }
                    }
                }
            }
        }
        return (i32)liblist.len();
    }

    // Remove the whole connected group at (x, y); returns stones removed.
    // Caller must verify the group has no liberties (capture) first.
    // (2026-10-10) B7 fix: use Vec<i32> with head pointer (simplest form)
    public i32 remove_group(i32 x, i32 y) {
        i32 color = this.grid[x][y];
        if (color == 0) {
            return 0;
        }
        i32[] qx;
        i32[] qy;
        this.grid[x][y] = 0;
        qx.push(x);
        qy.push(y);
        i32 head = 0;
        i32 count = 1;
        i32[4] dxs = {0, 0, 1, -1};
        i32[4] dys = {1, -1, 0, 0};
        while (head < (i32)qx.len()) {
            i32 cx = qx[head];
            i32 cy = qy[head];
            head = head + 1;
            for (i32 d = 0; d < 4; d++) {
                i32 nx = cx + dxs[d];
                i32 ny = cy + dys[d];
                if (this.is_valid(nx, ny) && this.grid[nx][ny] == color) {
                    this.grid[nx][ny] = 0;
                    qx.push(nx);
                    qy.push(ny);
                    count = count + 1;
                }
            }
        }
        return count;
    }

    // Place a stone with full rule checking:
    //   returns captured count (>= 0) on success, or
    //   -1 = out of range / occupied
    //   -2 = suicide (no liberties, no capture -> forbidden point)
    //   -3 = ko (immediate single-stone recapture at the ko point)
    // State is saved before the tentative placement and restored on
    // rejection, so failed moves leave the board untouched.
    public i32 place_stone(i32 x, i32 y, i32 color) {
        if (!this.is_valid(x, y)) {
            return -1;
        }
        if (!this.is_empty(x, y)) {
            return -1;
        }

        // Save state for rollback (loop copy; field-level 2D assign is
        // not a verified Hust feature)
        i32[BOARD_SIZE][BOARD_SIZE] saved = {0};
        for (i32 i = 0; i < BOARD_SIZE; i++) {
            for (i32 j = 0; j < BOARD_SIZE; j++) {
                saved[i][j] = this.grid[i][j];
            }
        }
        i32 save_bc = this.black_captures;
        i32 save_wc = this.white_captures;
        i32 save_kx = this.ko_x;
        i32 save_ky = this.ko_y;

        this.grid[x][y] = color;
        i32 captured = 0;
        i32 cap_x = -1;
        i32 cap_y = -1;
        i32[4] dxs = {0, 0, 1, -1};
        i32[4] dys = {1, -1, 0, 0};
        i32 opp = this.opponent(color);
        for (i32 d = 0; d < 4; d++) {
            i32 nx = x + dxs[d];
            i32 ny = y + dys[d];
            if (this.is_valid(nx, ny)) {
                if (this.grid[nx][ny] == opp) {
                    if (this.count_liberties(nx, ny) == 0) {
                        i32 removed = this.remove_group(nx, ny);
                        captured = captured + removed;
                        if (removed == 1) {
                            cap_x = nx;
                            cap_y = ny;
                        }
                    }
                }
            }
        }

        // Suicide: own group has no liberties and nothing was captured
        if (captured == 0) {
            if (this.count_liberties(x, y) == 0) {
                for (i32 i = 0; i < BOARD_SIZE; i++) {
                    for (i32 j = 0; j < BOARD_SIZE; j++) {
                        this.grid[i][j] = saved[i][j];
                    }
                }
                this.black_captures = save_bc;
                this.white_captures = save_wc;
                this.ko_x = save_kx;
                this.ko_y = save_ky;
                return -2;
            }
        }

        // Ko: single-stone recapture exactly at the previous ko point
        if (captured == 1) {
            if (x == this.ko_x && y == this.ko_y) {
                for (i32 i = 0; i < BOARD_SIZE; i++) {
                    for (i32 j = 0; j < BOARD_SIZE; j++) {
                        this.grid[i][j] = saved[i][j];
                    }
                }
                this.black_captures = save_bc;
                this.white_captures = save_wc;
                this.ko_x = save_kx;
                this.ko_y = save_ky;
                return -3;
            }
            this.ko_x = cap_x;
            this.ko_y = cap_y;
        } else {
            this.ko_x = -1;
            this.ko_y = -1;
        }

        if (color == 1) {
            this.black_captures = this.black_captures + captured;
        } else {
            this.white_captures = this.white_captures + captured;
        }
        this.move_count = this.move_count + 1;
        return captured;
    }

    // Captured-stone count for a side (1 = black, 2 = white)
    public i32 get_captures(i32 color) {
        if (color == 1) {
            return this.black_captures;
        }
        if (color == 2) {
            return this.white_captures;
        }
        return 0;
    }

    // Opponent color: 1 -> 2, 2 -> 1
    public i32 opponent(i32 color) {
        if (color == 1) {
            return 2;
        }
        return 1;
    }

    // Print board in showboard style:
    //   header line with column letters A..M (continuous, no I/O skip),
    //   rows 13 down to 1; B = black, W = white, . = empty
    public void print_board() {
        print!("   A B C D E F G H I J K L M\n");
        for (i32 y = 12; y >= 0; y--) {
            i32 row_num = y + 1;
            if (row_num < 10) {
                print!(" ");
            }
            print!("{} ", row_num);
            for (i32 x = 0; x < BOARD_SIZE; x++) {
                if (this.grid[x][y] == 0) {
                    print!(". ");
                } else if (this.grid[x][y] == 1) {
                    print!("B ");
                } else {
                    print!("W ");
                }
            }
            print!("\n");
        }
    }

    // === Setters for undo restore (history lives in the GTP layer) ===

    // Overwrite a capture counter (1 = black, 2 = white)
    public void set_captures(i32 color, i32 n) {
        if (color == 1) {
            this.black_captures = n;
        } else {
            this.white_captures = n;
        }
    }

    // Restore the ko point
    public void set_ko(i32 kx, i32 ky) {
        this.ko_x = kx;
        this.ko_y = ky;
    }

    // Restore the move counter
    public void set_move_count(i32 n) {
        this.move_count = n;
    }

    // Reset the search node counter and set the budget (called by the
    // AI layer before starting a new search)
    public void start_search(i32 budget) {
        this.search_nodes = 0;
        this.search_budget = budget;
    }

    // Ko-point query for the AI layer (ko_x/ko_y stay private)
    public bool is_ko_point(i32 x, i32 y) {
        return x == this.ko_x && y == this.ko_y;
    }

    // Pseudo-random number in [0, n-1] via LCG. i64 intermediate keeps
    // the multiply from overflowing i32.
    public i32 rand_below(i32 n) {
        if (n <= 0) {
            return 0;
        }
        i64 s = (i64)this.rng_seed * 1103515245 + 12345;
        i64 t = s >> 16;
        i64 t2 = t & 32767;
        this.rng_seed = (i32)t2;
        i32 v = this.rng_seed;
        if (v < 0) {
            v = -v;
        }
        return v % n;
    }


    // === Search primitives for the alpha-beta AI (Step 11) ===

    // Zobrist hash (TT support): PAUSED with the TT (Hust B6~B9).
    // Full version archived in test/tt_minimax_reference.hust.

    // === Transposition Table (TT) methods (2026-10-10) ===

    // Zobrist hash: XOR of random values for each stone on the board.
    // Returns a pseudo-random i32 hash of the current position.
    public i32 zobrist_hash() {
        i32 h = 0;
        for (i32 x = 0; x < BOARD_SIZE; x++) {
            for (i32 y = 0; y < BOARD_SIZE; y++) {
                i32 c = this.grid[x][y];
                if (c == 1) {
                    h = h ^ this.zobrist_table[(x * BOARD_SIZE + y) as usize];
                } else if (c == 2) {
                    h = h ^ this.zobrist_table[(BOARD_CELLS + x * BOARD_SIZE + y) as usize];
                }
            }
        }
        return h;
    }

    // TT write helper: prefer same-hash slot, else the shallowest slot in the probe window.
    public void tt_write(i32 hash, i32 depth, i32 score, i32 alpha_in, i32 beta_in) {
        i32 store_idx = 0;
        if (hash < 0) {
            store_idx = (0 - hash) % 256;
        } else {
            store_idx = hash % 256;
        }
        i32 store_slot = store_idx;
        i32 sp = 0;
        while (sp < 4) {
            i32 cur = (store_idx + sp) % 256;
            if (this.tt_hash[cur as usize] == hash) {
                store_slot = cur;
                break;
            }
            if (this.tt_depth[cur as usize] < depth) {
                store_slot = cur;
                break;
            }
            sp = sp + 1;
        }
        this.tt_hash[store_slot as usize] = hash;
        this.tt_score[store_slot as usize] = score;
        this.tt_depth[store_slot as usize] = depth;
        this.tt_alpha[store_slot as usize] = alpha_in;
        this.tt_beta[store_slot as usize] = beta_in;
    }

    // Liberty weight for group value: 1 liberty = dying, 2 = danger, 3+ = safe
    public f32 liberty_weight(i32 libs) {
        if (libs <= 1) {
            return 0.3;
        }
        if (libs == 2) {
            return 0.7;
        }
        if (libs == 3) {
            return 1.0;
        }
        return 1.2;
    }

    // Analyze all groups on board. Returns via out-params (Hust workaround):
    //   my_total_value, opp_total_value: sum of size * liberty_weight
    //   my_atari_count, opp_atari_count: number of groups in atari (1 liberty)
    //   my_atari_max_size, opp_atari_max_size: largest atari group size
    public void analyze_groups(i32 ai_color, i32 my_total_value, i32 opp_total_value,
                               i32 my_atari_count, i32 opp_atari_count,
                               i32 my_atari_max_size, i32 opp_atari_max_size) {
        i32 opp = this.opponent(ai_color);
        i32[13][13] visited = {0};
        i32[4] dxs = {0, 0, 1, -1};
        i32[4] dys = {1, -1, 0, 0};

        my_total_value = 0;
        opp_total_value = 0;
        my_atari_count = 0;
        opp_atari_count = 0;
        my_atari_max_size = 0;
        opp_atari_max_size = 0;

        for (i32 x = 0; x < BOARD_SIZE; x++) {
            for (i32 y = 0; y < BOARD_SIZE; y++) {
                i32 c = this.grid[x][y];
                if (c == 0 || visited[x][y] == 1) {
                    continue;
                }

                // BFS flood fill to find group
                i32[] qx;
                i32[] qy;
                qx.push(x);
                qy.push(y);
                visited[x][y] = 1;
                i32 head = 0;
                i32 size = 0;
                i32 libs = 0;
                i32[13][13] lib_seen = {0};

                while (head < (i32)qx.len()) {
                    i32 cx = qx[head];
                    i32 cy = qy[head];
                    head = head + 1;
                    size = size + 1;

                    for (i32 d = 0; d < 4; d++) {
                        i32 nx = cx + dxs[d];
                        i32 ny = cy + dys[d];
                        if (this.is_valid(nx, ny)) {
                            if (this.grid[nx][ny] == 0) {
                                if (lib_seen[nx][ny] == 0) {
                                    lib_seen[nx][ny] = 1;
                                    libs = libs + 1;
                                }
                            } else if (this.grid[nx][ny] == c && visited[nx][ny] == 0) {
                                visited[nx][ny] = 1;
                                qx.push(nx);
                                qy.push(ny);
                            }
                        }
                    }
                }

                // Calculate group value
                f32 w = this.liberty_weight(libs);
                i32 value = size * (i32)(w * 100.0);

                if (c == ai_color) {
                    my_total_value = my_total_value + value;
                    if (libs == 1) {
                        my_atari_count = my_atari_count + 1;
                        if (size > my_atari_max_size) {
                            my_atari_max_size = size;
                        }
                    }
                } else if (c == opp) {
                    opp_total_value = opp_total_value + value;
                    if (libs == 1) {
                        opp_atari_count = opp_atari_count + 1;
                        if (size > opp_atari_max_size) {
                            opp_atari_max_size = size;
                        }
                    }
                }
            }
        }
    }

    // Static evaluation from ai_color's perspective:
    //   stone diff + liberty diff + capture diff + eye potential + connection
    //   + group value (size-weighted by liberty count)
    //   + tactical adjustment (atari detection and exchange evaluation)
    public i32 evaluate_for(i32 ai_color) {
        debug_log_i32(3, "EVAL", "ai_color", ai_color);
        i32 opp = this.opponent(ai_color);
        i32 my_stones = 0;
        i32 opp_stones = 0;
        i32 my_libs = 0;
        i32 opp_libs = 0;
        for (i32 x = 0; x < BOARD_SIZE; x++) {
            for (i32 y = 0; y < BOARD_SIZE; y++) {
                i32 c = this.grid[x][y];
                if (c == ai_color) {
                    my_stones = my_stones + 1;
                } else if (c == opp) {
                    opp_stones = opp_stones + 1;
                } else {
                    i32 has_my = 0;
                    i32 has_opp = 0;
                    i32[4] dxs = {0, 0, 1, -1};
                    i32[4] dys = {1, -1, 0, 0};
                    for (i32 d = 0; d < 4; d++) {
                        i32 nx = x + dxs[d];
                        i32 ny = y + dys[d];
                        if (this.is_valid(nx, ny)) {
                            if (this.grid[nx][ny] == ai_color) {
                                has_my = 1;
                            }
                            if (this.grid[nx][ny] == opp) {
                                has_opp = 1;
                            }
                        }
                    }
                    my_libs = my_libs + has_my;
                    opp_libs = opp_libs + has_opp;
                }
            }
        }
        i32 cap_diff = 0;
        if (ai_color == 1) {
            cap_diff = this.black_captures - this.white_captures;
        } else {
            cap_diff = this.white_captures - this.black_captures;
        }
        i32 eye = this.count_eye_potential(ai_color) - this.count_eye_potential(opp);
        i32 conn = this.count_connection_strength(ai_color) - this.count_connection_strength(opp);

        // Group analysis for tactical evaluation
        i32 my_gval = 0;
        i32 opp_gval = 0;
        i32 my_atari_cnt = 0;
        i32 opp_atari_cnt = 0;
        i32 my_atari_max = 0;
        i32 opp_atari_max = 0;
        this.analyze_groups(ai_color, my_gval, opp_gval, my_atari_cnt, opp_atari_cnt, my_atari_max, opp_atari_max);

        // Tactical adjustment:
        // - Own group in atari: penalty proportional to size (but not absolute - may trade)
        // - Opponent group in atari: bonus proportional to size (capture opportunity)
        // - Exchange: if both sides have atari, prefer capturing larger group
        i32 tactical = 0;

        // Own atari penalty: size * 50 (large groups hurt more when dying)
        // Reduced if we also have opponent in atari (possible trade)
        if (my_atari_cnt > 0) {
            i32 penalty = my_atari_max * 50;
            if (opp_atari_cnt > 0) {
                // Possible trade: reduce penalty
                penalty = penalty / 2;
            }
            tactical = tactical - penalty;
        }

        // Opponent atari bonus: size * 60 (slightly higher than penalty to encourage attack)
        if (opp_atari_cnt > 0) {
            tactical = tactical + opp_atari_max * 60;
        }

        return (my_stones - opp_stones) * 100 + (my_libs - opp_libs) * 8
             + cap_diff * 100 + eye * 50 + conn * 30
             + (my_gval - opp_gval) / 10 + tactical;
    }

    // Eye potential for color: count points that could become eyes.
    // A potential eye is an empty point surrounded on 3+ sides by own stones.
    // The larger the group, the harder to kill.
    public i32 count_eye_potential(i32 color) {
        i32 score = 0;
        i32[4] dxs = {0, 0, 1, -1};
        i32[4] dys = {1, -1, 0, 0};
        for (i32 x = 0; x < BOARD_SIZE; x++) {
            for (i32 y = 0; y < BOARD_SIZE; y++) {
                if (this.grid[x][y] == 0) {
                    i32 adj = 0;
                    for (i32 d = 0; d < 4; d++) {
                        i32 nx = x + dxs[d];
                        i32 ny = y + dys[d];
                        if (this.is_valid(nx, ny) && this.grid[nx][ny] == color) {
                            adj = adj + 1;
                        }
                    }
                    if (adj >= 3) {
                        score = score + adj;
                    }
                }
            }
        }
        debug_log_i32(3, "EVAL", "score", score);
        return score;
    }

    // Connection strength for color: sum of adjacency between own stones.
    // Each own stone contributes the number of own neighbors it has.
    // Denser connection = harder to isolate and capture.
    public i32 count_connection_strength(i32 color) {
        i32 score = 0;
        i32[4] dxs = {0, 0, 1, -1};
        i32[4] dys = {1, -1, 0, 0};
        for (i32 x = 0; x < BOARD_SIZE; x++) {
            for (i32 y = 0; y < BOARD_SIZE; y++) {
                if (this.grid[x][y] == color) {
                    for (i32 d = 0; d < 4; d++) {
                        i32 nx = x + dxs[d];
                        i32 ny = y + dys[d];
                        if (this.is_valid(nx, ny) && this.grid[nx][ny] == color) {
                            score = score + 1;
                        }
                    }
                }
            }
        }
        return score / 2;  // each edge counted twice (from both ends)
    }

    // Alpha-beta minimax over the current position. Depth 0 returns the
    // static evaluation. Captures inside the search REALLY remove stones
    // (via remove_group); each node restores the grid from a snapshot
    // taken at entry, so the caller sees an unchanged board.
    // NOTE (2026-10-09): TT integration PAUSED (Hust B6~B9); the full
    // TT-enabled version is archived in test/tt_minimax_reference.hust.
    // Params are immutable in Hust: alpha/beta are rebound to locals.
    // Alpha-beta minimax with transposition table (TT) support.
    // Depth 0 returns the static evaluation. Captures inside the search REALLY remove stones
    // (via remove_group); each node restores the grid from a snapshot
    // taken at entry, so the caller sees an unchanged board.
    // (2026-10-10) TT integration: probes and writes TT entries for cutoff.
    public i32 minimax(i32 depth, i32 color_to_move, i32 ai_color, i32 alpha_in, i32 beta_in) {
        i32 alpha = alpha_in;
        i32 beta = beta_in;
        this.search_nodes = this.search_nodes + 1;
        debug_log_i32(2, "MM", "depth", depth);
        debug_log_i32(2, "MM", "color_to_move", color_to_move);
        debug_log_i32(2, "MM", "search_nodes", this.search_nodes);
        if (depth == 0 || this.search_nodes > this.search_budget) {
            if (this.search_nodes > this.search_budget) {
                debug_log(2, "MM", "prune budget");
            } else {
                debug_log(2, "MM", "prune depth");
            }
            return this.evaluate_for(ai_color);
        }

        // TT probe: linear probe 4 slots
        i32 hash = this.zobrist_hash();
        i32 idx = 0;
        if (hash < 0) {
            idx = (0 - hash) % 256;
        } else {
            idx = hash % 256;
        }
        i32 probe = 0;
        while (probe < 4) {
            i32 slot = (idx + probe) % 256;
            if (this.tt_hash[slot as usize] == hash && this.tt_depth[slot as usize] >= depth) {
                i32 tt_val = this.tt_score[slot as usize];
                if (this.tt_alpha[slot as usize] == this.tt_beta[slot as usize]) {
                    return tt_val;                       // exact
                } else if (this.tt_score[slot as usize] <= this.tt_alpha[slot as usize]) {
                    if (tt_val <= alpha) {
                        return tt_val;                   // upper bound cutoff
                    }
                } else {
                    if (tt_val >= beta) {
                        return tt_val;                   // lower bound cutoff
                    }
                }
                break;
            }
            probe = probe + 1;
        }

        // entry snapshot (restored after EVERY candidate)
        i32[BOARD_SIZE][BOARD_SIZE] snap = {0};
        for (i32 i = 0; i < BOARD_SIZE; i++) {
            for (i32 j = 0; j < BOARD_SIZE; j++) {
                snap[i][j] = this.grid[i][j];
            }
        }
        bool maximizing = color_to_move == ai_color;
        i32 best = INF;
        if (maximizing) {
            best = -INF;
        }
        bool any_move = false;
        i32 opp = this.opponent(color_to_move);
        i32[4] dxs = {0, 0, 1, -1};
        i32[4] dys = {1, -1, 0, 0};
        for (i32 x = 0; x < BOARD_SIZE; x++) {
            for (i32 y = 0; y < BOARD_SIZE; y++) {
                if (this.grid[x][y] == 0) {
                    this.grid[x][y] = color_to_move;
                    for (i32 d = 0; d < 4; d++) {
                        i32 nx = x + dxs[d];
                        i32 ny = y + dys[d];
                        if (this.is_valid(nx, ny)) {
                            if (this.grid[nx][ny] == opp) {
                                if (this.count_liberties(nx, ny) == 0) {
                                    this.remove_group(nx, ny);
                                }
                            }
                        }
                    }
                    any_move = true;
                    i32 val = this.minimax(depth - 1, opp, ai_color, alpha, beta);
                    for (i32 i = 0; i < BOARD_SIZE; i++) {
                        for (i32 j = 0; j < BOARD_SIZE; j++) {
                            this.grid[i][j] = snap[i][j];
                        }
                    }
                    if (maximizing) {
                        if (val > best) {
                            best = val;
                        }
                        if (best > alpha) {
                            alpha = best;
                        }
                    } else {
                        if (val < best) {
                            best = val;
                        }
                        if (best < beta) {
                            beta = best;
                        }
                    }
                    if (beta <= alpha) {
                        this.tt_write(hash, depth, best, alpha_in, beta_in);
                        return best;
                    }
                }
            }
        }
        if (!any_move) {
            best = this.evaluate_for(ai_color);
        }
        this.tt_write(hash, depth, best, alpha_in, beta_in);
        return best;
    }
}
